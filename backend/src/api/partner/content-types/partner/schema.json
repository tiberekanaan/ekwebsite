{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "An organization or institution that collaborates on Empower Kiribati projects."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "website_url": {
      "type": "string"
    },
    "role": {
      "type": "enumeration",
      "enum": ["funder", "government", "civil_society", "community"]
    },
    "consent_to_name": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "integer"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "inversedBy": "partners"
    }
  }
}
