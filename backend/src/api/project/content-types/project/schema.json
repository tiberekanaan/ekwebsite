{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "A program or initiative run by Empower Kiribati, optionally backed by one or more partners."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "project_status": {
      "type": "enumeration",
      "enum": ["completed", "on-going"]
    },
    "objectives": {
      "type": "richtext"
    },
    "location": {
      "type": "string"
    },
    "metrics": {
      "type": "richtext"
    },
    "partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner",
      "mappedBy": "projects"
    },
    "pillars": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pillar.pillar",
      "mappedBy": "projects"
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial",
      "mappedBy": "project"
    }
  }
}
