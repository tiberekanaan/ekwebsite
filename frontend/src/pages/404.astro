---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="The page you're looking for has either been moved, deleted, or never existed in the first place."
  noindex
  floatingHeader
>
  <section
    class="relative flex min-h-svh items-center overflow-hidden bg-ek-900 bg-[radial-gradient(1200px_600px_at_75%_-10%,rgba(42,128,137,0.55),transparent_60%),linear-gradient(160deg,var(--color-ek-800)_0%,var(--color-ek-900)_70%)] text-white"
  >
    <svg
      class="pointer-events-none absolute -top-[8%] right-[-6%] z-0 w-[520px] opacity-[0.06]"
      viewBox="0 0 200 200"
      aria-hidden="true"
    >
      <path d="M100 20c-25 0-45 20-45 50s20 60 45 60 45-30 45-60-20-50-45-50z" fill="#aecb3a"></path>
    </svg>

    <div class="relative z-[2] mx-auto w-full max-w-4xl px-7 pt-36 pb-20 text-center">
      <div
        class="error-code select-none font-serif text-[9rem] font-bold leading-none tracking-tight md:text-[13rem] lg:text-[16rem]"
        aria-hidden="true"
        data-reveal
      >
        <span class="error-digit inline-block text-white/10">4</span>
        <span
          class="error-digit inline-block bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text text-transparent"
          style="animation-delay: 0.15s;">0</span
        >
        <span class="error-digit inline-block text-white/10" style="animation-delay: 0.3s;">4</span>
      </div>

      <p
        data-reveal
        data-reveal-delay="80"
        class="mt-6 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright"
      >
        Error 404 · Lost at sea
      </p>
      <h1
        data-reveal
        data-reveal-delay="140"
        class="mt-4 bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text font-serif text-3xl font-bold leading-[1.08] text-transparent sm:text-4xl"
      >
        This page has drifted off course
      </h1>
      <span
        data-reveal
        data-reveal-delay="200"
        class="mx-auto mt-6 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
        aria-hidden="true"></span>
      <p data-reveal data-reveal-delay="260" class="mx-auto mt-6 max-w-[32em] text-lg text-[#cfe0db]">
        The page you're looking for has either been moved, deleted, or never existed in the first
        place.
      </p>

      <div
        data-reveal
        data-reveal-delay="340"
        class="mt-10 flex flex-wrap items-center justify-center gap-4"
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
        >
          Back to home
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-white/35 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-white transition-colors duration-200 hover:border-ek-lime-bright hover:text-ek-lime-bright"
        >
          Get in touch
        </a>
      </div>

      <div
        data-reveal
        data-reveal-delay="420"
        class="mt-12 flex flex-wrap items-center justify-center gap-3"
      >
        {
          [
            { label: 'Our programs', href: '/our-programs' },
            { label: 'Our partners', href: '/our-partners' },
            { label: 'Resources', href: '/resources' },
            { label: 'Blog', href: '/blog' },
            { label: 'Events', href: '/events' },
          ].map((link) => (
            <a
              href={link.href}
              class="rounded-full bg-white/10 px-4 py-1.5 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-[#cfe0db] ring-1 ring-white/20 backdrop-blur transition-colors duration-200 hover:text-ek-lime-bright"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-digit {
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-digit {
      animation: none;
    }
  }
</style>
