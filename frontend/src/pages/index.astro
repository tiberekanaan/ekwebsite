---
import { STRAPI_URL } from 'astro:env/server';
import Layout from '@/layouts/Layout.astro';
import { fetchGlobal } from '@/lib/global';
import type { ContactDetails } from '@/types/global';

// Block components (dynamic-zone driven)
import HeroBlock, { type HeroBlockData } from '@/components/blocks/HeroBlock.astro';
import ChallengeCycleBlock from '@/components/blocks/ChallengeCycleBlock.astro';
import WhatWeDoBlock, { type WhatWeDoBlockData } from '@/components/blocks/WhatWeDoBlock.astro';
import ProgrammesBlock, { type ProgrammesBlockData } from '@/components/blocks/ProgrammesBlock.astro';
import CloseBlock, { type CloseBlockData } from '@/components/blocks/CloseBlock.astro';
import ChallengesBlock, { type ChallengesBlockData } from '@/components/blocks/ChallengesBlock.astro';
import ThreatsBlock, { type ThreatsBlockData } from '@/components/blocks/ThreatsBlock.astro';
import ImpactBlock, { type ImpactBlockData } from '@/components/blocks/ImpactBlock.astro';
import PillarsBlock, { type PillarsBlockData } from '@/components/blocks/PillarsBlock.astro';
import TestimonialsBlock, { type TestimonialsBlockData } from '@/components/blocks/TestimonialsBlock.astro';
import FutureBlock, { type FutureBlockData } from '@/components/blocks/FutureBlock.astro';
import PartnersBlock, { type PartnersBlockData } from '@/components/blocks/PartnersBlock.astro';
import PartnerMarqueeBlock, {
  type PartnerMarqueeBlockData,
} from '@/components/blocks/PartnerMarqueeBlock.astro';

type Block =
  | ({ __component: 'blocks.hero' } & HeroBlockData)
  | ({ __component: 'blocks.what-we-do' } & WhatWeDoBlockData)
  | ({ __component: 'blocks.programmes' } & ProgrammesBlockData)
  | ({ __component: 'blocks.close' } & CloseBlockData)
  | ({ __component: 'blocks.challenges' } & ChallengesBlockData)
  | ({ __component: 'blocks.threats' } & ThreatsBlockData)
  | ({ __component: 'blocks.impact' } & ImpactBlockData)
  | ({ __component: 'blocks.pillars' } & PillarsBlockData)
  | ({ __component: 'blocks.testimonials' } & TestimonialsBlockData)
  | ({ __component: 'blocks.future' } & FutureBlockData)
  | ({ __component: 'blocks.partners' } & PartnersBlockData)
  | ({ __component: 'blocks.partner-marquee' } & PartnerMarqueeBlockData);

// Explicitly populate the dynamic zone, its nested components, relations and media.
const POPULATE = [
  'populate[blocks][on][blocks.hero][populate]=*',
  'populate[blocks][on][blocks.what-we-do][populate][items][populate]=*',
  'populate[blocks][on][blocks.programmes][populate]=*',
  'populate[blocks][on][blocks.close][populate]=*',
  'populate[blocks][on][blocks.challenges][populate]=*',
  'populate[blocks][on][blocks.threats][populate]=*',
  'populate[blocks][on][blocks.impact][populate]=*',
  'populate[blocks][on][blocks.partner-marquee][populate]=*',
  'populate[blocks][on][blocks.pillars][populate][pillars][populate]=*',
  'populate[blocks][on][blocks.testimonials][populate][testimonials][populate]=*',
  'populate[blocks][on][blocks.future][populate]=*',
  'populate[blocks][on][blocks.partners][populate][logos][populate]=*',
  'populate[blocks][on][blocks.partners][populate][categories]=true',
].join('&');

// Contact details for the Work-with-us close come from the Global single
// type (same source as the footer) so one admin edit updates both.
const global = await fetchGlobal();
const contact: ContactDetails = {
  partnershipEmail: global?.partnershipEmail,
  phone: global?.phone,
  officeLine: global?.officeLine,
  utcNote: global?.utcNote,
};

let blocks: Block[] = [];
try {
  // Public read is granted on the homepage endpoint (no token — a scoped
  // API token would 403 on newly-added content types).
  const res = await fetch(`${STRAPI_URL}/api/homepage?${POPULATE}`);
  if (res.ok) {
    const json = (await res.json()) as { data: { blocks?: Block[] } | null };
    blocks = json.data?.blocks ?? [];
  }
} catch {
  // Strapi unreachable — fall back to the default landing below.
}

// The funding-partner marquee renders directly under Featured projects. The
// production CMS zone has no partner-marquee entry, so the block is injected
// here rather than positioned by the admin; a CMS entry, if one is ever
// added, supplies its copy but not its position.
const marqueeIdx = blocks.findIndex((b) => b.__component === 'blocks.partner-marquee');
const marqueeData: PartnerMarqueeBlockData =
  marqueeIdx > -1 ? (blocks.splice(marqueeIdx, 1)[0] as PartnerMarqueeBlockData) : {};

// Featured projects renders above the pull quote regardless of the CMS zone
// order — reordering these two blocks in the admin has no effect here.
const programmesIdx = blocks.findIndex((b) => b.__component === 'blocks.programmes');
const testimonialsIdx = blocks.findIndex((b) => b.__component === 'blocks.testimonials');
if (programmesIdx > -1 && testimonialsIdx > -1 && testimonialsIdx < programmesIdx) {
  [blocks[testimonialsIdx], blocks[programmesIdx]] = [blocks[programmesIdx], blocks[testimonialsIdx]];
}
---

<Layout
  title="Empower Kiribati — Thriving, resilient futures"
  description="Empower Kiribati is a platform for community initiatives. We partner with ministries, funders and community organisations to design, deliver and measure work that cultivates the conditions for a resilient Kiribati."
  floatingHeader
>
  {
    blocks.length > 0 ? (
      blocks.map((block) => {
        switch (block.__component) {
          case 'blocks.hero':
            // The Challenge sits directly under the hero. Its copy is locked
            // by the donor brief, so it renders from the component's own
            // constants — not from the CMS dynamic zone (wiring deferred).
            return (
              <Fragment>
                <HeroBlock block={block} />
                <ChallengeCycleBlock />
              </Fragment>
            );
          case 'blocks.what-we-do':
            return <WhatWeDoBlock block={block} />;
          case 'blocks.programmes':
            return (
              <Fragment>
                <ProgrammesBlock block={block} />
                <PartnerMarqueeBlock block={marqueeData} />
              </Fragment>
            );
          case 'blocks.close':
            return <CloseBlock block={block} contact={contact} />;
          case 'blocks.challenges':
            return <ChallengesBlock block={block} />;
          case 'blocks.threats':
            return <ThreatsBlock block={block} />;
          case 'blocks.impact':
            return <ImpactBlock block={block} />;
          case 'blocks.pillars':
            return <PillarsBlock block={block} />;
          case 'blocks.testimonials':
            return <TestimonialsBlock block={block} />;
          case 'blocks.future':
            return <FutureBlock block={block} />;
          case 'blocks.partners':
            return <PartnersBlock block={block} />;
          default:
            return null;
        }
      })
    ) : (
      <Fragment>
        <HeroBlock block={{}} />
        <ChallengeCycleBlock />
        <WhatWeDoBlock block={{}} />
        <ImpactBlock block={{}} />
        <ProgrammesBlock block={{}} />
        <PartnerMarqueeBlock block={{}} />
        <TestimonialsBlock block={{}} />
        <CloseBlock block={{}} contact={contact} />
      </Fragment>
    )
  }
</Layout>
