  title="Empower Kiribati"
  description="A Kiribati-led NGO building a self-sustaining ecosystem of digital trust and economic opportunity by 2030, built by I-Kiribati, for I-Kiribati."
>
  <Header slot="header" />

  <Hero />
  <OurWork />
  <Impact />
