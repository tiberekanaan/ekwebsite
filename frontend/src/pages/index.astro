---
import { STRAPI_URL } from 'astro:env/server';
import Layout from '@/layouts/Layout.astro';

// Block components (dynamic-zone driven)
import HeroBlock, { type HeroBlockData } from '@/components/blocks/HeroBlock.astro';
import ChallengesBlock, { type ChallengesBlockData } from '@/components/blocks/ChallengesBlock.astro';
import ThreatsBlock, { type ThreatsBlockData } from '@/components/blocks/ThreatsBlock.astro';
import ImpactBlock, { type ImpactBlockData } from '@/components/blocks/ImpactBlock.astro';
import PillarsBlock, { type PillarsBlockData } from '@/components/blocks/PillarsBlock.astro';
import TestimonialsBlock, { type TestimonialsBlockData } from '@/components/blocks/TestimonialsBlock.astro';
import FutureBlock, { type FutureBlockData } from '@/components/blocks/FutureBlock.astro';
import PartnersBlock, { type PartnersBlockData } from '@/components/blocks/PartnersBlock.astro';

type Block =
  | ({ __component: 'blocks.hero' } & HeroBlockData)
  | ({ __component: 'blocks.challenges' } & ChallengesBlockData)
  | ({ __component: 'blocks.threats' } & ThreatsBlockData)
  | ({ __component: 'blocks.impact' } & ImpactBlockData)
  | ({ __component: 'blocks.pillars' } & PillarsBlockData)
  | ({ __component: 'blocks.testimonials' } & TestimonialsBlockData)
  | ({ __component: 'blocks.future' } & FutureBlockData)
  | ({ __component: 'blocks.partners' } & PartnersBlockData);

// Explicitly populate the dynamic zone, its nested components, relations and media.
const POPULATE = [
  'populate[blocks][on][blocks.hero][populate]=*',
  'populate[blocks][on][blocks.challenges][populate]=*',
  'populate[blocks][on][blocks.threats][populate]=*',
  'populate[blocks][on][blocks.impact][populate]=*',
  'populate[blocks][on][blocks.pillars][populate][pillars][populate]=*',
  'populate[blocks][on][blocks.testimonials][populate][testimonials][populate]=*',
  'populate[blocks][on][blocks.future][populate]=*',
  'populate[blocks][on][blocks.partners][populate][logos][populate]=*',
].join('&');

let blocks: Block[] = [];
try {
  // Public read is granted on the homepage endpoint (no token — a scoped
  // API token would 403 on newly-added content types).
  const res = await fetch(`${STRAPI_URL}/api/homepage?${POPULATE}`);
  if (res.ok) {
    const json = (await res.json()) as { data: { blocks?: Block[] } | null };
    blocks = json.data?.blocks ?? [];
  }
} catch {
  // Strapi unreachable — fall back to the default landing below.
}
---

<Layout
  title="Empower Kiribati"
  description="A locally-led NGO helping I-Kiribati gain the leadership, enterprise, and digital skills to cultivate a resilient Kiribati — built by local people, made to last."
  floatingHeader
>
  {
    blocks.length > 0 ? (
      blocks.map((block) => {
        switch (block.__component) {
          case 'blocks.hero':
            return <HeroBlock block={block} />;
          case 'blocks.challenges':
            return <ChallengesBlock block={block} />;
          case 'blocks.threats':
            return <ThreatsBlock block={block} />;
          case 'blocks.impact':
            return <ImpactBlock block={block} />;
          case 'blocks.pillars':
            return <PillarsBlock block={block} />;
          case 'blocks.testimonials':
            return <TestimonialsBlock block={block} />;
          case 'blocks.future':
            return <FutureBlock block={block} />;
          case 'blocks.partners':
            return <PartnersBlock block={block} />;
          default:
            return null;
        }
      })
    ) : (
      <Fragment>
        <HeroBlock block={{}} />
        <ChallengesBlock block={{}} />
        <ThreatsBlock block={{}} />
        <ImpactBlock block={{}} />
        <TestimonialsBlock block={{}} />
        <PartnersBlock block={{}} />
        <FutureBlock block={{}} />
      </Fragment>
    )
  }
</Layout>
