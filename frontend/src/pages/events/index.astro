---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EventCard from '@/components/events/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();
const upcoming = allEvents
  .filter((e) => e.data.date.valueOf() >= now.valueOf())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = allEvents
  .filter((e) => e.data.date.valueOf() < now.valueOf())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Events" description="Upcoming and recent events" floatingHeader>
  <PageHeader
    eyebrow="Events"
    title="Upcoming gatherings"
    description="Workshops, community programs, and on-island events."
  />
  <div class="mx-auto max-w-7xl px-8 py-12">
    {
      upcoming.length === 0 ? (
        <p class="text-foreground-muted py-16 text-center">
          No upcoming events scheduled — check back soon.
        </p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {upcoming.map((event) => (
            <EventCard
              id={event.id}
              date={event.data.date}
              location={event.data.location}
              image={event.data.image}
            />
          ))}
        </div>
      )
    }

    {
      past.length > 0 && (
        <div class="mt-16">
          <h2 class="text-foreground mb-6 text-xl font-semibold">Past events</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {past.map((event) => (
              <EventCard
                id={event.id}
                date={event.data.date}
                location={event.data.location}
                image={event.data.image}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>
