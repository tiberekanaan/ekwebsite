---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';
import { marked } from 'marked';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { date, location, details, image } = event.data;

const formattedDate = date.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const detailsHtml = details ? marked.parse(details) : '';

const imageUrl = image?.url
  ? image.url.startsWith('http')
    ? image.url
    : `${STRAPI_URL}${image.url}`
  : null;
---

<Layout
  title={`Event in ${location}`}
  description={`${location} — ${formattedDate}`}
  floatingHeader
>
  <PageHeader eyebrow="Event" title={location} backHref="/events" backLabel="Back to events">
    <time
      class="mt-6 block text-sm font-semibold uppercase tracking-widest text-[#9fb9b4]"
      data-reveal
      data-reveal-delay="200"
    >
      {formattedDate}
    </time>
  </PageHeader>
  <div class="mx-auto max-w-7xl px-8 py-12">
    <div class="max-w-3xl">
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={image?.alternativeText ?? location}
            class="mb-8 aspect-video w-full rounded-xl object-cover"
          />
        )
      }

      {
        detailsHtml && (
          <article
            class="text-foreground prose prose-neutral dark:prose-invert max-w-none leading-relaxed"
            set:html={detailsHtml}
          />
        )
      }
    </div>
  </div>
</Layout>
