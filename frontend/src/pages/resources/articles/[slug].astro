---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { relatedArticles } from '@/lib/related-articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, related: relatedArticles(article, articles) },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}

const { article, related } = Astro.props;
const {
  title,
  category,
  excerpt,
  meta_description,
  body,
  author,
  reading_time,
  last_reviewed,
  tags,
} = article.data;

const formatReviewed = (value?: string | null) => {
  if (!value) return '';
  const [year, month] = value.split('-').map(Number);
  if (!year || !month) return value;
  return new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
};
const reviewed = formatReviewed(last_reviewed);

const rawHtml = body ? await marked.parse(body) : '';
// `> **Label**` blockquotes become labelled callout panels; tables get a
// scroll wrapper so wide rows never force the page to scroll horizontally.
const bodyHtml = rawHtml
  .replace(
    /<blockquote>\s*<p><strong>([^<]+)<\/strong><\/p>/g,
    '<blockquote class="callout"><p class="callout-label">$1</p>',
  )
  .replace(/<table>/g, '<div class="table-wrap"><table>')
  .replace(/<\/table>/g, '</table></div>')
  // paragraphs that are entirely one <strong> — the lead standfirst and
  // standalone pull-questions (glossary "**Term.** text" paras don't match)
  .replace(/<p><strong>([^<]+)<\/strong><\/p>/g, '<p class="pullout"><strong>$1</strong></p>');

const cardTag = (entry: CollectionEntry<'articles'>) =>
  entry.data.tags.find((tag) => tag.group === 'stage')?.name ??
  entry.data.category ??
  'Guide';
---

<Layout
  title={title}
  description={meta_description ?? excerpt ?? `${title} — Community Resource`}
  floatingHeader
>
  <PageHeader
    eyebrow={category ?? 'Resources'}
    title={title}
    backHref="/resources"
    backLabel="Back to resources"
  >
    <div
      class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold text-[#9fb9b4]"
      data-reveal
      data-reveal-delay="160"
    >
      {author && <span>{author}</span>}
      {reading_time && <span aria-hidden="true">·</span>}
      {reading_time && <span>{reading_time} minute read</span>}
      {reviewed && <span aria-hidden="true">·</span>}
      {reviewed && <span>Last reviewed {reviewed}</span>}
    </div>
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" data-reveal data-reveal-delay="200">
          {tags.map((tag) => (
            <li class="rounded-full bg-white/10 px-3 py-1 font-condensed text-xs font-semibold uppercase tracking-[0.12em] text-ek-lime-bright ring-1 ring-white/15">
              {tag.name}
            </li>
          ))}
        </ul>
      )
    }
  </PageHeader>

  <div class="mx-auto max-w-7xl px-8 py-12">
    <article class="article-body max-w-3xl" set:html={bodyHtml} />

    {
      related.length > 0 && (
        <section class="mt-16 max-w-3xl border-t-2 border-ek-500 pt-8">
          <Eyebrow as="h2" class="mb-6">Related articles</Eyebrow>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map((entry) => (
              <a
                href={`/resources/articles/${entry.data.slug}`}
                class="group block rounded-xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-ek-500 hover:shadow-md"
                data-reveal
              >
                <p class="mb-2 font-condensed text-[0.68rem] font-bold uppercase tracking-[0.12em] text-ek-600">
                  {cardTag(entry)}
                </p>
                <p class="font-serif text-lg font-bold leading-snug text-ek-900 group-hover:text-ek-600">
                  {entry.data.title}
                </p>
                {entry.data.excerpt && (
                  <p class="mt-2 text-sm leading-relaxed text-ek-muted">
                    {entry.data.excerpt}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style is:global>
  .article-body {
    color: var(--color-ek-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .article-body p {
    margin: 0 0 1.15rem;
  }
  .article-body > p:first-child strong {
    display: block;
    font-size: 1.3rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--color-ek-900);
  }
  .article-body h2 {
    margin: 2.75rem 0 0.9rem;
    font-size: 1.55rem;
    line-height: 1.25;
    color: var(--color-ek-800);
  }
  .article-body strong {
    color: var(--color-ek-900);
  }
  .article-body a {
    color: var(--color-ek-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body ul {
    margin: 0 0 1.15rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .article-body li {
    margin-bottom: 0.5rem;
  }
  .article-body .callout {
    margin: 2rem 0;
    border-left: 4px solid var(--color-ek-500);
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--color-ek-mist);
    padding: 1.1rem 1.25rem;
  }
  .article-body .callout p {
    margin: 0 0 0.6rem;
  }
  .article-body .callout p:last-child {
    margin: 0;
  }
  .article-body .callout-label {
    font-family: var(--font-condensed);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ek-600);
  }
  .article-body .table-wrap {
    margin: 1.75rem 0;
    overflow-x: auto;
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .article-body th,
  .article-body td {
    padding: 0.7rem 0.6rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
    text-align: left;
    vertical-align: top;
  }
  .article-body th {
    background: var(--color-ek-paper);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ek-muted);
  }
  /* Standalone bold questions ("One thing to do this week") read as a
     pull-question card; the lead standfirst is excluded via :first-child. */
  .article-body > p.pullout:not(:first-child) {
    margin: 1.5rem 0;
    border: 1px solid color-mix(in oklab, var(--color-ek-700) 14%, transparent);
    border-radius: 0.5rem;
    background: var(--color-ek-paper);
    padding: 1.25rem 1.4rem;
  }
  .article-body > p.pullout:not(:first-child) strong {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--color-ek-600);
  }
  .article-body hr {
    margin: 2.5rem 0 1.5rem;
    border: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
  }
  .article-body hr ~ p {
    font-size: 0.95rem;
    color: var(--color-ek-muted);
  }
</style>
