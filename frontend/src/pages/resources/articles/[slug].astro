---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ArticleToc from '@/components/resources/ArticleToc.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { relatedArticles } from '@/lib/related-articles';
import { buildArticleToc } from '@/lib/article-toc';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, related: relatedArticles(article, articles) },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}

const { article, related } = Astro.props;
const {
  title,
  category,
  excerpt,
  meta_description,
  body,
  author,
  reading_time,
  last_reviewed,
  tags,
} = article.data;

const formatReviewed = (value?: string | null) => {
  if (!value) return '';
  const [year, month] = value.split('-').map(Number);
  if (!year || !month) return value;
  return new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
};
const reviewed = formatReviewed(last_reviewed);

const rawHtml = body ? await marked.parse(body) : '';
// `> **Label**` blockquotes become labelled callout panels; tables get a
// scroll wrapper so wide rows never force the page to scroll horizontally.
const styledHtml = rawHtml
  .replace(
    /<blockquote>\s*<p><strong>([^<]+)<\/strong><\/p>/g,
    '<blockquote class="callout"><p class="callout-label">$1</p>',
  )
  // Tables get a scroll wrapper so wide rows never force the page to scroll
  // horizontally; anything past five columns (a budget table, say) is marked
  // wide so it keeps a readable minimum width and tells the reader to swipe.
  .replace(/<table>([\s\S]*?)<\/table>/g, (_match, inner: string) => {
    const columns = (inner.match(/<th[ >]/g) ?? []).length;
    if (columns <= 5) return `<div class="table-wrap"><table>${inner}</table></div>`;
    return `<p class="table-hint">Scroll sideways to see every column</p><div class="table-wrap" data-wide><table>${inner}</table></div>`;
  })
  // paragraphs that are entirely one <strong> — the lead standfirst and
  // standalone pull-questions (glossary "**Term.** text" paras don't match)
  .replace(/<p><strong>([^<]+)<\/strong><\/p>/g, '<p class="pullout"><strong>$1</strong></p>');

// Long guides get an "On this page" outline: a collapsible panel on small
// screens, a sticky left rail from lg. Short pieces stay a single column.
const { html: bodyHtml, sections: toc } = buildArticleToc(styledHtml);
const headingCount = toc.reduce((total, section) => total + 1 + section.children.length, 0);
const showToc = headingCount >= 4;

const cardTag = (entry: CollectionEntry<'articles'>) =>
  entry.data.tags.find((tag) => tag.group === 'stage')?.name ??
  entry.data.category ??
  'Guide';
---

<Layout
  title={title}
  description={meta_description ?? excerpt ?? `${title} — Community Resource`}
  floatingHeader
>
  <PageHeader
    eyebrow={category ?? 'Resources'}
    title={title}
    backHref="/resources"
    backLabel="Back to resources"
  >
    <div
      class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold text-[#9fb9b4]"
      data-reveal
      data-reveal-delay="160"
    >
      {author && <span>{author}</span>}
      {reading_time && <span aria-hidden="true">·</span>}
      {reading_time && <span>{reading_time} minute read</span>}
      {reviewed && <span aria-hidden="true">·</span>}
      {reviewed && <span>Last reviewed {reviewed}</span>}
    </div>
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" data-reveal data-reveal-delay="200">
          {tags.map((tag) => (
            <li class="rounded-full bg-white/10 px-3 py-1 font-condensed text-xs font-semibold uppercase tracking-[0.12em] text-ek-lime-bright ring-1 ring-white/15">
              {tag.name}
            </li>
          ))}
        </ul>
      )
    }
  </PageHeader>

  <div class="mx-auto max-w-7xl px-8 py-12">
    {
      showToc && (
        <details class="toc-panel mb-8 max-w-3xl rounded-xl border border-ek-700/12 bg-ek-mist/60 lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-condensed text-[0.75rem] font-semibold uppercase tracking-[0.28em] text-ek-olive">
            On this page
            <svg
              class="toc-chevron h-4 w-4 shrink-0 text-ek-600 transition-transform"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 8l5 5 5-5" />
            </svg>
          </summary>
          <div class="px-5 pb-5">
            <ArticleToc sections={toc} />
          </div>
        </details>
      )
    }

    <div class:list={['lg:grid lg:gap-14', showToc && 'lg:grid-cols-[15rem_minmax(0,1fr)]']}>
      {
        showToc && (
          <aside class="hidden lg:block">
            <nav class="sticky top-28" aria-label="On this page" data-reveal>
              <Eyebrow as="p" class="mb-4">On this page</Eyebrow>
              <ArticleToc sections={toc} />
            </nav>
          </aside>
        )
      }

      <div class="min-w-0">
        <article class="article-body max-w-3xl" set:html={bodyHtml} />

        {
          related.length > 0 && (
            <section class="mt-16 max-w-3xl border-t-2 border-ek-500 pt-8">
          <Eyebrow as="h2" class="mb-6">Related articles</Eyebrow>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map((entry) => (
              <a
                href={`/resources/articles/${entry.data.slug}`}
                class="group block rounded-xl border border-slate-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-ek-500 hover:shadow-md"
                data-reveal
              >
                <p class="mb-2 font-condensed text-[0.68rem] font-bold uppercase tracking-[0.12em] text-ek-600">
                  {cardTag(entry)}
                </p>
                <p class="font-serif text-lg font-bold leading-snug text-ek-900 group-hover:text-ek-600">
                  {entry.data.title}
                </p>
                {entry.data.excerpt && (
                  <p class="mt-2 text-sm leading-relaxed text-ek-muted">
                    {entry.data.excerpt}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      )
    }
      </div>
    </div>
  </div>
</Layout>

<script>
  // Highlights the outline link for the section currently under the fixed
  // navbar. Listeners bind once at module scope (ClientRouter keeps the module
  // alive across navigations); the heading/link lists are re-collected on
  // every astro:page-load.
  const OFFSET = 120; // ≥ the headings' scroll-margin-top so a clicked link lights up

  let headings: HTMLElement[] = [];
  let links: HTMLAnchorElement[] = [];
  let queued = false;

  const update = () => {
    queued = false;
    if (!headings.length) return;
    let current: HTMLElement | null = null;
    // Viewport geometry rather than document offsets: it stays correct through
    // late reflows (font swap, a revealed block) that stale offsets miss.
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= OFFSET) current = heading;
      else break;
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) current = headings[headings.length - 1] ?? null;
    const activeHref = current ? `#${current.id}` : '';
    for (const link of links) {
      const active = link.getAttribute('href') === activeHref;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };

  const collect = () => {
    headings = Array.from(
      document.querySelectorAll<HTMLElement>('.article-body h2[id], .article-body h3[id]'),
    );
    links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    update();
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  window.addEventListener('load', schedule);
  document.fonts?.ready.then(schedule);
  document.addEventListener('astro:page-load', collect);
</script>

<style is:global>
  .article-body {
    color: var(--color-ek-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .article-body p {
    margin: 0 0 1.15rem;
  }
  .article-body > p:first-child strong {
    display: block;
    font-size: 1.3rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--color-ek-900);
  }
  .article-body h2 {
    margin: 2.75rem 0 0.9rem;
    font-size: 1.55rem;
    line-height: 1.25;
    color: var(--color-ek-800);
  }
  .article-body h3 {
    margin: 2.1rem 0 0.7rem;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--color-ek-800);
  }
  .article-body h2 + h3 {
    margin-top: 1.4rem;
  }
  /* Clear the fixed navbar when an outline link jumps to a heading. */
  .article-body h2,
  .article-body h3 {
    scroll-margin-top: 7rem;
  }
  .toc-panel summary::-webkit-details-marker {
    display: none;
  }
  .toc-panel[open] .toc-chevron {
    transform: rotate(180deg);
  }
  .article-body strong {
    color: var(--color-ek-900);
  }
  .article-body a {
    color: var(--color-ek-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body ul {
    margin: 0 0 1.15rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .article-body li {
    margin-bottom: 0.5rem;
  }
  .article-body .callout {
    margin: 2rem 0;
    border-left: 4px solid var(--color-ek-500);
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--color-ek-mist);
    padding: 1.1rem 1.25rem;
  }
  .article-body .callout p {
    margin: 0 0 0.6rem;
  }
  .article-body .callout p:last-child {
    margin: 0;
  }
  .article-body .callout-label {
    font-family: var(--font-condensed);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ek-600);
  }
  .article-body .table-wrap {
    margin: 1.75rem 0;
    overflow-x: auto;
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }
  /* Five columns or more: hold a readable width and let the wrapper scroll. */
  .article-body .table-wrap[data-wide] table {
    min-width: 40rem;
  }
  .article-body .table-hint + .table-wrap {
    margin-top: 0;
  }
  .article-body .table-hint {
    margin: 1.75rem 0 0.5rem;
    font-family: var(--font-condensed);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ek-muted);
  }
  @media (min-width: 48rem) {
    .article-body .table-hint {
      display: none;
    }
  }
  .article-body th,
  .article-body td {
    padding: 0.7rem 0.6rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
    text-align: left;
    vertical-align: top;
  }
  /* marked writes GFM column alignment as the legacy align attribute, which
     any stylesheet rule outranks — restore it so money columns line up. */
  .article-body th[align='right'],
  .article-body td[align='right'] {
    text-align: right;
    /* Money and counts stay on one line; only the wordy columns wrap. */
    white-space: nowrap;
  }
  .article-body th[align='center'],
  .article-body td[align='center'] {
    text-align: center;
  }
  .article-body tbody tr:last-child td {
    border-bottom: 0;
  }
  .article-body th {
    background: var(--color-ek-paper);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ek-muted);
  }
  /* Standalone bold questions ("One thing to do this week") read as a
     pull-question card; the lead standfirst is excluded via :first-child. */
  .article-body > p.pullout:not(:first-child) {
    margin: 1.5rem 0;
    border: 1px solid color-mix(in oklab, var(--color-ek-700) 14%, transparent);
    border-radius: 0.5rem;
    background: var(--color-ek-paper);
    padding: 1.25rem 1.4rem;
  }
  .article-body > p.pullout:not(:first-child) strong {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--color-ek-600);
  }
  .article-body hr {
    margin: 2.5rem 0 1.5rem;
    border: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
  }
  .article-body hr ~ p {
    font-size: 0.95rem;
    color: var(--color-ek-muted);
  }
</style>
