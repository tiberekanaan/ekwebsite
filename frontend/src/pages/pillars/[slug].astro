---
import Layout from '@/layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { STRAPI_URL } from 'astro:env/server';

export async function getStaticPaths() {
  const items = await getCollection('pillars');
  return items.map((pillar) => ({
    params: { slug: pillar.data.slug },
    props: { pillar },
  }));
}

interface Props {
  pillar: CollectionEntry<'pillars'>;
}

const { pillar } = Astro.props;
const { title, description } = pillar.data;

const [allProjects, allPartners] = await Promise.all([
  getCollection('projects'),
  getCollection('partners'),
]);

const partnerById = new Map(allPartners.map((p) => [p.id, p.data]));

const linkedProjects = allProjects
  .filter((p) => p.data.pillars.some((ref) => ref.documentId === pillar.id))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const descriptionHtml = description ? marked.parse(description) : '';
const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<Layout
  title={title}
  description={`${title} — Empower Kiribati strategic pillar and the programs it groups.`}
>
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <a
        href="/#our-work"
        class="mb-8 inline-flex items-center gap-1 text-sm font-semibold text-slate-500 transition-colors hover:text-teal-700"
      >
        ← Back to Our Work
      </a>

      <div class="max-w-3xl" data-reveal>
        <p class="mb-3 font-accent text-3xl leading-none text-slate-700">Pillar</p>
        <h1
          class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
        >
          {title}
        </h1>
        {
          descriptionHtml && (
            <article
              class="prose prose-slate prose-lg mt-8 max-w-none prose-headings:font-display prose-a:text-teal-700 hover:prose-a:text-teal-900"
              set:html={descriptionHtml}
            />
          )
        }
      </div>

      <div class="mt-16" data-reveal>
        <p class="mb-3 font-accent text-3xl leading-none text-slate-700">Programs</p>
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Programs under <span class="text-teal-700">this pillar</span>
        </h2>
      </div>

      {
        linkedProjects.length === 0 ? (
          <p class="mt-10 rounded-xl border border-dashed border-slate-200 p-8 text-center text-sm text-slate-500">
            No programs published under this pillar yet.
          </p>
        ) : (
          <ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
            {linkedProjects.map((project) => {
              const { title: projectTitle, description: projectDescription, image, partners } =
                project.data;
              return (
                <li
                  data-reveal
                  class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-slate-900/10"
                >
                  <div class="aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-slate-100 to-teal-50">
                    {image && (
                      <img
                        src={absoluteUrl(image.url)}
                        alt={image.alternativeText ?? projectTitle}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-3 p-6">
                    <h3 class="text-xl font-bold leading-snug text-slate-900">
                      <a
                        href={`/projects/${project.data.slug}`}
                        class="transition-colors hover:text-teal-700 after:absolute after:inset-0 after:content-['']"
                      >
                        {projectTitle}
                      </a>
                    </h3>
                    {projectDescription && (
                      <p class="line-clamp-3 text-sm text-slate-600">{projectDescription}</p>
                    )}
                    {partners.length > 0 && (
                      <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
                        {partners.map((partnerRef) => {
                          const fullPartner = partnerById.get(partnerRef.documentId);
                          return (
                            <a
                              href={`/our-partners/${partnerRef.documentId}`}
                              class="group/donor relative z-10 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-semibold text-slate-700 transition-colors hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800"
                            >
                              {fullPartner?.logo ? (
                                <img
                                  src={absoluteUrl(fullPartner.logo.url)}
                                  alt={fullPartner.logo.alternativeText ?? partnerRef.name}
                                  class="h-5 w-5 rounded-full object-contain"
                                  loading="lazy"
                                />
                              ) : (
                                <span
                                  aria-hidden="true"
                                  class="h-5 w-5 rounded-full bg-gradient-to-br from-teal-400 to-emerald-500"
                                />
                              )}
                              <span>{partnerRef.name}</span>
                            </a>
                          );
                        })}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</Layout>
