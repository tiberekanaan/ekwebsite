---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';
import { programmeHasPartner } from '@/lib/programme-partners';

export async function getStaticPaths() {
  const partners = await getCollection('partners');
  return partners.map((partner) => ({
    params: { id: String(partner.id) },
    props: { partner },
  }));
}

interface Props {
  partner: CollectionEntry<'partners'>;
}

const { partner } = Astro.props;
const { name, logo, website_url } = partner.data;

// Resolved from the programme side so partners attached only through the
// role-carrying partner_links component are covered too.
const allProjects = await getCollection('projects');
const linked = allProjects.filter((p) => programmeHasPartner(p.data, partner.id));

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<Layout title={name} description={`${name} — Empower Kiribati partner`} floatingHeader>
  <PageHeader
    eyebrow="Partner"
    title={name}
    backHref="/our-partners"
    backLabel="Back to partners"
  >
    <div class="mt-7 flex flex-wrap items-center gap-5" data-reveal data-reveal-delay="200">
      <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-xl bg-white ring-1 ring-white/20">
        {
          logo ? (
            <img
              src={absoluteUrl(logo.url)}
              alt={logo.alternativeText ?? `${name} logo`}
              class="max-h-20 max-w-[85%] object-contain"
            />
          ) : (
            <span class="text-center text-xs font-bold uppercase tracking-widest text-slate-400">
              {name}
            </span>
          )
        }
      </div>
      {
        website_url && (
          <a
            href={website_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm font-semibold text-ek-lime-bright transition-colors hover:text-white"
          >
            Visit website
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </PageHeader>
  <div class="mx-auto max-w-7xl px-8 py-12">
    <section class="max-w-3xl">
      <Eyebrow class="mb-4">Projects</Eyebrow>
      <h2 class="mb-6 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-3xl font-bold tracking-tight text-transparent">
        Associated Projects
      </h2>
      {
        linked.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 p-6 text-sm text-slate-500">
            No projects linked to this partner yet.
          </p>
        ) : (
          <ul class="flex flex-col gap-4">
            {linked.map((project) => (
              <li class="relative rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-teal-300">
                <h3 class="text-lg font-bold text-slate-900">
                  <a
                    href={`/our-programs/${project.data.slug}`}
                    class="transition-colors hover:text-teal-700 after:absolute after:inset-0 after:content-['']"
                  >
                    {project.data.title}
                  </a>
                </h3>
                {project.data.description && (
                  <p class="mt-2 line-clamp-3 text-sm text-slate-600">{project.data.description}</p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Layout>
