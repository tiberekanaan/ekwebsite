---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LanguageToggle from '@/components/empower/LanguageToggle.astro';
import { marked } from 'marked';
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';
import { STRAPI_LOCALES, resolveLang, type Lang } from '@/lib/i18n';
import { formatNewsDate, newsHref } from '@/lib/news';

export const prerender = false;

interface StrapiNewsUpdate {
  documentId: string;
  locale: string;
  title: string;
  summary: string | null;
  content: string | null;
  date: string;
  photo: { url: string; alternativeText?: string | null } | null;
  localizations: Array<{ documentId: string; locale: string }> | null;
}

const { slug } = Astro.params;
const lang = resolveLang(Astro.url.searchParams.get('lang'));

// The slug resolves against the build-time collection; the entry's documentId
// then drives the localized runtime fetch below (same split as /our-programs).
const entries = await getCollection('news');
const entry = entries.find((e) => e.data.slug === slug);
if (!entry) {
  // Links from before slugs existed carry the documentId — send them on.
  const legacy = entries.find((e) => e.id === slug);
  if (legacy) return Astro.redirect(newsHref(legacy.data.slug), 301);
  // A 404 response gets the prerendered 404 page; rewriting to '/404' from an
  // on-demand route is forbidden and would 500 instead.
  return new Response(null, { status: 404 });
}

const fetchNewsUpdate = async (locale: string): Promise<StrapiNewsUpdate | null> => {
  try {
    const res = await fetch(
      `${STRAPI_URL}/api/news-updates/${entry.id}?locale=${locale}&populate[photo]=true&populate[localizations]=true`,
    );
    if (!res.ok) return null;
    const { data } = (await res.json()) as { data: StrapiNewsUpdate };
    return data;
  } catch {
    return null;
  }
};

let item = await fetchNewsUpdate(STRAPI_LOCALES[lang]);
// fall back to English when the requested translation doesn't exist
if (!item && lang !== 'en') item = await fetchNewsUpdate(STRAPI_LOCALES.en);
if (!item) return new Response(null, { status: 404 });

const { title, summary, content, photo } = item;
const hasTranslation = (item.localizations ?? []).length > 0;
const currentLang: Lang = item.locale === STRAPI_LOCALES.kir ? 'kir' : 'en';

const formattedDate = formatNewsDate(new Date(item.date));

const contentHtml = content ? marked.parse(content) : '';

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<Layout
  title={title}
  description={summary ?? `${title} — News update from Empower Kiribati`}
  floatingHeader
>
  <PageHeader
    eyebrow="News"
    title={title}
    description={summary ?? undefined}
    backHref="/news"
    backLabel="Back to news"
  >
    <div class="mt-6 flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="200">
      <time
        datetime={item.date}
        class="text-sm font-semibold uppercase tracking-widest text-[#9fb9b4]"
      >
        {formattedDate}
      </time>
      {hasTranslation && <LanguageToggle current={currentLang} path={Astro.url.pathname} />}
    </div>
  </PageHeader>
  <div class="mx-auto max-w-7xl px-8 py-12">
    <div class="max-w-3xl">
      {
        photo && (
          <figure
            class="mb-10 overflow-hidden rounded-2xl shadow-xl shadow-slate-900/10"
            data-reveal
          >
            <img
              src={absoluteUrl(photo.url)}
              alt={photo.alternativeText ?? title}
              class="aspect-[16/9] w-full object-cover"
              loading="eager"
            />
          </figure>
        )
      }

      {
        contentHtml && (
          <article
            class="prose prose-slate prose-lg max-w-none prose-headings:font-display prose-a:text-teal-700 hover:prose-a:text-teal-900"
            set:html={contentHtml}
            data-reveal
          />
        )
      }
    </div>
  </div>
</Layout>
