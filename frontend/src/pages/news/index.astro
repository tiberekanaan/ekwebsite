---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import NewsCard from '@/components/news/NewsCard.astro';
import { getCollection } from 'astro:content';
import { byNewest, newsHref } from '@/lib/news';

const items = (await getCollection('news')).sort(byNewest);
---

<Layout
  title="News"
  description="Grants awarded, sessions delivered and partnerships agreed — news from Empower Kiribati as it happens."
  floatingHeader
>
  <PageHeader
    eyebrow="News"
    title="News and updates"
    description="What has happened lately: grants awarded, sessions delivered and partnerships agreed."
  />
  <div class="mx-auto max-w-7xl px-8 py-12">
    {
      items.length === 0 ? (
        <p class="py-16 text-center text-ek-muted">No news yet.</p>
      ) : (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item, i) => (
            <NewsCard
              href={newsHref(item.data.slug)}
              title={item.data.title}
              date={item.data.date}
              summary={item.data.summary}
              photo={item.data.photo}
              revealDelay={(i % 3) * 100}
              headingLevel="h2"
            />
          ))}
        </div>
      )
    }
  </div>
</Layout>
