---
import Layout from '@/layouts/Layout.astro';
import { marked } from 'marked';
import { STRAPI_URL } from 'astro:env/server';

type BasicPage = {
  documentId: string;
  title: string;
  content: string | null;
};

const res = await fetch(`${STRAPI_URL}/api/basic-page`);
let page: BasicPage | null = null;

if (res.ok) {
  const { data } = (await res.json()) as { data: BasicPage | null };
  page = data;
} else if (res.status !== 403 && res.status !== 404) {
  throw new Error(`Strapi /api/basic-page → ${res.status} ${res.statusText}`);
} else {
  console.warn(
    `Strapi /api/basic-page returned ${res.status} — falling back to placeholder. Check the singleType is published and Public has 'find' permission.`,
  );
}

const title = page?.title ?? 'About';
const md = page?.content ?? '';

// Split richtext by `## ` H2 headings so each section gets its own visual treatment.
const parts = md.split(/^##\s+(.+)$/m);
const originMd = (parts[0] ?? '').trim();
const sectionsByHeading = new Map<string, string>();
for (let i = 1; i < parts.length; i += 2) {
  sectionsByHeading.set(parts[i].trim().toLowerCase(), (parts[i + 1] ?? '').trim());
}
const findSection = (needle: string) => {
  for (const [heading, body] of sectionsByHeading) {
    if (heading.includes(needle)) return body;
  }
  return '';
};

const missionMd = findSection('mission');
const visionMd = findSection('vision');
const differentMd = findSection('different');

// In the "different" section, peel the lead paragraphs off the bullet list.
const diffLines = differentMd.split('\n');
const firstBulletIdx = diffLines.findIndex((l) => /^\s*-\s/.test(l));
const diffNarrativeMd =
  firstBulletIdx === -1 ? differentMd : diffLines.slice(0, firstBulletIdx).join('\n').trim();
const diffBulletLines = firstBulletIdx === -1 ? [] : diffLines.slice(firstBulletIdx);

const principles = diffBulletLines
  .filter((l) => /^\s*-\s/.test(l))
  .map((line) => {
    const stripped = line.replace(/^\s*-\s+/, '');
    const match = stripped.match(/^\*\*([^*]+?)\s*:?\s*\*\*\s*:?\s*(.*)$/);
    if (match) return { head: match[1].trim(), body: match[2].trim() };
    const idx = stripped.indexOf(':');
    return {
      head: (idx > -1 ? stripped.slice(0, idx) : stripped).replace(/\*\*/g, '').trim(),
      body: (idx > -1 ? stripped.slice(idx + 1) : '').replace(/\*\*/g, '').trim(),
    };
  });

const originHtml = originMd ? marked.parse(originMd) : '';
const missionHtml = missionMd ? marked.parse(missionMd) : '';
const visionHtml = visionMd ? marked.parse(visionMd) : '';
const diffNarrativeHtml = diffNarrativeMd ? marked.parse(diffNarrativeMd) : '';

type IconKey = 'globe' | 'ear' | 'beaker' | 'users' | 'eye' | 'shield' | 'heart' | 'spark';

const ICONS: Record<IconKey, string> = {
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  ear: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3.5 3.5 0 1 1-7 0"/><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 1 0 4"/></svg>`,
  beaker: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M10 2v7.3"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6 6 0 0 1 3 5.2v.5a3 3 0 0 1-3 3H10a3 3 0 0 1-3-3v-.5a6 6 0 0 1 3-5.2"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  eye: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  spark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>`,
};

const iconFor = (head: string): IconKey => {
  const k = head.toLowerCase();
  if (k.includes('locally') || k.includes('local')) return 'globe';
  if (k.includes('listen') || k.includes('co-design') || k.includes('co‑design')) return 'ear';
  if (k.includes('practical') || k.includes('evidence')) return 'beaker';
  if (k.includes('inclusive')) return 'users';
  if (k.includes('accountable') || k.includes('transparent')) return 'eye';
  if (k.includes('endure') || k.includes('built')) return 'shield';
  if (k.includes('safety') || k.includes('safeguard')) return 'heart';
  return 'spark';
};

// Big section icons (32px) — reuse the small ones but render at a larger size via wrapper class.
const targetIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`;
const compassIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`;
const arrowRight = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<Layout title={title} description={`${title} — Empower Kiribati`}>
  {/* Hero */}
  <section
    class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-900 to-teal-900 text-white"
  >
    <div class="absolute inset-0 opacity-[0.08]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="about-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40V0h40" fill="none" stroke="currentColor" stroke-width="1"></path>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#about-grid)"></rect>
      </svg>
    </div>
    <div
      class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-lime-400/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-40 -left-32 h-96 w-96 rounded-full bg-teal-400/20 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-6 py-24 text-center lg:py-32" data-reveal>
      <p class="mb-4 font-accent text-4xl leading-none text-lime-300">About</p>
      <h1
        class="font-display text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-slate-200">
        Opportunity. Resilience. Dignity. <span class="text-lime-300">Shaped by I-Kiribati communities.</span>
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm font-medium text-slate-300">
        <span class="rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20 backdrop-blur"
          >Locally led</span
        >
        <span class="rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20 backdrop-blur"
          >Climate-aware</span
        >
        <span class="rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20 backdrop-blur"
          >Partnership-driven</span
        >
      </div>
    </div>
  </section>

  {/* Origin narrative — magazine column with drop cap */}
  {
    originHtml && (
      <section class="bg-white">
        <div class="mx-auto max-w-3xl px-6 py-20 lg:py-24" data-reveal>
          <p class="mb-3 font-accent text-2xl leading-none text-teal-700">Our story</p>
          <h2 class="mb-10 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            From <span class="text-teal-700">Digital Kiribati</span> to{' '}
            <span class="text-lime-600">Empower Kiribati</span>.
          </h2>
          <article
            class="about-origin prose prose-slate prose-lg max-w-none prose-headings:font-display prose-strong:text-slate-900 prose-a:text-teal-700 hover:prose-a:text-teal-900"
            set:html={originHtml}
          />
        </div>
      </section>
    )
  }

  {/* Mission + Vision — two-up card row */}
  {
    (missionHtml || visionHtml) && (
      <section class="bg-slate-50">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="grid gap-8 md:grid-cols-2">
            {missionHtml && (
              <div
                class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-teal-700 to-teal-900 p-10 text-white shadow-xl shadow-teal-900/20 transition-transform duration-500 hover:-translate-y-1"
                data-reveal
              >
                <div
                  class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-lime-300/20 blur-2xl transition-opacity duration-500 group-hover:opacity-80"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div
                    class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-lime-300 ring-1 ring-white/20"
                    set:html={targetIcon}
                  />
                  <p class="mt-6 font-accent text-2xl leading-none text-lime-300">Our mission</p>
                  <h3 class="mt-1 font-display text-3xl font-bold leading-tight">
                    What we set out to do.
                  </h3>
                  <div
                    class="prose prose-invert mt-5 max-w-none text-lg leading-relaxed text-slate-100 prose-p:m-0"
                    set:html={missionHtml}
                  />
                </div>
              </div>
            )}
            {visionHtml && (
              <div
                class="group relative overflow-hidden rounded-3xl border border-lime-200 bg-gradient-to-br from-lime-50 to-white p-10 shadow-xl shadow-slate-900/5 transition-transform duration-500 hover:-translate-y-1"
                data-reveal
              >
                <div
                  class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-teal-300/20 blur-2xl transition-opacity duration-500 group-hover:opacity-80"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div
                    class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-teal-700/10 text-teal-800 ring-1 ring-teal-700/20"
                    set:html={compassIcon}
                  />
                  <p class="mt-6 font-accent text-2xl leading-none text-teal-700">Our vision</p>
                  <h3 class="mt-1 font-display text-3xl font-bold leading-tight text-slate-900">
                    Where we're heading.
                  </h3>
                  <div
                    class="prose prose-slate mt-5 max-w-none text-lg leading-relaxed prose-p:m-0"
                    set:html={visionHtml}
                  />
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* How we're different — lead narrative + icon grid */}
  {
    (diffNarrativeHtml || principles.length > 0) && (
      <section class="relative overflow-hidden bg-white">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
          <div class="mx-auto max-w-3xl text-center" data-reveal>
            <p class="mb-3 font-accent text-2xl leading-none text-lime-600">Our approach</p>
            <h2 class="font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
              How we're different.
            </h2>
            {diffNarrativeHtml && (
              <div
                class="prose prose-slate prose-lg mt-8 max-w-none text-left"
                set:html={diffNarrativeHtml}
              />
            )}
          </div>

          {principles.length > 0 && (
            <div
              class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
              data-reveal
            >
              {principles.map((item, idx) => (
                <div
                  class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-lg hover:shadow-teal-900/5"
                  style={`transition-delay: ${idx * 40}ms`}
                >
                  <span
                    class="absolute -top-3 left-6 rounded-full bg-slate-900 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-lime-300"
                  >
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <div
                    class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-teal-50 to-lime-50 text-teal-700 ring-1 ring-teal-100 transition-all duration-300 group-hover:bg-gradient-to-br group-hover:from-teal-600 group-hover:to-teal-700 group-hover:text-white group-hover:ring-teal-600"
                    set:html={ICONS[iconFor(item.head)]}
                  />
                  <h3 class="mt-5 font-display text-lg font-bold leading-snug text-slate-900">
                    {item.head}
                  </h3>
                  {item.body && (
                    <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.body}</p>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Closing CTA */}
  <section
    class="relative overflow-hidden bg-gradient-to-r from-teal-700 via-teal-800 to-slate-900 text-white"
  >
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-lime-400/10 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-6 py-20 text-center" data-reveal>
      <p class="mb-3 font-accent text-2xl leading-none text-lime-300">Get involved</p>
      <h2 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        Partner with us — or join the work.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-teal-100">
        We're building practical, locally-led solutions across Kiribati. Whether you're a
        community group, donor, or curious supporter, we'd love to hear from you.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full bg-lime-300 px-8 py-3 font-semibold text-slate-900 shadow-lg shadow-lime-400/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-lime-400 hover:shadow-xl hover:shadow-lime-400/40"
        >
          Get in touch
          <span set:html={arrowRight} />
        </a>
        <a
          href="/#our-work"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white ring-1 ring-white/30 transition-colors duration-300 hover:bg-white/10"
        >
          See our work
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Drop cap on the first paragraph of the origin narrative. */
  .about-origin :global(p:first-of-type::first-letter) {
    float: left;
    margin-right: 0.75rem;
    margin-top: 0.3rem;
    font-family: var(--theme-font-display, inherit);
    font-weight: 800;
    font-size: 4.5rem;
    line-height: 0.85;
    color: oklch(0.74 0.18 130);
  }
</style>
