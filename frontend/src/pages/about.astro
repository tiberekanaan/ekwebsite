---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import { STRAPI_URL } from 'astro:env/server';
// Placeholder photography — overwrite these files with real photos of the team
// and communities (same path/filename) and give each a meaningful alt below.
import photoStory1 from '@/assets/images/community/impact-engagement-01.jpg';
import photoStory2 from '@/assets/images/community/impact-engagement-02.jpg';

type BasicPage = {
  documentId: string;
  title: string;
  content: string | null;
};

const res = await fetch(`${STRAPI_URL}/api/basic-page`);
let page: BasicPage | null = null;

if (res.ok) {
  const { data } = (await res.json()) as { data: BasicPage | null };
  page = data;
} else if (res.status !== 403 && res.status !== 404) {
  throw new Error(`Strapi /api/basic-page → ${res.status} ${res.statusText}`);
} else {
  console.warn(
    `Strapi /api/basic-page returned ${res.status} — falling back to placeholder. Check the singleType is published and Public has 'find' permission.`,
  );
}

const title = page?.title ?? 'About';
const md = page?.content ?? '';

// Split richtext by `## ` H2 headings so each section gets its own visual treatment.
const parts = md.split(/^##\s+(.+)$/m);
const originMd = (parts[0] ?? '').trim();
const sectionsByHeading = new Map<string, string>();
for (let i = 1; i < parts.length; i += 2) {
  sectionsByHeading.set(parts[i].trim().toLowerCase(), (parts[i + 1] ?? '').trim());
}
const findSection = (needle: string) => {
  for (const [heading, body] of sectionsByHeading) {
    if (heading.includes(needle)) return body;
  }
  return '';
};

const missionMd = findSection('mission');
const visionMd = findSection('vision');
const differentMd = findSection('different');

// In the "different" section, peel the lead paragraphs off the bullet list.
const diffLines = differentMd.split('\n');
const firstBulletIdx = diffLines.findIndex((l) => /^\s*-\s/.test(l));
const diffNarrativeMd =
  firstBulletIdx === -1 ? differentMd : diffLines.slice(0, firstBulletIdx).join('\n').trim();
const diffBulletLines = firstBulletIdx === -1 ? [] : diffLines.slice(firstBulletIdx);

const principles = diffBulletLines
  .filter((l) => /^\s*-\s/.test(l))
  .map((line) => {
    const stripped = line.replace(/^\s*-\s+/, '');
    const match = stripped.match(/^\*\*([^*]+?)\s*:?\s*\*\*\s*:?\s*(.*)$/);
    if (match) return { head: match[1].trim(), body: match[2].trim() };
    const idx = stripped.indexOf(':');
    return {
      head: (idx > -1 ? stripped.slice(0, idx) : stripped).replace(/\*\*/g, '').trim(),
      body: (idx > -1 ? stripped.slice(idx + 1) : '').replace(/\*\*/g, '').trim(),
    };
  });

const originHtml = originMd ? marked.parse(originMd) : '';
const missionHtml = missionMd ? marked.parse(missionMd) : '';
const visionHtml = visionMd ? marked.parse(visionMd) : '';
const diffNarrativeHtml = diffNarrativeMd ? marked.parse(diffNarrativeMd) : '';

type IconKey = 'globe' | 'ear' | 'beaker' | 'users' | 'eye' | 'shield' | 'heart' | 'spark';

const ICONS: Record<IconKey, string> = {
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  ear: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3.5 3.5 0 1 1-7 0"/><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 1 0 4"/></svg>`,
  beaker: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M10 2v7.3"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6 6 0 0 1 3 5.2v.5a3 3 0 0 1-3 3H10a3 3 0 0 1-3-3v-.5a6 6 0 0 1 3-5.2"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  eye: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  spark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>`,
};

const iconFor = (head: string): IconKey => {
  const k = head.toLowerCase();
  if (k.includes('locally') || k.includes('local')) return 'globe';
  if (k.includes('listen') || k.includes('co-design') || k.includes('co‑design')) return 'ear';
  if (k.includes('practical') || k.includes('evidence')) return 'beaker';
  if (k.includes('inclusive')) return 'users';
  if (k.includes('accountable') || k.includes('transparent')) return 'eye';
  if (k.includes('endure') || k.includes('built')) return 'shield';
  if (k.includes('safety') || k.includes('safeguard')) return 'heart';
  return 'spark';
};

const targetIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-9 w-9"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`;
const compassIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-9 w-9"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`;
const arrowRight = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<Layout title={title} description={`${title} — Empower Kiribati`} floatingHeader>
  {/* Hero — full-bleed dark panel under the floating pill navbar */}
  <section
    class="relative overflow-hidden bg-ek-900 bg-[radial-gradient(1200px_600px_at_75%_-10%,rgba(42,128,137,0.55),transparent_60%),linear-gradient(160deg,var(--color-ek-800)_0%,var(--color-ek-900)_70%)] text-white"
  >
    <svg
      class="pointer-events-none absolute -top-[8%] right-[-6%] z-0 w-[520px] opacity-[0.06]"
      viewBox="0 0 200 200"
      aria-hidden="true"
    >
      <path d="M100 20c-25 0-45 20-45 50s20 60 45 60 45-30 45-60-20-50-45-50z" fill="#aecb3a"></path>
    </svg>

    <div class="relative z-[2] mx-auto w-full max-w-6xl px-7 pt-44 pb-20 lg:pt-52 lg:pb-24">
      <p
        data-reveal
        class="mb-5 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright"
      >
        Who we are · Empower Kiribati
      </p>
      <h1
        data-reveal
        data-reveal-delay="80"
        class="max-w-4xl bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text font-serif text-5xl font-bold leading-[1.06] text-transparent sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <span
        data-reveal
        data-reveal-delay="140"
        class="mt-6 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
        aria-hidden="true"></span>
      <p data-reveal data-reveal-delay="200" class="mt-6 max-w-[32em] text-xl leading-relaxed text-[#cfe0db]">
        Opportunity. Resilience. Dignity.{' '}
        <mark class="bg-ek-lime/25 px-1 text-ek-lime-bright">Shaped by I-Kiribati communities.</mark>
      </p>
      <div data-reveal data-reveal-delay="280" class="mt-9 flex flex-wrap items-center gap-3">
        {
          ['Locally led', 'Climate-aware', 'Partnership-driven'].map((chip) => (
            <span class="rounded-full bg-white/10 px-4 py-1.5 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-[#cfe0db] ring-1 ring-white/20 backdrop-blur">
              {chip}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {/* Origin narrative — magazine column with drop cap + offset photo pair */}
  {
    originHtml && (
      <section class="bg-white py-24">
        <div class="mx-auto grid w-full max-w-6xl items-start gap-x-14 gap-y-12 px-7 lg:grid-cols-[1.1fr_0.9fr]">
          <div data-reveal>
            <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
              01 · Our story
            </span>
            <h2 class="mb-4 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl">
              From Digital Kiribati to Empower Kiribati
            </h2>
            <span
              class="mb-8 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
              aria-hidden="true"
            />
            <article
              class="about-origin prose prose-lg max-w-none [&_a]:text-ek-600 [&_a:hover]:text-ek-800 [&_strong]:text-ek-ink"
              set:html={originHtml}
            />
          </div>

          {/* Offset photo pair — moments from the work itself. */}
          <div class="grid grid-cols-2 gap-4 lg:sticky lg:top-28" data-reveal data-reveal-delay="150">
            <Image
              src={photoStory1}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 1024px) 240px, 45vw"
              class="aspect-[3/4] w-full rounded-2xl object-cover shadow-[0_18px_44px_rgba(15,50,58,0.18)] ring-1 ring-ek-700/10"
            />
            <Image
              src={photoStory2}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 1024px) 240px, 45vw"
              class="mt-10 aspect-[3/4] w-full rounded-2xl object-cover shadow-[0_18px_44px_rgba(15,50,58,0.18)] ring-1 ring-ek-700/10"
            />
          </div>
        </div>
      </section>
    )
  }

  {/* Mission + Vision — dark/light card duet */}
  {
    (missionHtml || visionHtml) && (
      <section class="bg-ek-mist py-24">
        <div class="mx-auto w-full max-w-6xl px-7">
          <div class="mb-14 max-w-[640px]" data-reveal>
            <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
              02 · Why we exist
            </span>
            <h2 class="mb-4 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl">
              The seed we plant, the horizon we work toward
            </h2>
            <span
              class="block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
              aria-hidden="true"
            />
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {missionHtml && (
              <div
                class="group relative overflow-hidden rounded-3xl bg-ek-900 bg-[radial-gradient(600px_300px_at_80%_-10%,rgba(42,128,137,0.5),transparent_60%)] p-10 text-white ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(7,37,41,0.35)]"
                data-reveal
              >
                <div
                  class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-ek-lime/15 blur-2xl transition-opacity duration-500 group-hover:opacity-90"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div
                    class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-ek-lime-bright ring-1 ring-white/20"
                    set:html={targetIcon}
                  />
                  <p class="mt-7 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright">
                    Our mission
                  </p>
                  <h3 class="mt-2 bg-gradient-to-br from-white to-ek-lime-bright bg-clip-text font-serif text-3xl font-bold leading-tight text-transparent">
                    What we set out to do
                  </h3>
                  <div
                    class="prose mt-5 max-w-none text-lg leading-relaxed [&_p]:text-[#cfe0db] [&_li]:text-[#cfe0db] [&_strong]:text-white [&_a]:text-ek-lime-bright"
                    set:html={missionHtml}
                  />
                </div>
              </div>
            )}
            {visionHtml && (
              <div
                class="group relative overflow-hidden rounded-3xl border border-ek-700/10 bg-white p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_38px_rgba(15,50,58,0.1)]"
                data-reveal
                data-reveal-delay="120"
              >
                <div
                  class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-ek-500/15 blur-2xl transition-opacity duration-500 group-hover:opacity-90"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div
                    class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-ek-mist text-ek-600 ring-1 ring-ek-700/10"
                    set:html={compassIcon}
                  />
                  <p class="mt-7 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
                    Our vision
                  </p>
                  <h3 class="mt-2 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-3xl font-bold leading-tight text-transparent">
                    Where we're heading
                  </h3>
                  <div
                    class="prose mt-5 max-w-none text-lg leading-relaxed [&_p]:text-ek-muted [&_strong]:text-ek-ink [&_a]:text-ek-600"
                    set:html={visionHtml}
                  />
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* How we're different — narrative + numbered principle cards */}
  {
    (diffNarrativeHtml || principles.length > 0) && (
      <section class="bg-white py-24">
        <div class="mx-auto w-full max-w-6xl px-7">
          <div class="mb-14 max-w-[640px]" data-reveal>
            <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
              03 · Our approach
            </span>
            <h2 class="mb-4 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl">
              How we're different
            </h2>
            <span
              class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
              aria-hidden="true"
            />
            {diffNarrativeHtml && (
              <div
                class="prose prose-lg max-w-none [&_p]:text-ek-muted [&_strong]:text-ek-ink [&_a]:text-ek-600"
                set:html={diffNarrativeHtml}
              />
            )}
          </div>

          {principles.length > 0 && (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {principles.map((item, idx) => (
                <div
                  data-reveal
                  data-reveal-delay={idx * 80}
                  class="group relative flex flex-col rounded-2xl border border-ek-700/10 bg-white p-7 transition-all duration-200 hover:-translate-y-1 hover:border-ek-lime/60 hover:shadow-[0_16px_38px_rgba(15,50,58,0.1)]"
                >
                  <span class="absolute -top-3 left-6 rounded-full bg-ek-900 px-2.5 py-1 font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ek-lime-bright">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <span
                    class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-ek-mist text-ek-600 ring-1 ring-ek-700/10 transition-colors duration-200 group-hover:bg-ek-500 group-hover:text-white"
                    set:html={ICONS[iconFor(item.head)]}
                  />
                  <h3 class="mt-5 font-serif text-xl font-bold leading-snug text-ek-800">
                    {item.head}
                  </h3>
                  {item.body && <p class="mt-2 text-base text-slate-600">{item.body}</p>}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Closing CTA — dark band */}
  <section class="bg-gradient-to-b from-ek-900 to-ek-800 py-24 text-white">
    <div class="mx-auto w-full max-w-6xl px-7">
      <div class="max-w-[640px]" data-reveal>
        <span
          class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright"
        >
          04 · Get involved
        </span>
        <h2
          class="mb-4 bg-gradient-to-r from-white to-ek-lime-bright bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl"
        >
          Partner with us — or join the work
        </h2>
        <span
          class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
          aria-hidden="true"></span>
        <p class="text-lg text-[#b9cdc8]">
          We're building practical, locally-led solutions across Kiribati. Whether you're a
          community group, donor, or curious supporter, we'd love to hear from you.
        </p>
      </div>
      <div
        class="mt-12 flex flex-wrap items-center justify-between gap-[30px] border-t border-ek-lime/20 pt-10"
        data-reveal
      >
        <p
          class="max-w-[18em] bg-gradient-to-r from-white to-ek-lime-bright bg-clip-text font-condensed text-2xl font-semibold uppercase leading-[1.1] text-transparent sm:text-3xl"
        >
          Together, we can grow a stronger Kiribati.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
          >
            Get in touch
            <span set:html={arrowRight} />
          </a>
          <a
            href="/#our-work"
            class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-white/35 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-white transition-colors duration-200 hover:border-ek-lime-bright hover:text-ek-lime-bright"
          >
            See our work
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Drop cap on the first paragraph of the origin narrative. */
  .about-origin :global(p:first-of-type::first-letter) {
    float: left;
    margin-right: 0.75rem;
    margin-top: 0.3rem;
    font-family: var(--font-serif, inherit);
    font-weight: 700;
    font-size: 4.5rem;
    line-height: 0.85;
    color: var(--color-ek-olive);
  }
</style>
