---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LanguageToggle from '@/components/empower/LanguageToggle.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { STRAPI_URL } from 'astro:env/server';
import { STRAPI_LOCALES, resolveLang, type Lang } from '@/lib/i18n';
import { statusLabel, statusPillClass, type ProgrammeStatus } from '@/lib/programme-status';

export const prerender = false;

interface LocalizedProject {
  documentId: string;
  locale: string;
  title: string;
  description: string | null;
  project_status: ProgrammeStatus | null;
  objectives: string | null;
  location: string | null;
  metrics: string | null;
  localizations: Array<{ documentId: string; locale: string }> | null;
}

const { slug } = Astro.params;
const lang = resolveLang(Astro.url.searchParams.get('lang'));

const projects = await getCollection('projects');
const project = projects.find((entry) => entry.data.slug === slug);
if (!project) return Astro.rewrite('/404');

const fetchLocalized = async (locale: string): Promise<LocalizedProject | null> => {
  try {
    const res = await fetch(
      `${STRAPI_URL}/api/projects/${project.id}?locale=${locale}&populate[localizations]=true`,
    );
    if (!res.ok) return null;
    const { data } = (await res.json()) as { data: LocalizedProject };
    return data;
  } catch {
    return null;
  }
};

let localized = await fetchLocalized(STRAPI_LOCALES[lang]);
// fall back to English when the requested translation doesn't exist
if (!localized && lang !== 'en') localized = await fetchLocalized(STRAPI_LOCALES.en);

// relations and media are shared across locales — keep them from the build-time
// collection entry; only the localized text fields come from the runtime fetch
const { image, partners, testimonials, strategy, pillars, activities } = project.data;
const strategyTitle = strategy?.title ?? pillars[0]?.title ?? null;
const title = localized?.title ?? project.data.title;
const description = localized?.description ?? project.data.description;
const status = localized?.project_status ?? project.data.project_status;
const objectives = localized?.objectives ?? project.data.objectives;
const location = localized?.location ?? project.data.location;
const metrics = localized?.metrics ?? project.data.metrics;
const hasTranslation = (localized?.localizations ?? []).length > 0;
const currentLang: Lang = localized?.locale === STRAPI_LOCALES.kir ? 'kir' : 'en';

const allPartners = await getCollection('partners');
const partnerById = new Map(allPartners.map((p) => [p.id, p.data]));

// join heading markers the Strapi editor leaves on their own line ("###\nTitle"),
// which markdown would otherwise render as an empty heading + plain paragraph
const fixOrphanHeadings = (md: string) => md.replace(/^(#{1,6})[ \t]*\r?\n+(?=\S)/gm, '$1 ');

const descriptionHtml = description ? marked.parse(fixOrphanHeadings(description)) : '';
const objectivesHtml = objectives ? marked.parse(fixOrphanHeadings(objectives)) : '';
const metricsHtml = metrics ? marked.parse(fixOrphanHeadings(metrics)) : '';

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// Delivery record: most recent first; totals count delivered sessions only.
const sortedActivities = [...activities].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const deliveredActivities = sortedActivities.filter((a) => a.delivered !== false);
const totalAttendance = deliveredActivities.reduce((sum, a) => sum + (a.attendance ?? 0), 0);
const hasEstimates = deliveredActivities.some(
  (a) => a.attendance != null && a.count_method === 'estimate',
);
const asOf = deliveredActivities[0]?.date ?? null;

const totalsSentence = asOf
  ? [
      `${deliveredActivities.length} ${deliveredActivities.length === 1 ? 'session' : 'sessions'} delivered`,
      totalAttendance > 0 ? `${totalAttendance.toLocaleString('en-GB')} attendances recorded` : null,
    ]
      .filter(Boolean)
      .join(', ')
  : null;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// "18 to 19 June 2026" when the range stays in one month, else both in full.
const formatRange = (start: Date, end?: Date | null) => {
  if (!end || end.valueOf() === start.valueOf()) return formatDate(start);
  if (start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear()) {
    return `${start.getDate()} to ${formatDate(end)}`;
  }
  return `${formatDate(start)} to ${formatDate(end)}`;
};
---

<Layout
  title={title}
  description={description ?? `${title} — an Empower Kiribati program.`}
  floatingHeader
>
  <PageHeader
    eyebrow={strategyTitle ?? 'Programme'}
    title={title}
    backHref="/our-programs"
    backLabel="Back to Our work"
  >
    <div class="mt-6 flex flex-wrap items-center gap-2.5" data-reveal data-reveal-delay="200">
      {
        status && (
          <span
            class={`inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 font-condensed text-xs font-semibold uppercase tracking-[0.14em] ${statusPillClass(status)}`}
          >
            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-current" />
            {statusLabel(status)}
          </span>
        )
      }
      {
        location && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs font-semibold text-slate-700">
            <svg
              aria-hidden="true"
              class="h-3.5 w-3.5 text-teal-700"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              />
            </svg>
            {location}
          </span>
        )
      }
      {hasTranslation && <LanguageToggle current={currentLang} path={Astro.url.pathname} />}
    </div>
  </PageHeader>
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-8 py-12">
      <!-- Description + partners on the left, photo on the right -->
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-5 lg:gap-14">
        <div class="lg:col-span-3" data-reveal>
          {
            descriptionHtml && (
              <article
                class="prose prose-slate prose-lg max-w-none prose-headings:font-display prose-a:text-teal-700 hover:prose-a:text-teal-900"
                set:html={descriptionHtml}
              />
            )
          }

          {
            partners.length > 0 && (
              <div class="mt-8">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
                  In partnership with
                </p>
                <div class="flex flex-wrap items-center gap-2">
                  {partners.map((partnerRef) => {
                    const fullPartner = partnerById.get(partnerRef.documentId);
                    return (
                      <a
                        href={`/our-partners/${partnerRef.documentId}`}
                        class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800"
                      >
                        {fullPartner?.logo ? (
                          <img
                            src={absoluteUrl(fullPartner.logo.url)}
                            alt={fullPartner.logo.alternativeText ?? partnerRef.name}
                            class="h-6 w-6 rounded-full object-contain"
                            loading="lazy"
                          />
                        ) : (
                          <span
                            aria-hidden="true"
                            class="h-6 w-6 rounded-full bg-gradient-to-br from-teal-400 to-emerald-500"
                          />
                        )}
                        <span>{partnerRef.name}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )
          }
        </div>

        <figure class="lg:col-span-2" data-reveal>
          {
            image ? (
              <img
                src={absoluteUrl(image.url)}
                alt={image.alternativeText ?? title}
                class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl shadow-slate-900/15 ring-1 ring-slate-900/5"
                loading="eager"
              />
            ) : (
              <div
                aria-hidden="true"
                class="aspect-[4/3] w-full rounded-2xl bg-gradient-to-br from-teal-600 via-teal-500 to-emerald-600"
              />
            )
          }
        </figure>
      </div>

      {
        objectivesHtml && (
          <section
            class="mt-16 rounded-2xl border border-teal-100 bg-gradient-to-br from-teal-50/70 to-white p-8 lg:p-12"
            data-reveal
          >
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
              <div>
                <p class="mb-4 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
                  Objectives
                </p>
                <h2 class="bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-3xl font-bold tracking-tight text-transparent">
                  What this program sets out to do
                </h2>
                <span class="mt-4 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
              </div>
              <article
                class="prose prose-slate max-w-none lg:col-span-2 prose-headings:font-display prose-li:marker:text-teal-600 prose-a:text-teal-700 hover:prose-a:text-teal-900"
                set:html={objectivesHtml}
              />
            </div>
          </section>
        )
      }
      {
        sortedActivities.length > 0 && (
          <section class="mt-16" data-reveal>
            <p class="mb-4 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
              Delivery record
            </p>
            <h2 class="bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-3xl font-bold tracking-tight text-transparent">
              What this programme has delivered
            </h2>
            {totalsSentence && asOf && (
              <p class="mt-4 max-w-[46em] text-ek-muted">
                {totalsSentence}, as of {formatDate(asOf)}.
              </p>
            )}
            <div class="mt-8 border-t border-ek-700/10">
              {sortedActivities.map((a) => (
                <div class="grid items-baseline gap-1 border-b border-ek-700/10 py-4 md:grid-cols-[190px_1fr_auto] md:gap-6">
                  <div class="font-condensed text-[0.85rem] font-semibold uppercase tracking-[0.08em] text-ek-olive">
                    {formatRange(a.date, a.end_date)}
                  </div>
                  <div>
                    <span class="font-semibold text-ek-ink">{a.title}</span>
                    {a.venue && <span class="text-ek-muted"> · {a.venue}</span>}
                    {a.island && a.island !== 'South Tarawa' && (
                      <span class="text-ek-muted"> · {a.island}</span>
                    )}
                    {a.delivered === false && (
                      <span class="text-ek-muted">
                        {' '}
                        · Not delivered{a.not_delivered_reason && `: ${a.not_delivered_reason}`}
                      </span>
                    )}
                  </div>
                  {a.delivered !== false && a.attendance != null && (
                    <div class="whitespace-nowrap text-sm text-ek-muted md:justify-self-end">
                      {a.count_method === 'estimate' && '~'}
                      {a.attendance.toLocaleString('en-GB')} attended
                    </div>
                  )}
                </div>
              ))}
            </div>
            {hasEstimates && (
              <p class="mt-4 max-w-[46em] text-sm text-ek-muted">
                Figures marked ~ are estimates from sessions too large to count person by person.
                All other figures are from signed attendance registers.
              </p>
            )}
          </section>
        )
      }
    </div>
  </section>

  {
    metricsHtml && (
      <section class="bg-ek-900 bg-[radial-gradient(1200px_600px_at_75%_-10%,rgba(42,128,137,0.35),transparent_60%)]">
        <div class="mx-auto max-w-7xl px-8 py-16 lg:py-20" data-reveal>
          <p class="mb-4 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright">
            Impact
          </p>
          <h2 class="bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text font-serif text-3xl font-bold tracking-tight text-transparent sm:text-4xl">
            Key metrics &amp; results
          </h2>
          <article
            class="prose mt-10 max-w-none columns-1 gap-12 text-slate-300 md:columns-2 [&>*]:break-inside-avoid [&_h2]:font-display [&_h2]:text-lime-300 [&_h3]:font-display [&_h3]:text-lg [&_h3]:uppercase [&_h3]:tracking-wider [&_h3]:text-lime-300 [&_h4]:text-lime-300 [&_p]:text-slate-300 [&_li]:text-slate-300 [&_li::marker]:text-lime-400 [&_strong]:text-white [&_a]:text-lime-300"
            set:html={metricsHtml}
          />
        </div>
      </section>
    )
  }

  {
    testimonials.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto max-w-7xl px-8 py-16 lg:py-20" data-reveal>
          <p class="mb-4 font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
            Voices
          </p>
          <h2 class="bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-3xl font-bold tracking-tight text-transparent sm:text-4xl">
            What people are saying
          </h2>
          <ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
            {testimonials.map((testimonial) => (
              <li class="flex h-full flex-col rounded-xl border border-slate-200 bg-slate-50 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-slate-900/10">
                <svg
                  aria-hidden="true"
                  class="h-8 w-8 text-teal-600/40"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
                </svg>
                <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-slate-700">
                  “{testimonial.quote}”
                </blockquote>
                <footer class="mt-6">
                  <p class="font-bold text-slate-900">{testimonial.author}</p>
                  {testimonial.role && <p class="text-sm text-slate-500">{testimonial.role}</p>}
                </footer>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
