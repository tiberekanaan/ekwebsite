---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

const projects = (await getCollection('projects')).sort((a, b) => {
  const aDate = a.data.publishedAt?.valueOf() ?? a.data.createdAt?.valueOf() ?? 0;
  const bDate = b.data.publishedAt?.valueOf() ?? b.data.createdAt?.valueOf() ?? 0;
  return bDate - aDate;
});

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<Layout
  title="Our Programs"
  description="Programs and initiatives driving Empower Kiribati's mission across the atolls."
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
    <header class="mb-12 max-w-2xl">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-500">Programs</p>
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Our <span class="text-teal-700">Programs</span>
      </h1>
      <p class="mt-4 text-base text-slate-600">
        The initiatives we're running across Kiribati — built with our partners, for our communities.
      </p>
    </header>

    {
      projects.length === 0 ? (
        <p class="py-16 text-center text-slate-500">No programs published yet.</p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => {
            const { title, description, image, partners: linkedPartners } = project.data;
            return (
              <li class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white">
                <div class="aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-slate-100 to-teal-50">
                  {image && (
                    <img
                      src={absoluteUrl(image.url)}
                      alt={image.alternativeText ?? title}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-3 p-6">
                  <h2 class="text-xl font-bold leading-snug text-slate-900">{title}</h2>
                  {description && (
                    <p class="line-clamp-3 text-sm text-slate-600">{description}</p>
                  )}
                  {linkedPartners.length > 0 && (
                    <div class="mt-auto flex flex-wrap gap-2 pt-2">
                      {linkedPartners.map((partner) => (
                        <a
                          href={`/our-partners/${partner.documentId}`}
                          class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 transition-colors hover:bg-teal-100 hover:text-teal-800"
                        >
                          {partner.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Layout>
