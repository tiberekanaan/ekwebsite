---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

const projects = (await getCollection('projects')).sort((a, b) => {
  const aDate = a.data.publishedAt?.valueOf() ?? a.data.createdAt?.valueOf() ?? 0;
  const bDate = b.data.publishedAt?.valueOf() ?? b.data.createdAt?.valueOf() ?? 0;
  return bDate - aDate;
});

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<Layout
  title="Empowering Leaders & Communities"
  description="Capability-building, mentorship, and local leadership pathways that help communities lead their own change across Kiribati's atolls."
>
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <div class="max-w-3xl">
        <div data-reveal>
          <p class="mb-3 font-accent text-3xl leading-none text-slate-700">Programs</p>
          <h1
            class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
          >
            Empowering Leaders & <span class="text-teal-700">Communities</span>
          </h1>
        </div>

        <div
          class="mt-10 space-y-6 text-base leading-relaxed text-slate-700 sm:text-lg"
          data-reveal
        >
          <p>
            We believe lasting change in Kiribati must be led locally — by people who understand the
            rhythms of island life, the realities of outer atolls, and the strengths already present
            in community networks. When leadership is rooted in culture and community priorities,
            solutions are more relevant, more trusted, and far more likely to endure beyond a single
            project or funding cycle.
          </p>
          <p>
            That's why we invest in building capability and leadership pathways: training,
            mentorship, and practical opportunities that help emerging leaders gain confidence,
            skills, and support. By strengthening local organizations, youth and women's leadership,
            and community decision-making, we help communities move from being recipients of support
            to being designers and drivers of their own development.
          </p>
          <p>
            Empowered communities are also better prepared to navigate climate pressures, economic
            uncertainty, and the rapid shift to digital services. When people have the knowledge,
            tools, and voice to advocate for themselves, they can protect what matters, take
            informed risks, and build inclusive opportunities for the next generation — on their own
            terms.
          </p>
        </div>
      </div>

      {
        projects.length === 0 ? (
          <p class="mt-16 text-center text-slate-500">No programs published yet.</p>
        ) : (
          <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => {
              const { title, description, image, partners: linkedPartners } = project.data;
              return (
                <li
                  data-reveal
                  class="relative flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-slate-900/10"
                >
                  <div class="aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-slate-100 to-teal-50">
                    {image && (
                      <img
                        src={absoluteUrl(image.url)}
                        alt={image.alternativeText ?? title}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-3 p-6">
                    <h2 class="text-xl font-bold leading-snug text-slate-900">
                      <a
                        href={`/projects/${project.data.slug}`}
                        class="transition-colors hover:text-teal-700 after:absolute after:inset-0 after:content-['']"
                      >
                        {title}
                      </a>
                    </h2>
                    {description && (
                      <p class="line-clamp-3 text-sm text-slate-600">{description}</p>
                    )}
                    {linkedPartners.length > 0 && (
                      <div class="mt-auto flex flex-wrap gap-2 pt-2">
                        {linkedPartners.map((partner) => (
                          <a
                            href={`/our-partners/${partner.documentId}`}
                            class="relative z-10 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 transition-colors hover:bg-teal-100 hover:text-teal-800"
                          >
                            {partner.name}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</Layout>
