---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/empower/Header.astro';
import Footer from '@/components/empower/Footer.astro';
import Motion from '@/components/empower/Motion.astro';
import Search from '@/components/empower/Search.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  /** Floats the navbar over a full-bleed hero (landing only). */
  floatingHeader?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex,
  nofollow,
  includeOrgSchema,
  floatingHeader = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
>
  <Header slot="header" floating={floatingHeader} />

  <slot />

  <Footer slot="footer" />
  <Search />
  <Motion />
</BaseLayout>
