---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/empower/Header.astro';
import Footer from '@/components/empower/Footer.astro';
import Motion from '@/components/empower/Motion.astro';
import Search from '@/components/empower/Search.astro';
import { STRAPI_URL } from 'astro:env/server';
import { fetchGlobal } from '@/lib/global';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  /** Floats the navbar over a full-bleed hero (landing only). */
  floatingHeader?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex,
  nofollow,
  includeOrgSchema,
  floatingHeader = false,
} = Astro.props;

// Global settings from Strapi (site name, favicon, logos, nav, contact and
// footer content); null when Strapi is down or the single type is
// unpublished — every consumer falls back to its hard-coded default.
const global = await fetchGlobal();

const absoluteUrl = (path?: string | null) =>
  path ? (path.startsWith('http') ? path : `${STRAPI_URL}${path}`) : undefined;

const favicon =
  global?.favicon?.url !== undefined
    ? { href: absoluteUrl(global.favicon!.url)!, type: global.favicon!.mime }
    : undefined;

const logo = global?.logo?.url
  ? { url: absoluteUrl(global.logo.url)!, alternativeText: global.logo.alternativeText }
  : undefined;

const logoWhite = global?.logoWhite?.url
  ? { url: absoluteUrl(global.logoWhite.url)!, alternativeText: global.logoWhite.alternativeText }
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
  siteName={global?.siteName ?? undefined}
  favicon={favicon}
>
  <Header
    slot="header"
    floating={floatingHeader}
    logo={logo}
    logoWhite={logoWhite}
    links={global?.navbarLinks ?? undefined}
    cta={global?.headerCta ?? undefined}
  />

  <slot />

  <Footer slot="footer" global={global} logoWhite={logoWhite} />
  <Search />
  <Motion />
</BaseLayout>
