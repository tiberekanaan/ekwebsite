---
/**
 * Nested "On this page" outline for long resource articles. Rendered twice by
 * the article page (a collapsible panel on small screens, a sticky rail on
 * lg+); the page's script marks the link for the section in view with
 * `.is-active` on every copy.
 */
import type { TocSection } from '@/lib/article-toc';

interface Props {
  sections: TocSection[];
}

const { sections } = Astro.props;
---

<ol class="toc">
  {
    sections.map((section) => (
      <li>
        <a href={`#${section.id}`} data-toc-link>
          {section.text}
        </a>
        {section.children.length > 0 && (
          <ol>
            {section.children.map((child) => (
              <li>
                <a href={`#${child.id}`} data-toc-link>
                  {child.text}
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ol>

<style>
  .toc,
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc a {
    display: block;
    border-left: 2px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
    padding: 0.35rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--color-ek-muted);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .toc > li > a {
    font-weight: 600;
    color: var(--color-ek-ink);
  }
  .toc > li + li > a {
    margin-top: 0.35rem;
  }
  .toc ol a {
    padding-left: 1.75rem;
    font-size: 0.84rem;
  }
  .toc a:hover {
    border-color: var(--color-ek-500);
    color: var(--color-ek-600);
  }
  .toc a.is-active {
    border-color: var(--color-ek-lime);
    background: color-mix(in oklab, var(--color-ek-mist) 55%, transparent);
    color: var(--color-ek-600);
  }
</style>
