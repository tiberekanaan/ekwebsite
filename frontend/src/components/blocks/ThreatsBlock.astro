---
import { getCollection } from 'astro:content';

interface ThreatItem {
  threatLabel: string;
  threatText: string | null;
  answerTitle: string;
  answerText: string | null;
  ctaLabel?: string | null;
  ctaUrl?: string | null;
}

export interface ThreatsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  lead?: string | null;
  items?: ThreatItem[] | null;
}

interface Props {
  block: ThreatsBlockData;
}

const { block } = Astro.props;

const defaults: ThreatItem[] = [
  {
    threatLabel: 'When the environment shifts',
    threatText: 'Climate change erodes the land, water, and food our communities rely on.',
    answerTitle: 'We create conditions for innovation',
    answerText:
      'We help communities test, learn, and adapt new ways of growing food, preserving culture, and building climate resilience — so solutions are owned locally.',
  },
  {
    threatLabel: 'When jobs are scarce',
    threatText: 'A narrow job market leaves capable people without a way to earn.',
    answerTitle: 'We enable livelihoods & enterprise',
    answerText:
      'We teach practical money management and help entrepreneurs build viable businesses — creating new income that doesn’t depend on a limited job market.',
  },
  {
    threatLabel: 'When the world moves online',
    threatText: 'Many are left behind without the skills to take part safely.',
    answerTitle: 'We enable digital participation',
    answerText:
      'We build the digital literacy and cyber-safety skills people need to navigate the internet with confidence — so no one is left behind.',
  },
  {
    threatLabel: 'When progress is fragile',
    threatText: 'Change stalls when it depends on too few people.',
    answerTitle: 'We empower leaders & communities',
    answerText:
      'We develop local stewards and build strong organisational foundations — so communities can lead their own change long after external funding ends.',
  },
  {
    threatLabel: 'Because we can’t do this alone',
    threatText: 'Lasting change needs reach beyond any one organisation.',
    answerTitle: 'We build partnerships for impact',
    answerText:
      'We forge trusted relationships with government ministries and regional funders — so our work reaches every island and achieves true scale.',
  },
];

const items: ThreatItem[] =
  block.items && block.items.length > 0 ? block.items : defaults;

// Short tab labels for the design pass — a CMS field can replace these later.
const TAB_LABELS = ['Environment', 'Livelihoods', 'Digital', 'Leadership', 'Partnerships'];

// Each answer maps to one of the four empowerment Pillars. Match by the
// pillar's distinctive words appearing in the answer title; fall back to the
// programmes overview when no pillar fits (e.g. livelihoods & enterprise).
const pillarEntries = await getCollection('pillars');
const pillarKeywords = pillarEntries.map((entry) => ({
  slug: entry.data.slug,
  words: entry.data.title
    .toLowerCase()
    .split(/[^a-z]+/)
    .filter((w) => w.length > 4),
}));

const resolveAnswerHref = (answerTitle: string) => {
  const a = answerTitle.toLowerCase();
  const hit = pillarKeywords.find((p) => p.words.some((w) => a.includes(w)));
  return hit ? `/pillars/${hit.slug}` : '/our-programs';
};
---

<section id="pillars" class="relative overflow-hidden bg-white py-24">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[420px] w-[420px] rounded-full bg-ek-lime/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-48 -left-40 h-[420px] w-[420px] rounded-full bg-ek-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-7" data-roots-tabs>
    <div class="mb-10 max-w-[680px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        02 · {block.eyebrow ?? 'How we adapt'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Our roots of empowerment'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {
          block.lead ? (
            block.lead
          ) : (
            <Fragment>
              Like the bwabwai, surviving these challenges takes a healthy root system and the
              ability to adapt. We don’t offer temporary relief — we build the{' '}
              <strong class="font-semibold text-ek-800">knowledge, skills, and local leadership</strong>{' '}
              needed to meet each threat at its root. Pick a challenge to see how it becomes a
              pathway for growth.
            </Fragment>
          )
        }
      </p>
    </div>

    <div
      class="mb-8 flex flex-wrap gap-2"
      role="tablist"
      aria-label={block.title ?? 'Our roots of empowerment'}
      data-reveal
      data-reveal-delay="100"
    >
      {
        items.map((item, i) => (
          <button
            type="button"
            id={`roots-tab-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`roots-panel-${i}`}
            tabindex={i === 0 ? 0 : -1}
            class="group inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 font-condensed text-[0.82rem] font-semibold uppercase tracking-[0.1em] text-ek-muted transition-all duration-200 hover:border-ek-olive/50 hover:text-ek-800 aria-selected:border-transparent aria-selected:bg-ek-800 aria-selected:text-white aria-selected:shadow-[0_8px_20px_rgba(11,55,61,0.25)]"
          >
            <span class="text-ek-olive transition-colors duration-200 group-aria-selected:text-ek-lime-bright" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {TAB_LABELS[i % TAB_LABELS.length]}
          </button>
        ))
      }
    </div>

    <div data-reveal data-reveal-delay="180">
      {
        items.map((item, i) => (
          <div
            id={`roots-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`roots-tab-${i}`}
            hidden={i !== 0}
            class:list={['roots-panel', i === 0 && 'is-active']}
          >
            <div class="grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
              <div class="relative overflow-hidden rounded-2xl bg-ek-900 p-8 text-white sm:p-9">
                <div
                  class="pointer-events-none absolute inset-0 bg-[radial-gradient(320px_220px_at_85%_-5%,rgba(245,158,11,0.18),transparent_60%)]"
                  aria-hidden="true"
                />
                <span class="relative mb-4 inline-block font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-amber-400">
                  The threat
                </span>
                <h3 class="relative mb-3 font-serif text-2xl font-bold leading-snug sm:text-3xl">
                  {item.threatLabel}
                </h3>
                {item.threatText && <p class="relative text-[1.02rem] leading-relaxed text-[#b9cdc8]">{item.threatText}</p>}
              </div>

              <div class="relative rounded-2xl border border-ek-sand bg-ek-paper p-8 sm:p-9">
                <span
                  class="absolute -left-5 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-ek-lime font-condensed text-lg font-bold text-ek-900 shadow-[0_6px_16px_rgba(174,203,58,0.4)] lg:flex"
                  aria-hidden="true"
                >
                  →
                </span>
                <span class="mb-4 inline-block font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-ek-olive">
                  Our answer
                </span>
                <h3 class="mb-3 font-serif text-2xl font-bold leading-snug text-ek-800 sm:text-3xl">
                  {item.answerTitle}
                </h3>
                {item.answerText && <p class="text-[1.02rem] leading-relaxed text-slate-600">{item.answerText}</p>}
                <a
                  href={item.ctaUrl || resolveAnswerHref(item.answerTitle)}
                  class="group/link mt-6 inline-flex items-center gap-2 rounded-full bg-ek-800 px-5 py-2.5 font-condensed text-[0.8rem] font-semibold uppercase tracking-[0.1em] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-700"
                >
                  {item.ctaLabel || 'Explore this pillar'}
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover/link:translate-x-1">→</span>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .roots-panel {
    display: none;
  }

  .roots-panel.is-active {
    display: block;
    animation: roots-panel-in 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes roots-panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roots-panel.is-active {
      animation: none;
    }
  }
</style>

<noscript>
  <style>
    /* Without JS, show every threat → answer pair stacked and drop the tab bar. */
    .roots-panel {
      display: block !important;
    }
    .roots-panel + .roots-panel {
      margin-top: 1.25rem;
    }
    [data-roots-tabs] [role='tablist'] {
      display: none;
    }
  </style>
</noscript>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-roots-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

      const select = (index: number) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
        });
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
          panel.classList.toggle('is-active', i === index);
        });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (event) => {
          const dir = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!dir) return;
          event.preventDefault();
          const next = (i + dir + tabs.length) % tabs.length;
          select(next);
          tabs[next].focus();
        });
      });
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
