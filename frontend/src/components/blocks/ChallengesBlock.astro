---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { Image } from 'astro:assets';
import photoClimate from '@/assets/images/community/challenge-climate.jpg';
import photoWork from '@/assets/images/community/challenge-work.jpg';
import photoDigital from '@/assets/images/community/challenge-digital.jpg';
import photoLeadership from '@/assets/images/community/challenge-leadership.jpg';

interface ChallengeItem {
  title: string;
  caption: string | null;
  stat: string | null;
  statLabel: string | null;
  icon?: string | null;
}

export interface ChallengesBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  items?: ChallengeItem[] | null;
}

interface Props {
  block: ChallengesBlockData;
}

interface Challenge {
  title: string;
  caption: string;
  icon: string;
  photo: ImageMetadata;
  photoAlt: string;
}

// Photos pair with cards by position: climate, work, digital, leadership.
const PHOTOS = [photoClimate, photoWork, photoDigital, photoLeadership];
const PHOTO_ALTS = [
  'Rocks and eroded sand on a Kiribati shoreline where rising seas wear away the beach',
  'Young people lining up on an open village field between coconut palms',
  'A remote outer-island village of thatched homes on the sand',
  'Community members gathered for a meeting in a local hall',
];

const { block } = Astro.props;

// Line icons (inner SVG markup), keyed by the Strapi `icon` enumeration on
// shared.challenge-item; cards without a chosen icon cycle through the list.
const ICONS: Record<string, string> = {
  waves:
    '<path d="M3 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M12 3v6M9 6l3-3 3 3"/>',
  chart:
    '<path d="M4 20v-6M10 20v-9M16 20v-4M22 20H2"/><circle cx="16" cy="9" r="2"/>',
  screen:
    '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M8 10l-2 2 2 2M16 10l2 2-2 2"/>',
  people:
    '<circle cx="12" cy="7" r="3"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><path d="M3 11l2 2M21 11l-2 2"/>',
};
const ICON_CYCLE = Object.keys(ICONS);

const defaults: Challenge[] = [
  {
    title: 'Climate change',
    caption:
      'Rising seas wash away shorelines and contaminate the freshwater and soil our communities depend on for survival.',
    icon: ICONS.waves,
    photo: PHOTOS[0],
    photoAlt: PHOTO_ALTS[0],
  },
  {
    title: 'Unemployment',
    caption:
      'Few jobs and limited pathways into enterprise leave young people unable to earn, straining households and pushing many into vulnerable informal work.',
    icon: ICONS.chart,
    photo: PHOTOS[1],
    photoAlt: PHOTO_ALTS[1],
  },
  {
    title: 'Limited digital participation',
    caption:
      'Gaps in access, awareness, and confidence lock people out of the tools needed to connect, learn, and earn safely online.',
    icon: ICONS.screen,
    photo: PHOTOS[2],
    photoAlt: PHOTO_ALTS[2],
  },
  {
    title: 'Fragile local leadership',
    caption:
      'Progress too often rests on a few individuals or outside help, making it hard for communities to sustain long-term change on their own.',
    icon: ICONS.people,
    photo: PHOTOS[3],
    photoAlt: PHOTO_ALTS[3],
  },
];

const challenges: Challenge[] =
  block.items && block.items.length > 0
    ? block.items.map((c, i) => ({
        title: c.title,
        caption: c.caption ?? '',
        icon: (c.icon && ICONS[c.icon]) || ICONS[ICON_CYCLE[i % ICON_CYCLE.length]],
        photo: PHOTOS[i % PHOTOS.length],
        photoAlt: PHOTO_ALTS[i % PHOTO_ALTS.length],
      }))
    : defaults;
---

<section id="challenges" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4">{block.eyebrow ?? 'The changing soil'}</Eyebrow>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'The threats to our roots'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {
          block.description ??
            'Just as rising tides threaten the roots of the bwabwai, modern pressures are threatening the roots of our livelihoods, our culture, and our well-being. Four challenges shape life in Kiribati today.'
        }
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        challenges.map((c, i) => (
          <article
            data-reveal
            data-reveal-delay={i * 100}
            class="group relative overflow-hidden rounded-2xl border border-ek-700/10 bg-white transition-all duration-200 hover:-translate-y-1 hover:border-amber-400/60 hover:shadow-[0_16px_38px_rgba(15,50,58,0.1)]"
          >
            <div class="relative aspect-[3/2] overflow-hidden">
              <Image
                src={c.photo}
                alt={c.photoAlt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 270px, (min-width: 640px) 50vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute right-4 top-4 rounded-full bg-ek-900/55 px-2.5 py-1 font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-amber-300 backdrop-blur-sm">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="px-7 pb-[30px]">
              <span class="relative z-[2] -mt-6 mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white text-amber-600 shadow-md ring-1 ring-ek-700/10 transition-colors duration-200 group-hover:bg-amber-500 group-hover:text-white">
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                  set:html={c.icon}
                />
              </span>
              <h3 class="mb-[10px] font-serif text-2xl font-bold text-ek-800">
                {c.title}
              </h3>
              <p class="text-base text-slate-600">{c.caption}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
