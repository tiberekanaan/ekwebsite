---
interface ChallengeItem {
  title: string;
  caption: string | null;
  stat: string | null;
  statLabel: string | null;
}

export interface ChallengesBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  items?: ChallengeItem[] | null;
}

interface Props {
  block: ChallengesBlockData;
}

interface Challenge {
  title: string;
  caption: string;
  icon: string;
}

const { block } = Astro.props;

// Mockup line icons (inner SVG markup); cycle per card.
const ICONS = [
  '<path d="M3 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M12 3v6M9 6l3-3 3 3"/>',
  '<path d="M4 20v-6M10 20v-9M16 20v-4M22 20H2"/><circle cx="16" cy="9" r="2"/>',
  '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M8 10l-2 2 2 2M16 10l2 2-2 2"/>',
  '<circle cx="12" cy="7" r="3"/><path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><path d="M3 11l2 2M21 11l-2 2"/>',
];

const defaults: Challenge[] = [
  {
    title: 'Climate change',
    caption:
      'Rising seas wash away shorelines and contaminate the freshwater and soil our communities depend on for survival.',
    icon: ICONS[0],
  },
  {
    title: 'Unemployment',
    caption:
      'Few jobs and limited pathways into enterprise leave young people unable to earn, straining households and pushing many into vulnerable informal work.',
    icon: ICONS[1],
  },
  {
    title: 'Limited digital participation',
    caption:
      'Gaps in access, awareness, and confidence lock people out of the tools needed to connect, learn, and earn safely online.',
    icon: ICONS[2],
  },
  {
    title: 'Fragile local leadership',
    caption:
      'Progress too often rests on a few individuals or outside help, making it hard for communities to sustain long-term change on their own.',
    icon: ICONS[3],
  },
];

const challenges: Challenge[] =
  block.items && block.items.length > 0
    ? block.items.map((c, i) => ({
        title: c.title,
        caption: c.caption ?? '',
        icon: ICONS[i % ICONS.length],
      }))
    : defaults;
---

<section id="challenges" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        01 · {block.eyebrow ?? 'The changing soil'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'The threats to our roots'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {
          block.description ??
            'Just as rising tides threaten the roots of the bwabwai, modern pressures are threatening the roots of our livelihoods, our culture, and our well-being. Four challenges shape life in Kiribati today.'
        }
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        challenges.map((c, i) => (
          <article
            data-reveal
            data-reveal-delay={i * 100}
            class="group relative rounded-2xl border border-ek-700/10 bg-white px-7 py-[30px] transition-all duration-200 hover:-translate-y-1 hover:border-amber-400/60 hover:shadow-[0_16px_38px_rgba(15,50,58,0.1)]"
          >
            <span class="absolute right-7 top-[26px] font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-amber-500">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 transition-colors duration-200 group-hover:bg-amber-500 group-hover:text-white">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
                set:html={c.icon}
              />
            </span>
            <h3 class="mb-[10px] font-serif text-2xl font-bold text-ek-800">
              {c.title}
            </h3>
            <p class="text-base text-slate-600">{c.caption}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
