---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { STRAPI_URL } from 'astro:env/server';
import type { ImageMetadata } from 'astro';
import photoLeadership from '../../assets/images/community/challenge-leadership.jpg';
import photoDigital from '../../assets/images/community/challenge-digital.jpg';
import photoPartnership from '../../assets/images/community/challenge-climate.jpg';
import photoInnovation from '../../assets/images/community/challenge-work.jpg';

interface AreaItem {
  title: string;
  description?: string | null;
  photo?: { url: string; alternativeText?: string | null } | null;
}

export interface WhatWeDoBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  items?: AreaItem[] | null;
}

interface Props {
  block: WhatWeDoBlockData;
}

const { block } = Astro.props;

// The four approved strategies from the 2026-2030 strategy. There are four,
// not five — livelihoods is a cross-cutting outcome, not a fifth area.
const defaults: AreaItem[] = [
  {
    title: 'Empowering leaders & communities',
    description:
      'We work with people who already hold responsibility in a community organisation, a church or a youth group, on the leadership and systems their organisation needs to last.',
  },
  {
    title: 'Enabling digital participation',
    description:
      'We deliver digital literacy and online safety work with schools, libraries and community groups, from basic internet skills through to recognising a scam.',
  },
  {
    title: 'Building partnerships for impact',
    description:
      'We connect what communities tell us they need with the ministries, funders and organisations able to help.',
  },
  {
    title: 'Creating conditions for innovation',
    description:
      'We create the space for people to test a practical idea, and help build the financial footing to keep it running.',
  },
];

const areas: AreaItem[] = block.items && block.items.length > 0 ? block.items : defaults;

// Line icons (inner SVG markup, 24x24 stroke grid) and a community photo,
// matched to an area by title keyword — the CMS shared.area-item has no
// icon/photo field, so unmatched titles cycle through the list positionally.
const VISUALS: Array<{ match: RegExp; svg: string; photo: ImageMetadata }> = [
  {
    // People gathered under a maneaba roof.
    match: /leader|communit/i,
    svg: '<path d="M3 10.5L12 4l9 6.5"/><circle cx="8.5" cy="14" r="2"/><circle cx="15.5" cy="14" r="2"/><path d="M4.5 21c.4-2.2 2-3.5 4-3.5s3.6 1.3 4 3.5M11.5 21c.4-2.2 2-3.5 4-3.5s3.6 1.3 4 3.5"/>',
    photo: photoLeadership,
  },
  {
    // Screen with a connection inside.
    match: /digital/i,
    svg: '<rect x="3" y="4.5" width="18" height="12.5" rx="2"/><path d="M9 21h6"/><path d="M9 10a4.2 4.2 0 0 1 6 0"/><circle cx="12" cy="13" r="1.1"/>',
    photo: photoDigital,
  },
  {
    // Two circles whose overlap is the point.
    match: /partner/i,
    svg: '<circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/>',
    photo: photoPartnership,
  },
  {
    // A lightbulb — an idea given room.
    match: /innovat/i,
    svg: '<path d="M9 18h6M10.5 21h3"/><path d="M12 3a6 6 0 0 0-4 10.5c.8.7 1.3 1.5 1.5 2.5h5c.2-1 .7-1.8 1.5-2.5A6 6 0 0 0 12 3z"/>',
    photo: photoInnovation,
  },
];
const visualFor = (title: string, i: number) =>
  VISUALS.find(({ match }) => match.test(title)) ?? VISUALS[i % VISUALS.length];

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// Each area deep-links to its strategy's section on /our-programs. The same
// keywords bridge minor title drift between the landing copy and the CMS
// strategy titles; no match falls back to the page top.
const strategies = await getCollection('pillars');
const hrefFor = (title: string): string => {
  const match = VISUALS.find(({ match: re }) => re.test(title))?.match;
  const strategy = match && strategies.find((s) => match.test(s.data.title));
  return strategy ? `/our-programs#${strategy.data.slug}` : '/our-programs';
};
---

<section id="what-we-do" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4">{block.eyebrow ?? 'What we do'}</Eyebrow>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Four areas of work'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {block.description ?? 'Each of our programmes belongs to one of these.'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        areas.map((area, i) => {
          const visual = visualFor(area.title, i);
          return (
            <a
              href={hrefFor(area.title)}
              data-reveal
              data-reveal-delay={i * 90}
              class="group relative block overflow-hidden rounded-3xl shadow-[0_10px_30px_rgba(15,50,58,0.12)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_22px_50px_rgba(15,50,58,0.22)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-ek-mist focus-visible:ring-ek-500"
            >
              {
                area.photo?.url ? (
                  <img
                    src={absoluteUrl(area.photo.url)}
                    alt={area.photo.alternativeText ?? ''}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/11] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06] sm:aspect-[4/5]"
                  />
                ) : (
                  <Image
                    src={visual.photo}
                    alt=""
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    class="aspect-[16/11] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06] sm:aspect-[4/5]"
                  />
                )
              }
              <span
                class="absolute inset-0 bg-gradient-to-t from-ek-900/95 via-ek-900/45 to-ek-900/5"
                aria-hidden="true"
              />
              <span
                class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/15 text-white ring-1 ring-white/25 backdrop-blur-md transition-colors duration-300 group-hover:bg-ek-500 group-hover:ring-ek-500"
                aria-hidden="true"
              >
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={visual.svg}
                />
              </span>
              <span
                class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white ring-1 ring-white/25 backdrop-blur-md transition-colors duration-300 group-hover:bg-ek-lime group-hover:text-ek-900 group-hover:ring-ek-lime"
                aria-hidden="true"
              >
                <svg
                  class="h-4 w-4 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
              <span class="absolute inset-x-0 bottom-0 p-5">
                <h3 class="mb-2 font-serif text-[1.35rem] font-bold leading-tight text-white">
                  {area.title}
                </h3>
                <p class="text-[0.83rem] leading-snug text-[#cfe0db]">{area.description}</p>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
