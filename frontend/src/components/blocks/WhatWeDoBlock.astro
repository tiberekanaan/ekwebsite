---
import { getCollection } from 'astro:content';

interface AreaItem {
  title: string;
  description?: string | null;
}

export interface WhatWeDoBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  items?: AreaItem[] | null;
}

interface Props {
  block: WhatWeDoBlockData;
}

const { block } = Astro.props;

// The four approved strategies from the 2026-2030 strategy. There are four,
// not five — livelihoods is a cross-cutting outcome, not a fifth area.
const defaults: AreaItem[] = [
  {
    title: 'Empowering leaders & communities',
    description:
      'We work with people who already hold responsibility in a community organisation, a church or a youth group, on the leadership and systems their organisation needs to last.',
  },
  {
    title: 'Enabling digital participation',
    description:
      'We deliver digital literacy and online safety work with schools, libraries and community groups, from basic internet skills through to recognising a scam.',
  },
  {
    title: 'Building partnerships for impact',
    description:
      'We connect what communities tell us they need with the ministries, funders and organisations able to help.',
  },
  {
    title: 'Creating conditions for innovation',
    description:
      'We create the space for people to test a practical idea, and help build the financial footing to keep it running.',
  },
];

const areas: AreaItem[] = block.items && block.items.length > 0 ? block.items : defaults;

// Line icons (inner SVG markup, 24x24 stroke grid) matched to an area by
// title keyword — the CMS shared.area-item has no icon field, so unmatched
// titles cycle through the list positionally.
const ICONS: Array<{ match: RegExp; svg: string }> = [
  {
    // People gathered under a maneaba roof.
    match: /leader|communit/i,
    svg: '<path d="M3 10.5L12 4l9 6.5"/><circle cx="8.5" cy="14" r="2"/><circle cx="15.5" cy="14" r="2"/><path d="M4.5 21c.4-2.2 2-3.5 4-3.5s3.6 1.3 4 3.5M11.5 21c.4-2.2 2-3.5 4-3.5s3.6 1.3 4 3.5"/>',
  },
  {
    // Screen with a connection inside.
    match: /digital/i,
    svg: '<rect x="3" y="4.5" width="18" height="12.5" rx="2"/><path d="M9 21h6"/><path d="M9 10a4.2 4.2 0 0 1 6 0"/><circle cx="12" cy="13" r="1.1"/>',
  },
  {
    // Two circles whose overlap is the point.
    match: /partner/i,
    svg: '<circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/>',
  },
  {
    // A lightbulb — an idea given room.
    match: /innovat/i,
    svg: '<path d="M9 18h6M10.5 21h3"/><path d="M12 3a6 6 0 0 0-4 10.5c.8.7 1.3 1.5 1.5 2.5h5c.2-1 .7-1.8 1.5-2.5A6 6 0 0 0 12 3z"/>',
  },
];
const iconFor = (title: string, i: number) =>
  (ICONS.find(({ match }) => match.test(title)) ?? ICONS[i % ICONS.length]).svg;

// Each area deep-links to its strategy's section on /our-programs. The same
// keywords bridge minor title drift between the landing copy and the CMS
// strategy titles; no match falls back to the page top.
const strategies = await getCollection('pillars');
const hrefFor = (title: string): string => {
  const match = ICONS.find(({ match: re }) => re.test(title))?.match;
  const strategy = match && strategies.find((s) => match.test(s.data.title));
  return strategy ? `/our-programs#${strategy.data.slug}` : '/our-programs';
};
---

<section id="what-we-do" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        01 · {block.eyebrow ?? 'What we do'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Four areas of work'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {block.description ?? 'Each of our programmes belongs to one of these.'}
      </p>
    </div>

    <div class="overflow-hidden rounded-3xl border border-ek-700/10 bg-white shadow-[0_10px_40px_rgba(15,50,58,0.06)]">
      {
        areas.map((area, i) => (
          <a
            href={hrefFor(area.title)}
            data-reveal
            data-reveal-delay={i * 90}
            class:list={[
              'group relative grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-5 gap-y-3 px-7 py-8 transition-colors duration-300 hover:bg-ek-mist/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ek-500 sm:px-10 lg:grid-cols-[auto_minmax(0,5fr)_minmax(0,6fr)_auto] lg:items-center lg:gap-x-10',
              i > 0 && 'border-t border-ek-700/10',
            ]}
          >
            <span
              class="absolute inset-y-0 left-0 w-1 origin-center scale-y-0 bg-ek-lime transition-transform duration-300 ease-out group-hover:scale-y-100"
              aria-hidden="true"
            />
            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-ek-mist text-ek-700 transition-colors duration-300 group-hover:bg-ek-500 group-hover:text-white"
              aria-hidden="true"
            >
              <svg
                class="h-7 w-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconFor(area.title, i)}
              />
            </span>
            <span class="min-w-0">
              <span class="mb-1 block font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
                {String(i + 1).padStart(2, '0')} · Area of work
              </span>
              <h3 class="font-serif text-[1.55rem] font-bold leading-tight text-ek-800 transition-colors duration-300 group-hover:text-ek-600">
                {area.title}
              </h3>
            </span>
            <p class="col-span-2 text-base leading-relaxed text-ek-muted lg:col-span-1">
              {area.description}
            </p>
            <span
              class="hidden h-11 w-11 items-center justify-center rounded-full border border-ek-700/15 text-ek-700 transition-all duration-300 group-hover:border-ek-900 group-hover:bg-ek-900 group-hover:text-ek-lime lg:flex"
              aria-hidden="true"
            >
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
