---
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

export interface PartnerMarqueeBlockData {
  eyebrow?: string | null;
  intro?: string | null;
}

interface Props {
  block: PartnerMarqueeBlockData;
}

const { block } = Astro.props;

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// Funders, government bodies and partners only, and only where the
// organisation has agreed to be named — a logo here reads as endorsement, so
// in-kind donors and co-implementors are deliberately excluded.
const partnerEntries = await getCollection('partners');
const plates = partnerEntries
  .filter(
    (p) =>
      (p.data.role === 'funder' || p.data.role === 'government' || p.data.role === 'partner') &&
      p.data.consent_to_name === true,
  )
  .map((p) => ({
    name: p.data.name,
    logo: p.data.logo ?? null,
    order: p.data.display_order,
  }))
  .sort((a, b) => {
    if (a.order != null && b.order != null) return a.order - b.order;
    if (a.order != null) return -1;
    if (b.order != null) return 1;
    return a.name.localeCompare(b.name);
  });

// Two or more plates scroll. A short list is repeated within each set (at
// least SET_MIN plates) so the moving strip never shows a gap; the whole set
// is then duplicated so the -50% translate loops seamlessly: the track has no
// gap of its own (each set carries its trailing pr-6), so its width is exactly
// two sets and the reset lands on an identical frame. Logos load eagerly —
// lazy images clipped by the overflow pop in mid-strip. Only the first
// occurrence of each partner is exposed to screen readers.
const SET_MIN = 8;
const useMarquee = plates.length >= 2;
const reps = useMarquee ? Math.ceil(SET_MIN / plates.length) : 1;
const setPlates = Array.from({ length: reps }, (_, r) =>
  plates.map((p) => ({ ...p, repeat: r > 0 })),
).flat();
const trackSets = useMarquee ? [false, true] : [false];
---

{
  plates.length > 0 && (
    <section id="funding-partners" class="flex min-h-[32rem] flex-col justify-center bg-ek-paper py-28">
      <div class="mx-auto w-full max-w-6xl px-7">
        <div class="mx-auto mb-14 max-w-[640px] text-center" data-reveal>
          <h2 class="mb-4 bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl">
            {block.eyebrow ?? 'Our partners'}
          </h2>
          <p class="text-lg text-ek-muted">
            {block.intro ??
              'The ministries, embassies and funds that back our work and shape it alongside national priorities.'}
          </p>
        </div>

        <div
          data-reveal
          class:list={[
            'partner-marquee-viewport relative overflow-hidden',
            useMarquee &&
              '[mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]',
          ]}
        >
          <div
            class:list={[
              'partner-marquee-track flex items-center',
              useMarquee ? 'w-max animate-funder-marquee' : 'w-full flex-wrap justify-center',
            ]}
          >
            {trackSets.map((isDuplicate) => (
              <div
                class="flex shrink-0 items-center gap-6 pr-6"
                aria-hidden={isDuplicate || undefined}
              >
                {setPlates.map((p) => {
                  const logo = p.logo?.url ? absoluteUrl(p.logo.url) : null;
                  return (
                    <div
                      class="flex h-24 w-56 shrink-0 items-center justify-center px-4"
                      aria-hidden={(!isDuplicate && p.repeat) || undefined}
                    >
                      {logo ? (
                        <img
                          src={logo}
                          alt={p.logo?.alternativeText ?? p.name}
                          class="max-h-20 max-w-full object-contain"
                        />
                      ) : (
                        <span class="text-center font-condensed text-[0.82rem] font-bold uppercase leading-tight tracking-[0.06em] text-ek-600">
                          {p.name}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  @keyframes funder-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-funder-marquee {
    animation: funder-marquee 34s linear infinite;
  }

  .animate-funder-marquee:hover {
    animation-play-state: paused;
  }

  /* With motion off the marquee becomes a plain horizontal scroll region:
     no animation, no edge mask, duplicate track copy hidden. */
  @media (prefers-reduced-motion: reduce) {
    .animate-funder-marquee {
      animation: none;
    }
    .partner-marquee-viewport {
      overflow-x: auto;
      mask-image: none !important;
    }
    .partner-marquee-track > [aria-hidden='true'] {
      display: none;
    }
  }
</style>
