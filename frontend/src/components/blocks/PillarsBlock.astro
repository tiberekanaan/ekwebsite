---
import { getCollection } from 'astro:content';

interface PillarRef {
  documentId?: string;
  title: string;
  description?: string | null;
}

export interface PillarsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  pillars?: PillarRef[] | null;
}

interface Props {
  block: PillarsBlockData;
}

interface PillarCard {
  title: string;
  description: string;
  band: string;
  imageBg: string;
  icon: string;
}

const { block } = Astro.props;

// Card styling cycles per index; CMS supplies the pillar title/description.
const BANDS = [
  'bg-lime-50 text-lime-900',
  'bg-sky-50 text-sky-900',
  'bg-amber-50 text-amber-900',
  'bg-violet-50 text-violet-900',
];
const IMAGE_BGS = [
  'from-emerald-700 via-emerald-600 to-emerald-800',
  'from-sky-700 via-sky-600 to-sky-800',
  'from-amber-600 via-orange-500 to-amber-700',
  'from-violet-700 via-purple-600 to-violet-800',
];
const ICONS = [
  'M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-5.13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm6 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  'M8 11V8a4 4 0 0 1 8 0v3M5 11h14l-1 9H6Z',
  'M12 2a7 7 0 0 0-4 12.7V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.3A7 7 0 0 0 12 2ZM10 21h4',
  'M4 7h16M4 12h16M4 17h10M18 17l2 2 4-4',
];

// Mirror the slug derivation used by the `pillars` content loader.
const slugify = (value: string) =>
  value
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/&/g, 'and')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

// Build a canonical title → slug map from the published Pillar entries.
const pillarEntries = await getCollection('pillars');
const pillarSlugByTitle = new Map(
  pillarEntries.map((entry) => [entry.data.title.trim().toLowerCase(), entry.data.slug]),
);

const resolvePillarHref = (title: string) => {
  const slug = pillarSlugByTitle.get(title.trim().toLowerCase()) ?? slugify(title);
  return slug ? `/pillars/${slug}` : '/#our-work';
};

const defaults: PillarCard[] = [
  {
    title: 'Empowering Leaders & Communities',
    description:
      'We strengthen local capability and leadership pathways so communities can lead change on their own terms.',
    band: BANDS[0],
    imageBg: IMAGE_BGS[0],
    icon: ICONS[0],
  },
  {
    title: 'Building Partnership for Impact',
    description:
      'We build trusted relationships with ministries, councils, and NGOs to coordinate and sustain investment.',
    band: BANDS[1],
    imageBg: IMAGE_BGS[1],
    icon: ICONS[1],
  },
  {
    title: 'Creating Conditions for Innovation',
    description:
      'We back experimentation and support entrepreneurs to develop locally relevant business models.',
    band: BANDS[2],
    imageBg: IMAGE_BGS[2],
    icon: ICONS[2],
  },
  {
    title: 'Enabling Digital Participation',
    description:
      'We grow trust in the digital world by strengthening safety, standards, and digital confidence on every atoll.',
    band: BANDS[3],
    imageBg: IMAGE_BGS[3],
    icon: ICONS[3],
  },
];

const pillars: PillarCard[] =
  block.pillars && block.pillars.length > 0
    ? block.pillars.map((p, i) => ({
        title: p.title,
        description: p.description ?? '',
        band: BANDS[i % BANDS.length],
        imageBg: IMAGE_BGS[i % IMAGE_BGS.length],
        icon: ICONS[i % ICONS.length],
      }))
    : defaults;
---

<section id="our-work" class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div data-reveal>
        <p class="mb-3 font-accent text-3xl leading-none text-slate-700">{block.eyebrow ?? 'Our Work'}</p>
        <h2 class="font-heading text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl">
          {
            block.title ? (
              block.title
            ) : (
              <Fragment>
                FOUR PILLARS,<br />ONE <span class="text-teal-700">ISLAND</span><br />ECOSYSTEM.
              </Fragment>
            )
          }
        </h2>
      </div>
      <p data-reveal data-reveal-delay="120" class="max-w-lg text-base text-slate-600 lg:pb-2">
        {
          block.description ??
            "We don't run isolated programmes. Each pillar is a different way of caring for the same outcome — communities that can author their own future, on their own atolls, in their own language."
        }
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => (
          <article
            data-reveal
            data-reveal-delay={i * 100}
            class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-teal-300 hover:shadow-2xl hover:shadow-slate-900/10"
          >
            <div
              class:list={[
                'relative aspect-[5/3] w-full overflow-hidden bg-gradient-to-br',
                p.imageBg,
              ]}
              aria-hidden="true"
            >
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.12),transparent_60%)] transition-transform duration-700 group-hover:scale-110" />
            </div>
            <div class:list={['flex flex-1 flex-col gap-3 p-5', p.band]}>
              <svg
                class="h-6 w-6"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
              </svg>
              <h3 class="font-heading text-sm font-bold uppercase tracking-wider">{p.title}</h3>
              <p class="text-sm leading-relaxed opacity-90">{p.description}</p>
              <a
                href={resolvePillarHref(p.title)}
                class="mt-auto inline-flex items-center gap-1 pt-2 text-xs font-bold uppercase tracking-wider hover:underline"
              >
                Read more
                <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
