---
import { getCollection } from 'astro:content';

interface PillarRef {
  documentId?: string;
  title: string;
  description?: string | null;
}

export interface PillarsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  pillars?: PillarRef[] | null;
}

interface Props {
  block: PillarsBlockData;
}

const { block } = Astro.props;

// Mirror the slug derivation used by the `pillars` content loader.
const slugify = (value: string) =>
  value
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/&/g, 'and')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const pillarEntries = await getCollection('pillars');
const pillarSlugByTitle = new Map(
  pillarEntries.map((entry) => [entry.data.title.trim().toLowerCase(), entry.data.slug]),
);

const resolvePillarHref = (title: string) => {
  const slug = pillarSlugByTitle.get(title.trim().toLowerCase()) ?? slugify(title);
  return slug ? `/pillars/${slug}` : '/#pillars';
};

const defaults: PillarRef[] = [
  {
    title: 'Empowering Leaders & Communities',
    description:
      'We strengthen local capability and leadership pathways so communities can lead change on their own terms.',
  },
  {
    title: 'Building Partnership for Impact',
    description:
      'We build trusted relationships with ministries, councils, and NGOs to coordinate and sustain investment.',
  },
  {
    title: 'Creating Conditions for Innovation',
    description:
      'We back experimentation and support entrepreneurs to develop locally relevant business models.',
  },
  {
    title: 'Enabling Digital Participation',
    description:
      'We grow trust in the digital world by strengthening safety, standards, and digital confidence on every atoll.',
  },
];

const pillars: PillarRef[] =
  block.pillars && block.pillars.length > 0 ? block.pillars : defaults;
---

<section id="our-work" class="bg-ek-paper py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        {block.eyebrow ?? 'Our work'}
      </span>
      <h2 class="mb-[18px] font-condensed text-4xl font-bold uppercase leading-[1.02] tracking-tight text-ek-800 sm:text-5xl">
        {block.title ?? 'Four pillars, one island ecosystem'}
      </h2>
      {
        block.description && <p class="text-lg text-ek-muted">{block.description}</p>
      }
    </div>

    <div class="grid gap-[22px] sm:grid-cols-2">
      {
        pillars.map((p, i) => (
          <article
            data-reveal
            data-reveal-delay={i * 100}
            class="group rounded-md border border-ek-sand bg-white px-7 py-[30px] transition-all duration-200 hover:-translate-y-1 hover:border-ek-olive/50 hover:shadow-[0_16px_38px_rgba(15,50,58,0.1)]"
          >
            <h3 class="mb-[10px] font-condensed text-2xl font-bold uppercase text-ek-800">
              {p.title}
            </h3>
            {p.description && <p class="mb-4 text-base text-ek-muted">{p.description}</p>}
            <a
              href={resolvePillarHref(p.title)}
              class="inline-flex items-center gap-1 font-condensed text-[0.82rem] font-semibold uppercase tracking-[0.14em] text-ek-olive transition-colors hover:text-ek-700"
            >
              Read more
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
