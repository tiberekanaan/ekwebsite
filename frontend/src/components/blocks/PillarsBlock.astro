---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { getCollection } from 'astro:content';

interface PillarRef {
  documentId?: string;
  title: string;
  description?: string | null;
}

export interface PillarsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  pillars?: PillarRef[] | null;
}

interface Props {
  block: PillarsBlockData;
}

const { block } = Astro.props;

// Mirror the slug derivation used by the `pillars` content loader.
const slugify = (value: string) =>
  value
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/&/g, 'and')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const pillarEntries = await getCollection('pillars');
const pillarSlugByTitle = new Map(
  pillarEntries.map((entry) => [entry.data.title.trim().toLowerCase(), entry.data.slug]),
);

const resolvePillarHref = (title: string) => {
  const slug = pillarSlugByTitle.get(title.trim().toLowerCase()) ?? slugify(title);
  return slug ? `/pillars/${slug}` : '/#pillars';
};

const defaults: PillarRef[] = [
  {
    title: 'Empowering Leaders & Communities',
    description:
      'We strengthen local capability and leadership pathways so communities can lead change on their own terms.',
  },
  {
    title: 'Building Partnership for Impact',
    description:
      'We build trusted relationships with ministries, councils, and NGOs to coordinate and sustain investment.',
  },
  {
    title: 'Creating Conditions for Innovation',
    description:
      'We back experimentation and support entrepreneurs to develop locally relevant business models.',
  },
  {
    title: 'Enabling Digital Participation',
    description:
      'We grow trust in the digital world by strengthening safety, standards, and digital confidence on every atoll.',
  },
];

const pillars: PillarRef[] =
  block.pillars && block.pillars.length > 0 ? block.pillars : defaults;

// Per-card accents drawn from the ek brand palette — top bar + number chip
// vary per card while the card body stays neutral on the paper background.
const accents = [
  { card: 'bg-white border-ek-700/10', bar: 'bg-ek-500', chip: 'bg-ek-500 text-white', title: 'text-ek-800' },
  { card: 'bg-white border-ek-700/10', bar: 'bg-ek-olive', chip: 'bg-ek-olive text-white', title: 'text-ek-800' },
  { card: 'bg-white border-ek-700/10', bar: 'bg-ek-lime', chip: 'bg-ek-lime text-ek-900', title: 'text-ek-800' },
  { card: 'bg-white border-ek-700/10', bar: 'bg-ek-700', chip: 'bg-ek-700 text-white', title: 'text-ek-800' },
];
---

<section id="our-work" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4">{block.eyebrow ?? 'Our work'}</Eyebrow>
      <h2 class="mb-[18px] font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Four pillars, one island ecosystem'}
      </h2>
      {
        block.description && <p class="text-lg text-ek-muted">{block.description}</p>
      }
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => {
          const accent = accents[i % accents.length];
          return (
            <article
              data-reveal
              data-reveal-delay={i * 100}
              class={`group flex h-full flex-col overflow-hidden rounded-2xl border ${accent.card} transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`}
            >
              <div class={`h-1.5 w-full ${accent.bar}`} aria-hidden="true" />
              <div class="flex flex-1 flex-col p-7">
                <span class={`mb-6 inline-flex h-11 w-11 items-center justify-center rounded-xl font-condensed text-base font-bold ${accent.chip}`}>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class={`mb-2.5 font-serif text-xl font-bold leading-snug ${accent.title}`}>
                  {p.title}
                </h3>
                {p.description && (
                  <p class="mb-6 line-clamp-3 text-[0.95rem] leading-relaxed text-slate-600">
                    {p.description}
                  </p>
                )}
                <a
                  href={resolvePillarHref(p.title)}
                  class="group/link mt-auto inline-flex items-center gap-1 text-sm font-bold uppercase tracking-wide text-slate-900"
                >
                  Read More
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover/link:translate-x-1">→</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
