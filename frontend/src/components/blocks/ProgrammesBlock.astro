---
interface ProgrammeItem {
  title: string;
  description?: string | null;
  partnerLine?: string | null;
  programmeStatus?: 'running' | 'completed' | null;
  statusYear?: string | null;
}

export interface ProgrammesBlockData {
  eyebrow?: string | null;
  title?: string | null;
  items?: ProgrammeItem[] | null;
  buttonText?: string | null;
  buttonLink?: string | null;
}

interface Props {
  block: ProgrammesBlockData;
}

const { block } = Astro.props;

const defaults: ProgrammeItem[] = [
  {
    title: 'American Spaces',
    description:
      'Youth workshops on vision, leadership, cybersafety and careers, at the Kiribati National Library and in secondary schools',
    partnerLine: 'with the U.S. Embassy Suva',
    programmeStatus: 'running',
  },
  {
    title: 'Empowering Community Leadership',
    description:
      'Two-day workshops in leadership, digital literacy and financial management, run for three separate groups of local leaders',
    partnerLine: 'with the New Zealand High Commission',
    programmeStatus: 'completed',
    statusYear: '2026',
  },
  {
    title: "Women's Economic Empowerment",
    description:
      "We facilitated the workshops that built a national framework with 19 women's organisations",
    partnerLine: 'convened by MWYSSA, funded by Caritas',
    programmeStatus: 'completed',
    statusYear: '2026',
  },
];

const programmes: ProgrammeItem[] = block.items && block.items.length > 0 ? block.items : defaults;

const pillLabel = (p: ProgrammeItem) =>
  p.programmeStatus === 'completed' ? `Completed${p.statusYear ? ` ${p.statusYear}` : ''}` : 'Running';

const buttonText = block.buttonText ?? 'All our work';
const buttonLink = block.buttonLink ?? '/our-programs';
---

<section id="our-work" class="bg-ek-paper py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        04 · {block.eyebrow ?? 'Our work'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'What we are running now'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
    </div>

    <div class="border-t border-ek-700/10">
      {
        programmes.map((p, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 100}
            class="grid items-center gap-3 border-b border-ek-700/10 py-7 md:grid-cols-[1fr_auto] md:gap-6"
          >
            <div>
              <h3 class="mb-2 font-serif text-2xl font-bold text-ek-800">{p.title}</h3>
              <p class="max-w-[52em] text-base text-ek-muted">
                {p.description}
                {p.partnerLine && (
                  <Fragment>
                    {' · '}
                    <b class="font-semibold text-ek-600">{p.partnerLine}</b>
                  </Fragment>
                )}
              </p>
            </div>
            <span
              class:list={[
                'justify-self-start whitespace-nowrap rounded-full px-[14px] py-1.5 font-condensed text-[0.76rem] font-semibold uppercase tracking-[0.14em] md:justify-self-end',
                p.programmeStatus === 'completed' ? 'bg-ek-sand text-ek-muted' : 'bg-ek-lime text-ek-900',
              ]}
            >
              {pillLabel(p)}
            </span>
          </div>
        ))
      }
    </div>

    <div class="mt-9" data-reveal>
      <a
        href={buttonLink}
        class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-ek-700/20 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-700 transition-colors duration-200 hover:border-ek-olive hover:text-ek-olive"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
