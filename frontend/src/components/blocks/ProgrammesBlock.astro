---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

interface ProgrammeItem {
  title: string;
  description?: string | null;
  partnerLine?: string | null;
  programmeStatus?: 'running' | 'completed' | null;
  statusYear?: string | null;
}

export interface ProgrammesBlockData {
  eyebrow?: string | null;
  title?: string | null;
  items?: ProgrammeItem[] | null;
  buttonText?: string | null;
  buttonLink?: string | null;
}

interface Props {
  block: ProgrammesBlockData;
}

const { block } = Astro.props;

const buttonText = block.buttonText ?? 'All our work';
const buttonLink = block.buttonLink ?? '/our-programs';

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// The four most recent projects, newest first (same ordering as
// /our-programs). The CMS `items` list is no longer the source — the row
// grows to four automatically as project entries are added.
const cards = (await getCollection('projects'))
  .sort((a, b) => {
    const aDate = a.data.publishedAt?.valueOf() ?? a.data.createdAt?.valueOf() ?? 0;
    const bDate = b.data.publishedAt?.valueOf() ?? b.data.createdAt?.valueOf() ?? 0;
    return bDate - aDate;
  })
  .slice(0, 4)
  .map((p) => ({
    title: p.data.title,
    href: `/our-programs/${p.data.slug}`,
    image: p.data.image ?? null,
  }));
---

<section id="our-work" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4">{block.eyebrow ?? 'Our work'}</Eyebrow>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Featured projects'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card, i) => (
          <a
            href={card.href}
            data-reveal
            data-reveal-delay={i * 100}
            class="group relative block overflow-hidden rounded-3xl shadow-[0_10px_30px_rgba(15,50,58,0.12)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_22px_50px_rgba(15,50,58,0.22)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-ek-mist focus-visible:ring-ek-500"
          >
            {card.image?.url ? (
              <img
                src={absoluteUrl(card.image.url)}
                alt={card.image.alternativeText ?? ''}
                loading="lazy"
                decoding="async"
                class="aspect-[16/11] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06] sm:aspect-[4/5]"
              />
            ) : (
              <span class="block aspect-[16/11] w-full bg-white sm:aspect-[4/5]" aria-hidden="true" />
            )}
            <span
              class="absolute inset-0 bg-gradient-to-t from-ek-900/95 via-ek-900/45 to-ek-900/5"
              aria-hidden="true"
            />
            <span
              class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white ring-1 ring-white/25 backdrop-blur-md transition-colors duration-300 group-hover:bg-ek-lime group-hover:text-ek-900 group-hover:ring-ek-lime"
              aria-hidden="true"
            >
              <svg
                class="h-4 w-4 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
            <span class="absolute inset-x-0 bottom-0 px-5 pb-8">
              <h3 class="font-serif text-[1.35rem] font-bold leading-tight text-white">{card.title}</h3>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-9" data-reveal>
      <a
        href={buttonLink}
        class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-ek-700/20 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-700 transition-colors duration-200 hover:border-ek-olive hover:text-ek-olive"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
