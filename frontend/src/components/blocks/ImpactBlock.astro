---
interface ImpactMetric {
  number: string;
  label: string;
  description?: string | null;
  badge?: string | null;
}

export interface ImpactBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  metrics?: ImpactMetric[] | null;
  note?: string | null;
  outcomes?: { text: string }[] | null;
  photos?: { url: string; alternativeText?: string | null }[] | null;
}

interface Props {
  block: ImpactBlockData;
}

const { block } = Astro.props;

// Delivery to date, deliberately rounded so the homepage does not need
// updating every month. Static figures: no count-up animation, precise
// numbers belong on programme pages with their dates attached.
const defaults: ImpactMetric[] = [
  { number: '5', label: 'Programmes delivered or under way' },
  { number: '40+', label: 'Workshops run since we began' },
  { number: '1,500+', label: 'People have attended one of them' },
  { number: '3', label: 'Funding partners backing our work' },
];

const stats: ImpactMetric[] =
  block.metrics && block.metrics.length > 0 ? block.metrics : defaults;

const note =
  block.note ??
  'All of this work has been on South Tarawa. Where we have a signed attendance register, we publish that number. Where a group was too large to count person by person, the figure we publish is lower than the number who were actually in the room.';
---

<section
  id="impact"
  class="bg-ek-900 bg-[radial-gradient(1000px_500px_at_80%_-10%,rgba(42,128,137,0.45),transparent_60%)] py-24 text-white"
>
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-lime-bright">
        02 · {block.eyebrow ?? 'Where we are'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text text-transparent">
        {block.title ?? 'We started in May 2024'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-[#cfe0db]">
        {block.description ?? 'We are a small organisation. This is what we have done so far.'}
      </p>
    </div>

    <div class="mb-11 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 100}
            class="rounded-2xl border-b-[3px] border-ek-lime bg-white/[0.06] px-6 py-7 ring-1 ring-white/10 transition-all duration-200 hover:-translate-y-1 hover:bg-white/10 hover:shadow-[0_12px_30px_rgba(174,203,58,0.15)]"
          >
            <div class="bg-gradient-to-br from-white to-ek-lime-bright bg-clip-text font-condensed text-5xl font-bold leading-none tracking-tight text-transparent">
              {s.number}
            </div>
            <div class="mt-2.5 text-[0.96rem] text-[#9fb9b4]">{s.label}</div>
          </div>
        ))
      }
    </div>

    <p
      class="max-w-[660px] border-l-2 border-ek-olive pl-[18px] text-base text-[#8fb0ab]"
      data-reveal
    >
      {note}
    </p>
  </div>
</section>
