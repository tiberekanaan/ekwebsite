---
interface ImpactMetric {
  number: string;
  label: string;
  description: string | null;
}

export interface ImpactBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  metrics?: ImpactMetric[] | null;
}

interface Props {
  block: ImpactBlockData;
}

interface Stat {
  badge: string;
  number: string;
  label: string;
}

const { block } = Astro.props;

// Dummy metrics for the design pass — replaced by CMS values once wired.
const defaults: Stat[] = [
  { badge: 'From 2026', number: '1,200+', label: 'People supported into stronger livelihoods and enterprise' },
  { badge: 'From 2026', number: '25', label: 'Communities reached through digital skills and safety' },
  { badge: 'From 2026', number: '150+', label: 'Local leaders developed through our programmes' },
  { badge: 'From 2026', number: '12', label: 'Active partnerships delivering work together' },
];

// The current CMS seed stores badge text ("From 2026") in `number`; only
// treat it as a countable stat when it actually starts with a digit.
const isStat = (v: string | null | undefined): v is string => !!v && /^\d/.test(v.trim());

const stats: Stat[] =
  block.metrics && block.metrics.length > 0
    ? block.metrics.map((m, i) => ({
        badge: 'From 2026',
        number: isStat(m.number) ? m.number.trim() : defaults[i % defaults.length].number,
        label: m.label,
      }))
    : defaults;

// Qualitative outcomes we hold ourselves to (decorative checklist).
const track = [
  'More people confident and safe using digital tools — and fewer left out.',
  'Leadership and skills that no longer depend on any single person.',
  'Real co-design and shared investment with partners — a sign of trust.',
  'Local practices that communities carry on themselves.',
];
---

<section id="impact" class="bg-ek-sand py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        03 · {block.eyebrow ?? 'The harvest'}
      </span>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'The change we’re growing'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {
          block.description ??
            'We measure real change, not just activity. As our programmes take root from 2026 onward, this is the evidence we hold ourselves to.'
        }
      </p>
    </div>

    <p
      class="mb-12 max-w-[780px] font-condensed text-2xl font-semibold uppercase leading-[1.15] text-ek-800 sm:text-3xl"
      data-reveal
    >
      Our aim is for communities to know us not as a one-off service, but as a{' '}
      <mark class="bg-ek-lime/40 px-1 text-ek-800">lasting partner for change</mark>.
    </p>

    <div class="mb-12 grid gap-[18px] sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 100}
            class="rounded-2xl border-b-[3px] border-ek-lime bg-white px-6 py-7 transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_12px_30px_rgba(15,50,58,0.08)]"
          >
            <span class="mb-1.5 inline-block rounded-[3px] bg-ek-olive/10 px-2 py-[3px] font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-ek-olive">
              {s.badge}
            </span>
            <div
              class="mt-3 bg-gradient-to-r from-ek-600 to-ek-olive bg-clip-text font-condensed text-5xl font-bold leading-none tracking-tight text-transparent"
              data-countup
              data-target={s.number}
            >
              {s.number}
            </div>
            <div class="mt-2.5 text-[0.96rem] text-ek-muted">{s.label}</div>
          </div>
        ))
      }
    </div>

    <div class="grid max-w-[880px] gap-x-9 gap-y-[14px] sm:grid-cols-2" data-reveal>
      {
        track.map((t) => (
          <div class="flex gap-3 text-[1.02rem] text-ek-ink">
            <svg
              class="mt-[3px] h-[22px] w-[22px] flex-none text-ek-olive"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M20 6L9 17l-5-5" />
            </svg>
            <span>{t}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
