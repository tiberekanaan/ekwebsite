---
import { Image } from 'astro:assets';
// Real photo, pre-cropped 4:5 and graded to the ek palette — regenerate via
// sharp (1200x1500, teal soft-light overlay) if the source photo changes.
import heroPhoto from '@/assets/images/hero-photo.jpg';
import { STRAPI_URL } from 'astro:env/server';

export interface HeroBlockData {
  /** Still in the CMS payload; no longer rendered. */
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  /** Still in the CMS payload; no longer rendered — the bwabwai narrative lives on the About page. */
  heritage?: string | null;
  primaryButtonText?: string | null;
  primaryButtonLink?: string | null;
  secondaryButtonText?: string | null;
  secondaryButtonLink?: string | null;
  /** Replaces the bundled (pre-graded) hero photo when set. */
  photo?: { url: string; alternativeText?: string | null } | null;
  /** Still in the CMS payload; no longer rendered. */
  photoLabel?: string | null;
}

interface Props {
  block: HeroBlockData;
}

const { block } = Astro.props;

const lede =
  block.description ??
  'Empower Kiribati is a platform for community initiatives. We partner with ministries, funders and community organisations to design, deliver and measure work that cultivates the conditions for a resilient Kiribati.';
const primaryText = block.primaryButtonText ?? 'See our work';
const primaryLink = block.primaryButtonLink ?? '#our-work';
const secondaryText = block.secondaryButtonText ?? 'Partner with us';
const secondaryLink = block.secondaryButtonLink ?? '/contact';
const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
const cmsPhoto = block.photo?.url
  ? { src: absoluteUrl(block.photo.url), alt: block.photo.alternativeText ?? '' }
  : null;
const bundledAlt = 'Children laughing together in a game under the roof of a maneaba in Kiribati';
// `*text*` in the CMS title renders as the lime emphasis (CloseBlock pattern);
// the fallback is the brief's headline with the same emphasis.
const titleParts = (block.title || '*Thriving, resilient* futures').split(/\*([^*]+)\*/g);
---

<!--
  Full-bleed photo hero under one even ek-900 overlay (no fades). The overlay
  is strong enough that white body text keeps 4.5:1 and the lime headline
  emphasis 3:1 even over the brightest pixels in the photo (white shirts).
-->
<section id="top" class="relative flex min-h-svh flex-col overflow-hidden bg-ek-900 text-white">
  <div class="absolute inset-0 overflow-hidden">
    {
      cmsPhoto ? (
        <img
          src={cmsPhoto.src}
          alt={cmsPhoto.alt}
          class="hero-photo-drift absolute inset-0 h-full w-full object-cover object-[50%_65%]"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <Image
          src={heroPhoto}
          alt={bundledAlt}
          widths={[600, 1000, 1200]}
          sizes="100vw"
          class="hero-photo-drift absolute inset-0 h-full w-full object-cover object-[50%_65%]"
          loading="eager"
        />
      )
    }
    <div class="absolute inset-0 bg-ek-900/70" aria-hidden="true"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-1 items-center px-7 pt-32 pb-20 lg:pb-24">
    <div class="max-w-[40rem]">
      <h1 data-reveal class="mb-6 font-serif text-5xl font-bold leading-[1.04] text-white sm:text-6xl lg:text-7xl">
        {
          titleParts.map((part, i) =>
            i % 2 === 1 ? <em class="not-italic text-ek-lime-bright">{part}</em> : part,
          )
        }
      </h1>

      <p data-reveal data-reveal-delay="80" class="mb-9 max-w-[30em] text-lg text-white">
        {lede}
      </p>

      <div data-reveal data-reveal-delay="160" class="flex flex-wrap items-center gap-4">
        <a
          href={primaryLink}
          class="inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
        >
          {primaryText}
        </a>
        <a
          href={secondaryLink}
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-white/50 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-white transition-colors duration-200 hover:border-ek-lime-bright hover:text-ek-lime-bright"
        >
          {secondaryText}
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* A slow drift instead of a static crop — barely perceptible, but the hero
     photo reads as a moment rather than a poster. */
  .hero-photo-drift {
    animation: ek-hero-drift 24s ease-in-out infinite alternate;
  }

  @keyframes ek-hero-drift {
    from {
      transform: scale(1.02) translateX(0);
    }
    to {
      transform: scale(1.1) translateX(-1.5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-drift {
      animation: none;
    }
  }
</style>
