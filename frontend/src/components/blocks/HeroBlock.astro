---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { Image } from 'astro:assets';
// Real photo, pre-cropped 4:5 and graded to the ek palette — regenerate via
// sharp (1200x1500, teal soft-light overlay) if the source photo changes.
import heroPhoto from '@/assets/images/hero-photo.jpg';

export interface HeroBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  /** Still in the CMS payload; no longer rendered — the bwabwai narrative lives on the About page. */
  heritage?: string | null;
  primaryButtonText?: string | null;
  primaryButtonLink?: string | null;
  secondaryButtonText?: string | null;
  secondaryButtonLink?: string | null;
}

interface Props {
  block: HeroBlockData;
}

const { block } = Astro.props;

const eyebrow = block.eyebrow ?? 'A locally-led NGO · South Tarawa, Kiribati';
const lede =
  block.description ??
  'Empower Kiribati is a platform for community initiatives. We partner with ministries, funders and community organisations to design, deliver and measure work that cultivates the conditions for a resilient Kiribati.';
const primaryText = block.primaryButtonText ?? 'See our work';
const primaryLink = block.primaryButtonLink ?? '#our-work';
const secondaryText = block.secondaryButtonText ?? 'Partner with us';
const secondaryLink = block.secondaryButtonLink ?? '/contact';
---

<section
  id="top"
  class="relative flex min-h-svh flex-col overflow-hidden bg-ek-900 bg-[radial-gradient(1200px_600px_at_75%_-10%,rgba(42,128,137,0.55),transparent_60%),linear-gradient(160deg,var(--color-ek-800)_0%,var(--color-ek-900)_70%)] text-white"
>
  <svg
    class="pointer-events-none absolute -top-[6%] right-[-8%] z-0 w-[600px] opacity-[0.06]"
    viewBox="0 0 200 200"
    aria-hidden="true"
  >
    <path d="M100 20c-25 0-45 20-45 50s20 60 45 60 45-30 45-60-20-50-45-50z" fill="#aecb3a" />
  </svg>

  <div
    class="absolute inset-y-0 right-0 z-[1] hidden w-1/2 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_45%)] lg:block"
    data-reveal
  >
    <Image
      src={heroPhoto}
      alt="Children laughing together in a game under the roof of a maneaba in Kiribati"
      widths={[700, 1000, 1200]}
      sizes="50vw"
      class="hero-photo-drift h-full w-full object-cover"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-ek-900/70 via-ek-900/15 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-ek-900/80 via-ek-900/30 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ek-900/70 to-transparent"
      aria-hidden="true"
    >
    </div>
    <p
      class="absolute bottom-8 right-8 inline-flex items-center gap-2 rounded-full bg-ek-900/55 px-4 py-2 font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-white/90 ring-1 ring-white/20 backdrop-blur-md"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-ek-lime" aria-hidden="true"></span>
      South Tarawa · Kiribati
    </p>
  </div>

  <div class="relative z-[2] mx-auto grid w-full max-w-6xl flex-1 items-center gap-10 px-7 pt-28 pb-8 lg:grid-cols-[1.1fr_0.8fr] lg:pt-32">
    <div>
      <Eyebrow class="mb-5" tone="dark" data-reveal>{eyebrow}</Eyebrow>

      <h1
        data-reveal
        data-reveal-delay="80"
        class="mb-6 bg-gradient-to-br from-white via-white to-ek-lime-bright bg-clip-text font-serif text-5xl font-bold leading-[1.06] text-transparent sm:text-6xl lg:text-7xl"
      >
        {
          block.title ? (
            block.title
          ) : (
            <Fragment>
              <em class="not-italic text-ek-lime-bright">Thriving, resilient</em> futures
            </Fragment>
          )
        }
      </h1>

      <p data-reveal data-reveal-delay="160" class="mb-9 max-w-[30em] text-lg text-[#cfe0db]">
        {lede}
      </p>

      <div data-reveal data-reveal-delay="240" class="flex flex-wrap items-center gap-4">
        <a
          href={primaryLink}
          class="inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
        >
          {primaryText}
        </a>
        <a
          href={secondaryLink}
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-white/35 px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-white transition-colors duration-200 hover:border-ek-lime-bright hover:text-ek-lime-bright"
        >
          {secondaryText}
        </a>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-2xl ring-1 ring-white/15 lg:hidden" data-reveal data-reveal-delay="200">
      <Image
        src={heroPhoto}
        alt="Children laughing together in a game under the roof of a maneaba in Kiribati"
        widths={[400, 800]}
        sizes="100vw"
        class="aspect-[16/10] h-auto w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ek-900/60 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>

</section>

<style is:global>
  /* A slow drift instead of a static crop — barely perceptible, but the hero
     photo reads as a moment rather than a poster. */
  .hero-photo-drift {
    animation: ek-hero-drift 24s ease-in-out infinite alternate;
  }

  @keyframes ek-hero-drift {
    from {
      transform: scale(1.02) translateX(0);
    }
    to {
      transform: scale(1.1) translateX(-1.5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-drift {
      animation: none;
    }
  }
</style>
