---
import Eyebrow from '@/components/empower/Eyebrow.astro';
interface ValueItem {
  title: string;
  description: string | null;
}

interface FutureStat {
  value: string;
  label: string | null;
}

export interface FutureBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  buttonText?: string | null;
  buttonLink?: string | null;
  values?: ValueItem[] | null;
  stats?: FutureStat[] | null;
}

interface Props {
  block: FutureBlockData;
}

const { block } = Astro.props;

// 2026–2030 roadmap phases (editorial, not per-entry CMS data).
const timeline = [
  {
    year: '2026',
    phase: 'Establish foundations',
    text: 'Set up leadership, engage key partners, and pilot our first programmes.',
  },
  {
    year: '2027',
    phase: 'Develop capability',
    text: 'Build delivery capability, expand programmes, and strengthen partnerships.',
  },
  {
    year: '2028',
    phase: 'Integrate learning',
    text: 'Put learning systems and shared platforms in place across our work.',
  },
  {
    year: '2029',
    phase: 'Strengthen & scale',
    text: 'Scale our most effective programmes and extend partnership reach.',
  },
  {
    year: '2030',
    phase: 'Sustain & evolve',
    text: 'Build continuity, support self-sustaining enterprise, and keep adapting.',
  },
];

const buttonText = block.buttonText ?? 'Support our work';
const buttonLink = block.buttonLink ?? '/contact';
---

<section id="future" class="bg-gradient-to-b from-ek-900 to-ek-800 py-24 text-white">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4" tone="dark">{block.eyebrow ?? 'The road ahead'}</Eyebrow>
      <h2 class="mb-4 bg-gradient-to-r from-white to-ek-lime-bright bg-clip-text font-serif text-4xl font-bold leading-[1.08] text-transparent sm:text-5xl">
        {block.title ?? 'Where we’re heading'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-[#b9cdc8]">
        {
          block.description ??
            'Our plan runs from 2026 to 2030 — moving from strong foundations to programmes that sustain themselves.'
        }
      </p>
    </div>

    <div class="relative mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div
        class="absolute left-[4%] right-[4%] top-[46px] hidden h-0.5 bg-gradient-to-r from-ek-olive to-ek-lime-bright lg:block"
        aria-hidden="true"
      >
      </div>
      {
        timeline.map((t, i) => (
          <div class="relative" data-reveal data-reveal-delay={i * 100}>
            <div class="font-condensed text-2xl font-bold text-ek-lime-bright">{t.year}</div>
            <div class="relative z-[2] my-[14px] mb-[18px] h-4 w-4 rounded-full border-[3px] border-ek-900 bg-ek-lime" />
            <div class="mb-2 font-condensed text-[1.02rem] font-semibold uppercase tracking-[0.04em]">
              {t.phase}
            </div>
            <p class="text-[0.92rem] text-[#b9cdc8]">{t.text}</p>
          </div>
        ))
      }
    </div>

    <div
      id="support"
      class="mt-[60px] flex flex-wrap items-center justify-between gap-[30px] border-t border-ek-lime/20 pt-10"
      data-reveal
    >
      <p class="max-w-[18em] bg-gradient-to-r from-white to-ek-lime-bright bg-clip-text font-condensed text-2xl font-semibold uppercase leading-[1.1] text-transparent sm:text-3xl">
        Together, we can grow a stronger, more resilient future for Kiribati.
      </p>
      <a
        href={buttonLink}
        class="inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
