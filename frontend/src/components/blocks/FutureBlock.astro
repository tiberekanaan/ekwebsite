---
interface ValueItem {
  title: string;
  description: string | null;
}

interface FutureStat {
  value: string;
  label: string | null;
}

export interface FutureBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  buttonText?: string | null;
  buttonLink?: string | null;
  values?: ValueItem[] | null;
  stats?: FutureStat[] | null;
}

interface Props {
  block: FutureBlockData;
}

interface Value {
  icon: string;
  title: string;
  description: string;
}

const { block } = Astro.props;

// Icons cycle per value; CMS supplies only title/description.
const ICONS = [
  'M12 2 9 7l-5 .7 3.6 3.6L6.8 17 12 14.3 17.2 17l-.8-5.7L20 7.7 15 7Z',
  'M3 12h18M12 3v18',
  'M5 12c0-3 2-5 5-5s5 2 5 5-2 5-5 5-5-2-5-5Zm14 0c0 3-2 5-5 5',
  'M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z',
];

const defaultValues: Value[] = [
  {
    icon: ICONS[0],
    title: 'Resilience',
    description: 'Climate-adaptive strategies in every community we work with.',
  },
  {
    icon: ICONS[1],
    title: 'Opportunity',
    description: 'Thriving local entrepreneurs and new island-based markets.',
  },
  {
    icon: ICONS[2],
    title: 'Sustaining',
    description: 'An ecosystem that grows independently of any single donor.',
  },
  {
    icon: ICONS[3],
    title: 'Digital Trust',
    description: 'Safe and confident digital participation for every atoll.',
  },
];

const values: Value[] =
  block.values && block.values.length > 0
    ? block.values.map((v, i) => ({
        icon: ICONS[i % ICONS.length],
        title: v.title,
        description: v.description ?? '',
      }))
    : defaultValues;

const defaultStats = [
  { value: '2030', label: 'HORIZON' },
  { value: '52', label: 'COMMUNITIES' },
  { value: '$4.2M', label: 'MOBILISED' },
];

const stats =
  block.stats && block.stats.length > 0
    ? block.stats.map((s) => ({ value: s.value, label: s.label ?? '' }))
    : defaultStats;

const buttonText = block.buttonText ?? 'Read the 2030 strategy';
const buttonLink = block.buttonLink ?? '/strategy-2026-2030';
---

<section id="future" class="bg-white">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
    <div data-reveal>
      <p class="mb-3 font-accent text-3xl leading-none text-teal-700">{block.eyebrow ?? 'The Future'}</p>

      <h2
        class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
      >
        {
          block.title ? (
            block.title
          ) : (
            <Fragment>
              WE ARE <span class="text-teal-700">BUILDING</span><br />TOGETHER.
            </Fragment>
          )
        }
      </h2>

      <p class="mt-6 max-w-xl text-base text-slate-600">
        {
          block.description ??
            'By 2030, our goal is a self-sustaining ecosystem where digital trust and economic opportunity reach every citizen of Kiribati — built by I-Kiribati, for I-Kiribati.'
        }
      </p>

      <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
        {
          values.map((v, i) => (
            <div data-reveal data-reveal-delay={i * 100} class="group flex flex-col gap-2">
              <svg
                class="h-6 w-6 text-teal-700 transition-transform duration-500 group-hover:scale-125 group-hover:-rotate-6"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={v.icon} />
              </svg>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">{v.title}</h3>
              <p class="text-sm text-slate-600">{v.description}</p>
            </div>
          ))
        }
      </div>

      <a
        href={buttonLink}
        class="group mt-10 inline-flex items-center gap-2 rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-xl hover:shadow-slate-900/30"
      >
        {buttonText}
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="relative" data-reveal data-reveal-delay="150">
      <div
        class="group relative aspect-[4/5] w-full overflow-hidden rounded-2xl bg-gradient-to-br from-slate-700 via-slate-600 to-slate-800 shadow-xl transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl sm:aspect-[5/4] lg:aspect-[4/5]"
        role="img"
        aria-label="Aerial view of a Kiribati island"
      >
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.15),transparent_60%)] transition-transform duration-700 group-hover:scale-110"
        >
        </div>

        <div class="absolute inset-x-4 bottom-4 grid grid-cols-3 gap-2 sm:inset-x-6 sm:bottom-6 sm:gap-3">
          {
            stats.map((s) => (
              <div class="rounded-lg bg-slate-900/70 px-3 py-3 text-white backdrop-blur-sm transition-all duration-300 hover:bg-slate-900/90 hover:-translate-y-0.5 sm:px-4">
                <div class="text-xl font-extrabold sm:text-2xl">{s.value}</div>
                <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-300 sm:text-xs">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
