---
import { STRAPI_URL } from 'astro:env/server';

interface PartnerLogo {
  name: string;
  logo?: { url: string; alternativeText?: string | null } | null;
}

export interface PartnersBlockData {
  eyebrow?: string | null;
  title?: string | null;
  allPartnersLink?: string | null;
  logos?: PartnerLogo[] | null;
}

interface Props {
  block: PartnersBlockData;
}

const { block } = Astro.props;
const logos = block.logos ?? [];

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// Partner categories are editorial (not per-logo); kept as static copy.
const categories = [
  {
    title: 'Government ministries',
    text: 'Designing and delivering programmes aligned to national priorities.',
  },
  {
    title: 'Communities',
    text: 'Working directly with the people we serve, so programmes are owned locally.',
  },
  {
    title: 'Funders & donors',
    text: 'Long-term relationships supporting multi-year, mission-aligned work.',
  },
  {
    title: 'Networks & allies',
    text: 'Wider networks that extend our reach and lift standards across the sector.',
  },
];
---

<section id="partners" class="border-t border-ek-sand bg-white py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        {block.eyebrow ?? 'Stronger together'}
      </span>
      <h2 class="mb-[18px] font-condensed text-4xl font-bold uppercase leading-[1.02] tracking-tight text-ek-800 sm:text-5xl">
        {block.title ?? 'Who we work with'}
      </h2>
      <p class="text-lg text-ek-muted">
        We don’t work alone. We build trusted relationships that bring coordination, shared
        investment, and greater reach — so our work can grow and last.
      </p>
    </div>

    <div class="mb-[50px] grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 100}
            class="rounded-md border border-ek-sand bg-ek-paper px-6 py-7"
          >
            <h3 class="mb-[10px] font-condensed text-xl font-bold uppercase text-ek-700">
              {c.title}
            </h3>
            <p class="text-[0.96rem] text-ek-muted">{c.text}</p>
          </div>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-4" data-reveal>
      {
        (logos.length > 0 ? logos : Array.from({ length: 5 }, () => null)).map((p) => {
          const logo = p?.logo?.url ? absoluteUrl(p.logo.url) : null;
          return (
            <div class="flex h-16 min-w-[120px] flex-1 items-center justify-center rounded-md border border-dashed border-ek-sand bg-ek-paper px-4 text-[0.82rem] text-[#b6ac95]">
              {logo ? (
                <img
                  src={logo}
                  alt={p?.logo?.alternativeText ?? p?.name ?? 'Partner logo'}
                  class="max-h-12 max-w-full object-contain"
                  loading="lazy"
                />
              ) : (
                <span class="text-center">{p?.name ?? 'Partner logo'}</span>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
