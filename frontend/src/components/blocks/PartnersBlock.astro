---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

interface PartnerLogo {
  name: string;
  logo?: { url: string; alternativeText?: string | null } | null;
  href?: string;
}

interface PartnerCategory {
  title: string;
  text?: string | null;
}

export interface PartnersBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  allPartnersLink?: string | null;
  allPartnersLabel?: string | null;
  categories?: PartnerCategory[] | null;
  logos?: PartnerLogo[] | null;
}

interface Props {
  block: PartnersBlockData;
}

const { block } = Astro.props;
const logos = block.logos ?? [];

// Track is duplicated so the -50% translate loops seamlessly.
const marqueeSets = [false, true];

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

// Real partners from the Partner collection (same source as /our-partners),
// alphabetical. The block's own `logos` list, when filled, overrides it.
const partnerEntries = await getCollection('partners');
const collectionLogos: PartnerLogo[] = partnerEntries
  .map((p) => ({ name: p.data.name, logo: p.data.logo ?? null, href: `/our-partners/${p.id}` }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Fictional wordmarks, shown only while no partners exist in the CMS at all.
const dummyLogos: PartnerLogo[] = [
  { name: 'Te Mauri Trust' },
  { name: 'Pacific Skills Alliance' },
  { name: 'Island Futures Fund' },
  { name: 'Kiribati Digital Network' },
  { name: 'Reef & Root Foundation' },
];

const marqueeLogos =
  logos.length > 0 ? logos : collectionLogos.length > 0 ? collectionLogos : dummyLogos;

// Below this many partners, repeating the set to fill a scrolling marquee
// reads as padding (2 real partners repeated to look like a dozen) — show a
// plain static row instead until there are enough for the loop to be honest.
const MARQUEE_MIN = 6;
const useMarquee = marqueeLogos.length >= MARQUEE_MIN;
const repeats = useMarquee ? Math.max(1, Math.ceil(8 / marqueeLogos.length)) : 1;
const marqueeItems = Array.from({ length: repeats }, () => marqueeLogos).flat();
const trackSets = useMarquee ? marqueeSets : [false];

// Defaults until edited on the Partners block in Strapi.
const defaultCategories: PartnerCategory[] = [
  {
    title: 'Government ministries',
    text: 'Designing and delivering programmes aligned to national priorities.',
  },
  {
    title: 'Communities',
    text: 'Working directly with the people we serve, so programmes are owned locally.',
  },
  {
    title: 'Funders & donors',
    text: 'Long-term relationships supporting multi-year, mission-aligned work.',
  },
  {
    title: 'Networks & allies',
    text: 'Wider networks that extend our reach and lift standards across the sector.',
  },
];

const categories: PartnerCategory[] =
  block.categories && block.categories.length > 0 ? block.categories : defaultCategories;
---

<section id="partners" class="border-t border-ek-700/10 bg-white py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <Eyebrow as="span" class="mb-4">{block.eyebrow ?? 'Stronger together'}</Eyebrow>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] sm:text-5xl bg-gradient-to-r from-ek-800 to-ek-500 bg-clip-text text-transparent">
        {block.title ?? 'Who we work with'}
      </h2>
      <span class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500" aria-hidden="true"></span>
      <p class="text-lg text-ek-muted">
        {
          block.description ??
            'We don’t work alone. We build trusted relationships that bring coordination, shared investment, and greater reach — so our work can grow and last.'
        }
      </p>
      {
        block.allPartnersLink && (
          <a
            href={block.allPartnersLink}
            class="mt-5 inline-flex items-center gap-2 font-condensed text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-ek-600 transition-colors duration-200 hover:text-ek-olive"
          >
            {block.allPartnersLabel ?? 'All partners'}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <div class="mb-[50px] grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 100}
            class="rounded-2xl border border-ek-700/10 bg-ek-mist/60 px-6 py-7 transition-all duration-200 hover:-translate-y-1 hover:border-ek-500/40 hover:shadow-[0_12px_30px_rgba(15,50,58,0.08)]"
          >
            <h3 class="mb-[10px] font-serif text-xl font-bold text-ek-700">
              {c.title}
            </h3>
            <p class="text-[0.96rem] text-ek-muted">{c.text}</p>
          </div>
        ))
      }
    </div>

    <div
      data-reveal
      class:list={[
        'relative overflow-hidden',
        useMarquee && '[mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]',
      ]}
    >
      <div
        class:list={[
          'flex items-center gap-4',
          useMarquee ? 'w-max animate-partner-marquee' : 'w-full flex-wrap justify-center',
        ]}
      >
        {
          trackSets.map((isDuplicate) => (
            <div class="flex shrink-0 items-center gap-4 pr-4" aria-hidden={isDuplicate || undefined}>
              {marqueeItems.map((p) => {
                const logo = p.logo?.url ? absoluteUrl(p.logo.url) : null;
                const Chip = p.href ? 'a' : 'div';
                return (
                  <Chip
                    href={p.href}
                    aria-label={p.href ? p.name : undefined}
                    tabindex={p.href && isDuplicate ? -1 : undefined}
                    class="flex h-16 w-44 shrink-0 items-center justify-center rounded-md border border-ek-700/10 bg-ek-mist/60 px-5 transition-colors duration-200 hover:border-ek-500/40"
                  >
                    {logo ? (
                      <img
                        src={logo}
                        alt={p.logo?.alternativeText ?? p.name}
                        class="max-h-12 max-w-full object-contain grayscale transition-[filter] duration-200 hover:grayscale-0"
                        loading="lazy"
                      />
                    ) : (
                      <span class="text-center font-condensed text-[0.92rem] font-bold uppercase leading-tight tracking-[0.08em] text-ek-600">
                        {p.name}
                      </span>
                    )}
                  </Chip>
                );
              })}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes partner-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-partner-marquee {
    animation: partner-marquee 30s linear infinite;
  }

  .animate-partner-marquee:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-partner-marquee {
      animation: none;
    }
  }
</style>
