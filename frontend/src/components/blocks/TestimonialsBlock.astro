---
import { STRAPI_URL } from 'astro:env/server';

interface TestimonialRef {
  quote: string;
  author: string;
  role?: string | null;
  image?: { url: string; alternativeText?: string | null } | null;
}

export interface TestimonialsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  testimonials?: TestimonialRef[] | null;
}

interface Props {
  block: TestimonialsBlockData;
}

interface Voice {
  quote: string;
  name: string;
  role: string;
  image: { url: string; alternativeText?: string | null } | null;
  placeholder: boolean;
}

const { block } = Astro.props;

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

const defaults: Voice[] = [
  {
    quote: 'A real change in a participant’s words — a new skill, income, or confidence gained.',
    name: 'Community participant',
    role: 'Name · island',
    image: null,
    placeholder: true,
  },
  {
    quote: 'A partner’s words on working with us — reliability, alignment, and shared value.',
    name: 'Partner / ministry',
    role: 'Name · role',
    image: null,
    placeholder: true,
  },
  {
    quote:
      'A local leader’s words on growth, ownership, and leading change in their community.',
    name: 'Local leader',
    role: 'Name · programme',
    image: null,
    placeholder: true,
  },
];

const voices: Voice[] =
  block.testimonials && block.testimonials.length > 0
    ? block.testimonials.map((t) => ({
        quote: t.quote,
        name: t.author,
        role: t.role ?? '',
        image: t.image ?? null,
        placeholder: false,
      }))
    : defaults;
---

<section id="voices" class="bg-ek-paper py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-14 max-w-[640px]" data-reveal>
      <span class="mb-4 inline-block font-condensed text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-ek-olive">
        {block.eyebrow ?? 'In their words'}
      </span>
      <h2 class="mb-[18px] font-condensed text-4xl font-bold uppercase leading-[1.02] tracking-tight text-ek-800 sm:text-5xl">
        {block.title ?? 'Voices from our communities'}
      </h2>
      <p class="text-lg text-ek-muted">
        The best measure of our work is what people say about it. These voices will be drawn from
        the communities, partners, and leaders we work alongside.
      </p>
    </div>

    <div class="grid gap-[22px] md:grid-cols-3">
      {
        voices.map((v, i) => {
          const imgUrl = v.image?.url ? absoluteUrl(v.image.url) : null;
          return (
            <article
              data-reveal
              data-reveal-delay={i * 100}
              class="rounded-md border border-ek-sand bg-white px-7 py-[30px]"
            >
              <p class="mb-[22px] text-[1.05rem] text-ek-ink">
                <span class="mr-1 font-condensed text-5xl leading-[0] text-ek-lime align-middle" aria-hidden="true">
                  “
                </span>
                {v.quote}
              </p>
              <div class="flex items-center gap-3 border-t border-ek-sand pt-4">
                {imgUrl ? (
                  <img
                    src={imgUrl}
                    alt={v.image?.alternativeText ?? v.name}
                    class="h-[42px] w-[42px] flex-none rounded-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-[42px] w-[42px] flex-none items-center justify-center rounded-full bg-ek-sand text-ek-600">
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="8" r="4" />
                      <path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1" />
                    </svg>
                  </div>
                )}
                <div>
                  <div class="font-condensed text-[0.95rem] font-semibold uppercase tracking-[0.04em] text-ek-800">
                    {v.name}
                  </div>
                  {v.role && <div class="text-[0.85rem] text-ek-muted">{v.role}</div>}
                </div>
              </div>
              {v.placeholder && (
                <p class="mt-[14px] text-[0.85rem] italic text-ek-olive">To be added once gathered</p>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>
