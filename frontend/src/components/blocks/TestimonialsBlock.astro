---
import { STRAPI_URL } from 'astro:env/server';

interface TestimonialRef {
  quote: string;
  author: string;
  role?: string | null;
  image?: { url: string; alternativeText?: string | null } | null;
}

export interface TestimonialsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  testimonials?: TestimonialRef[] | null;
}

interface Props {
  block: TestimonialsBlockData;
}

const { block } = Astro.props;
const testimonials = block.testimonials ?? [];

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<section id="testimonials" class="bg-slate-900 text-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div data-reveal>
        <p class="mb-2 font-accent text-3xl leading-none text-lime-300">{block.eyebrow ?? 'Testimonials'}</p>
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          {
            block.title ? (
              block.title
            ) : (
              <Fragment>
                Voices from <span class="text-lime-300">the atolls</span>.
              </Fragment>
            )
          }
        </h2>
      </div>
      {
        testimonials.length > 1 && (
          <div class="flex items-center gap-2" data-reveal data-reveal-delay="120">
            <button
              type="button"
              data-testimonial-prev
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 text-slate-200 transition-colors hover:bg-slate-800"
              aria-label="Previous testimonial"
            >
              <span aria-hidden="true">←</span>
            </button>
            <button
              type="button"
              data-testimonial-next
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 text-slate-200 transition-colors hover:bg-slate-800"
              aria-label="Next testimonial"
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        )
      }
    </div>

    {
      testimonials.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-700 px-6 py-12 text-center text-sm text-slate-400">
          Testimonials will appear here once they are published in Strapi.
        </div>
      ) : (
        <div
          class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-800/40"
          data-testimonial-carousel
          data-reveal
        >
          <ul class="flex transition-transform duration-500 ease-out" data-testimonial-track>
            {testimonials.map((t) => {
              const imgUrl = t.image?.url ? absoluteUrl(t.image.url) : null;
              return (
                <li class="w-full flex-shrink-0 px-6 py-10 sm:px-12 sm:py-14">
                  <div class="grid items-center gap-8 md:grid-cols-[auto_1fr]">
                    <div class="flex justify-center md:justify-start">
                      {imgUrl ? (
                        <img
                          src={imgUrl}
                          alt={t.image?.alternativeText ?? t.author}
                          class="h-24 w-24 rounded-full border-2 border-lime-300/40 object-cover transition-all duration-500 hover:scale-105 hover:border-lime-300/80 hover:shadow-xl hover:shadow-lime-300/20 sm:h-28 sm:w-28"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-teal-700 to-slate-700 text-xl font-bold text-white transition-transform duration-500 hover:scale-105 sm:h-28 sm:w-28">
                          {initials(t.author)}
                        </div>
                      )}
                    </div>

                    <div>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="mb-4 h-8 w-8 text-lime-300"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.17V11.83H5.5c0-1.83 1.5-3.33 3.33-3.33V6H7.17Zm10 0A5.17 5.17 0 0 0 12 11.17V18h6.17V11.83H15.5c0-1.83 1.5-3.33 3.33-3.33V6h-1.66Z" />
                      </svg>
                      <blockquote class="text-lg leading-relaxed text-slate-100 sm:text-xl">
                        {t.quote}
                      </blockquote>
                      <footer class="mt-6">
                        <div class="text-sm font-bold uppercase tracking-wider text-white">
                          {t.author}
                        </div>
                        {t.role && (
                          <div class="text-xs uppercase tracking-widest text-teal-300">
                            {t.role}
                          </div>
                        )}
                      </footer>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>

          {testimonials.length > 1 && (
            <div
              class="flex justify-center gap-2 pb-6"
              data-testimonial-dots
              aria-label="Carousel pagination"
            >
              {testimonials.map((_, i) => (
                <button
                  type="button"
                  data-index={i}
                  class:list={[
                    'h-2 w-2 rounded-full transition-colors',
                    i === 0 ? 'bg-lime-300' : 'bg-slate-600',
                  ]}
                  aria-label={`Go to testimonial ${i + 1}`}
                />
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-testimonial-carousel]');
  if (root) {
    const track = root.querySelector<HTMLUListElement>('[data-testimonial-track]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-testimonial-dots] button');
    const prev = document.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-testimonial-next]');
    const slides = track?.children.length ?? 0;
    let index = 0;

    const update = () => {
      if (!track) return;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-lime-300', i === index);
        dot.classList.toggle('bg-slate-600', i !== index);
      });
    };

    const go = (delta: number) => {
      if (slides === 0) return;
      index = (index + delta + slides) % slides;
      update();
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        index = Number(dot.dataset.index ?? 0);
        update();
      }),
    );

    if (slides > 1) {
      setInterval(() => go(1), 7000);
    }
  }
</script>
