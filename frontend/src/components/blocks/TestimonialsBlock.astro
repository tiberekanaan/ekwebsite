---
import Eyebrow from '@/components/empower/Eyebrow.astro';
interface TestimonialRef {
  quote: string;
  author: string;
  role?: string | null;
  image?: { url: string; alternativeText?: string | null } | null;
}

export interface TestimonialsBlockData {
  eyebrow?: string | null;
  title?: string | null;
  quote?: string | null;
  attribution?: string | null;
  note?: string | null;
  testimonials?: TestimonialRef[] | null;
}

interface Props {
  block: TestimonialsBlockData;
}

const { block } = Astro.props;

// One pull quote, not a carousel. Quotes are attributed by role and month,
// never by name — participants were promised their answers would not be shared.
const quote =
  block.quote ??
  'I once was a boss but not a leader. After the workshop I learnt a lot about the difference.';
const attribution = block.attribution ?? 'A faith leader · July 2026';
const note =
  block.note ??
  'We identify people by their role and the month, not by name. At the start of every workshop we tell participants that their individual answers will not be shared.';
---

<section id="voices" class="bg-ek-mist py-24">
  <div class="mx-auto max-w-6xl px-7">
    <div class="mb-12 max-w-[640px]" data-reveal>
      <Eyebrow as="span">{block.eyebrow ?? 'In their words'}</Eyebrow>
    </div>

    <figure class="max-w-[760px] border-l-4 border-ek-lime pl-8" data-reveal data-reveal-delay="80">
      <blockquote class="font-serif text-3xl font-bold leading-[1.18] text-ek-800 sm:text-4xl">
        “{quote}”
      </blockquote>
      <figcaption class="mt-6 font-condensed text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ek-olive">
        {attribution}
      </figcaption>
    </figure>

    <p class="mt-9 max-w-[620px] text-[0.95rem] text-ek-muted" data-reveal data-reveal-delay="160">
      {note}
    </p>
  </div>
</section>
