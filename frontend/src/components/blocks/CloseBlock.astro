---
import Eyebrow from '@/components/empower/Eyebrow.astro';
import { telHref, type ContactDetails } from '@/types/global';

/**
 * "Work with us" close: dark-teal CTA section above the footer. The donor
 * brief's copy (THE-CTA-SECTION.md) lives here as the fallback for every
 * field; the CMS blocks.close fields override it when set. `*text*` in the
 * title renders as the lime <em> (a plain CMS string can't carry markup).
 * Contact details come from the Global single type via the `contact` prop.
 */
export interface RouteCard {
  label?: string | null;
  title?: string | null;
  body?: string | null;
}

export interface CloseBlockData {
  eyebrow?: string | null;
  title?: string | null;
  description?: string | null;
  buttonText?: string | null;
  buttonLink?: string | null;
  routes?: RouteCard[] | null;
  contactHeading?: string | null;
  contactText?: string | null;
}

interface Props {
  block: CloseBlockData;
  contact?: ContactDetails | null;
}

const { block, contact } = Astro.props;

// Funders first — keep this order.
const DEFAULT_ROUTES = [
  {
    label: 'Embassies, ministries and funds',
    heading: 'Fund a programme',
    body: 'Tell us the outcome you are mandated to reach. We will come back with a design, a budget and the measures we will report against.',
  },
  {
    label: 'Agencies, NGOs and private sector',
    heading: 'Deliver with us',
    body: 'If your work needs an in-country partner who knows the communities and can run it properly, we can take that role or share it.',
  },
  {
    label: 'Community organisations, churches and schools',
    heading: 'Bring us to your people',
    body: 'Tell us what your members are struggling with. If it sits in our work, we will look for the partner and the funding to make it happen.',
  },
];

const routes =
  block.routes && block.routes.length > 0
    ? block.routes.map((r) => ({
        label: r.label ?? '',
        heading: r.title ?? '',
        body: r.body ?? '',
      }))
    : DEFAULT_ROUTES;

const eyebrow = block.eyebrow || 'Work with us';
// Odd-indexed segments of the split are the *emphasised* runs.
const titleParts = (block.title || 'Back work that is *already happening*').split(/\*([^*]+)\*/g);
const description =
  block.description ||
  'We are on the ground in South Tarawa, delivering with partners who checked us before they funded us. If you are looking for a partner in Kiribati who can plan, deliver and report properly, start here.';
const contactHeading = block.contactHeading || 'Talk to us directly';
const contactText =
  block.contactText ||
  'Write to us and we will respond promptly. You will get a real answer, not a form response, and we will tell you plainly if we are not the right partner for it.';

const email = contact?.partnershipEmail || 'partnership@empower.org.ki';
const phone = contact?.phone || '+686 7300 5227';
const office = contact?.officeLine || 'Bikenibeu, South Tarawa, Kiribati';
const utcNote =
  contact?.utcNote ||
  'Kiribati is UTC+12, ahead of most of the world. Your message will already be waiting for us when our day starts.';

const buttonText = block.buttonText || 'Start a conversation';
const buttonLink = block.buttonLink || `mailto:${email}`;
---

<section
  id="work-with-us"
  class="bg-ek-900 bg-[radial-gradient(900px_500px_at_80%_0%,rgba(42,128,137,0.5),transparent_60%),linear-gradient(200deg,var(--color-ek-800),var(--color-ek-900)_70%)] py-24 text-white"
>
  <div class="mx-auto max-w-6xl px-7">
    <div class="max-w-[680px]" data-reveal>
      <Eyebrow as="span" class="mb-4" tone="dark">{eyebrow}</Eyebrow>
      <h2 class="mb-4 font-serif text-4xl font-bold leading-[1.08] text-white sm:text-5xl">
        {
          titleParts.map((part, i) =>
            i % 2 === 1 ? <em class="not-italic text-ek-lime-bright">{part}</em> : part,
          )
        }
      </h2>
      <span
        class="mb-5 block h-1 w-16 rounded-full bg-gradient-to-r from-ek-lime to-ek-500"
        aria-hidden="true"></span>
      <p class="text-lg text-[#cfe0db]">{description}</p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        routes.map((route, i) => (
          <article
            class="group relative overflow-hidden rounded-2xl bg-white/[0.05] p-7 ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.08] hover:ring-ek-lime/30 hover:shadow-[0_18px_40px_rgba(4,24,27,0.45)]"
            data-reveal
            data-reveal-delay={i * 120}
          >
            <span
              class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-ek-lime to-ek-500 transition-transform duration-500 ease-out group-hover:scale-x-100"
              aria-hidden="true"
            />
            <p class="font-condensed text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-ek-lime-bright/85 transition-colors duration-300 group-hover:text-ek-lime-bright">
              {route.label}
            </p>
            <h3 class="mt-3 font-serif text-[1.35rem] font-bold text-white">{route.heading}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-[#cfe0db]">{route.body}</p>
          </article>
        ))
      }
    </div>

    <div
      class="cta-foot relative mt-16 grid gap-12 pt-14 lg:grid-cols-2 lg:gap-16"
      data-reveal
    >
      <span
        class="cta-rule absolute inset-x-0 top-0 h-px bg-ek-lime/[0.22]"
        aria-hidden="true"></span>
      <div>
        <h3 class="font-serif text-2xl font-bold text-white sm:text-[1.7rem]">
          {contactHeading}
        </h3>
        <p class="mt-3 max-w-[52ch] text-[#cfe0db]">{contactText}</p>
        <a
          href={buttonLink}
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-ek-lime px-[22px] py-3 font-condensed text-[0.92rem] font-semibold uppercase tracking-[0.06em] text-ek-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-ek-lime-bright hover:shadow-[0_8px_22px_rgba(174,203,58,0.3)]"
        >
          {buttonText}
        </a>
      </div>

      <div>
        <dl class="space-y-4">
          <div class="flex gap-6">
            <dt
              class="w-16 shrink-0 pt-[3px] font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-[#9fb9b4]"
            >
              Email
            </dt>
            <dd class="[overflow-wrap:anywhere]">
              <a
                href={`mailto:${email}`}
                class="text-white transition-colors hover:text-ek-lime-bright"
              >
                {email}
              </a>
            </dd>
          </div>
          <div class="flex gap-6">
            <dt
              class="w-16 shrink-0 pt-[3px] font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-[#9fb9b4]"
            >
              Phone
            </dt>
            <dd>
              <a
                href={telHref(phone)}
                class="text-white transition-colors hover:text-ek-lime-bright"
              >
                {phone}
              </a>
            </dd>
          </div>
          <div class="flex gap-6">
            <dt
              class="w-16 shrink-0 pt-[3px] font-condensed text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-[#9fb9b4]"
            >
              Office
            </dt>
            <dd class="text-white">{office}</dd>
          </div>
        </dl>
        <p class="mt-7 max-w-[46ch] border-l-2 border-ek-lime pl-4 text-[0.92rem] text-[#8fb0ab]">
          {utcNote}
        </p>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    .cta-foot .cta-rule {
      transform: none !important;
    }
  </style>
</noscript>

<style>
  /* The lime separator draws itself across as the contact block reveals;
     static without JS or under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .cta-foot[data-reveal] .cta-rule {
      transform: scaleX(0);
      transform-origin: left;
    }
    .cta-foot.is-visible .cta-rule {
      transform: scaleX(1);
      transition: transform 1400ms cubic-bezier(0.22, 1, 0.36, 1) 200ms;
    }
  }
</style>
