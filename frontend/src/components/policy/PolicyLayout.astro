---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';

interface Props {
  /** Page heading and document title. */
  title: string;
  /** Subtitle under the heading. */
  subtitle: string;
  /** Meta description for search results. */
  description: string;
}

const { title, subtitle, description } = Astro.props;
---

<Layout title={title} description={description} floatingHeader>
  <PageHeader title={title} description={subtitle} />
  <div class="mx-auto max-w-7xl px-8 py-16">
    <article class="policy-body mx-auto max-w-3xl">
      <slot />
    </article>
  </div>
</Layout>

<style>
  .policy-body {
    color: var(--color-ek-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .policy-body :global(p) {
    margin: 0 0 1.15rem;
  }
  .policy-body :global(h2) {
    margin: 3rem 0 1rem;
    color: var(--color-ek-800);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .policy-body :global(ul) {
    margin: 0 0 1.15rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .policy-body :global(li) {
    margin-bottom: 0.75rem;
    padding-left: 0.25rem;
  }
  .policy-body :global(li::marker) {
    color: var(--color-ek-500);
  }
  .policy-body :global(strong) {
    color: var(--color-ek-900);
  }
  .policy-body :global(a) {
    color: var(--color-ek-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .policy-body :global(a:hover) {
    color: var(--color-ek-800);
  }
  .policy-body :global(table) {
    width: 100%;
    margin: 0 0 1rem;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .policy-body :global(caption) {
    padding-bottom: 0.75rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-ek-800);
  }
  .policy-body :global(th),
  .policy-body :global(td) {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ek-700) 12%, transparent);
    text-align: left;
    vertical-align: top;
  }
  .policy-body :global(tbody th) {
    width: 38%;
    font-weight: 600;
    color: var(--color-ek-900);
  }
  .policy-body :global(thead th) {
    background: var(--color-ek-mist);
    font-family: var(--font-condensed);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ek-800);
  }
  .policy-body :global(tr:last-child th),
  .policy-body :global(tr:last-child td) {
    border-bottom: 0;
  }
  .policy-body :global(.policy-table) {
    overflow: hidden;
    margin-bottom: 1rem;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-ek-700) 10%, transparent);
  }
  .policy-body :global(.policy-table table) {
    margin: 0;
  }
  .policy-body :global(address) {
    margin-top: 1.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 1rem;
    background: var(--color-ek-mist);
    font-style: normal;
  }
  @media (max-width: 40rem) {
    .policy-body :global(thead) {
      display: none;
    }
    .policy-body :global(tbody th),
    .policy-body :global(tbody td) {
      display: block;
      width: auto;
    }
    .policy-body :global(tbody th) {
      padding-bottom: 0.15rem;
      border-bottom: 0;
    }
    .policy-body :global(tbody td) {
      padding-top: 0;
    }
  }
</style>
