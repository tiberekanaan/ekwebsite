---
import { Image } from 'astro:assets';
import logoFullColor from '@/assets/branding/empower-logo-full.webp';
import logoWhite from '@/assets/branding/empower-logo-white.webp';

import type { NavLink } from '@/types/global';

interface Props {
  /** Floats the navbar as an absolute pill over a full-bleed hero (landing only). */
  floating?: boolean;
  /** Dynamic logo from Strapi Global settings; falls back to the bundled asset. */
  logo?: { url: string; alternativeText?: string | null };
  /** Dynamic navbar links from Strapi Global settings; falls back to the hard-coded nav. */
  links?: NavLink[];
}

const { floating = false, logo, links } = Astro.props;

interface NavItem {
  label: string;
  href: string;
}

const defaultNav: NavItem[] = [
  { label: 'Our Work', href: '/our-programs' },
  { label: 'Resources', href: '/resources' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const nav: NavItem[] =
  links && links.length > 0
    ? links.map((link) => ({ label: link.label, href: link.url }))
    : defaultNav;

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href.startsWith('#') || href.startsWith('/#')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  data-floating={floating || undefined}
  class:list={[
    floating
      ? 'group fixed inset-x-0 top-0 z-50 px-6 pt-5 transition-[padding,background-color,box-shadow] duration-300 data-[scrolled]:bg-white/95 data-[scrolled]:pt-0 data-[scrolled]:shadow-[0_8px_30px_rgba(15,50,58,0.1)] data-[scrolled]:backdrop-blur-md'
      : 'sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur',
  ]}
>
  <div
    class:list={[
      'relative flex items-center',
      floating ? 'mx-auto max-w-7xl py-2' : 'mx-auto max-w-7xl justify-between px-6 py-3',
    ]}
  >
    <a
      href="/"
      class="inline-flex items-center transition-transform duration-300 hover:scale-[1.03]"
      aria-label="Empower Kiribati home"
    >
      {
        floating ? (
          // Over the hero the bar is transparent on a dark scene, so the
          // bundled white logo wins (a full-colour CMS upload would vanish);
          // the colour version crossfades in once the bar scrolls to white.
          <span class="relative inline-flex">
            <Image
              src={logoWhite}
              alt="Empower Kiribati"
              height={56}
              widths={[144, 216, 288]}
              sizes="(min-width: 640px) 200px, 170px"
              class="h-12 w-auto drop-shadow-[0_2px_12px_rgba(2,20,25,0.5)] transition-opacity duration-300 group-data-[scrolled]:opacity-0 sm:h-14"
              loading="eager"
            />
            <Image
              src={logoFullColor}
              alt=""
              height={56}
              widths={[144, 216, 288]}
              sizes="(min-width: 640px) 200px, 170px"
              class="absolute left-0 top-0 h-12 w-auto opacity-0 transition-opacity duration-300 group-data-[scrolled]:opacity-100 sm:h-14"
              loading="eager"
            />
          </span>
        ) : logo ? (
          <img
            src={logo.url}
            alt={logo.alternativeText || 'Empower Kiribati'}
            class="h-12 w-auto sm:h-14"
            loading="eager"
          />
        ) : (
          <Image
            src={logoFullColor}
            alt="Empower Kiribati"
            height={56}
            widths={[144, 216, 288]}
            sizes="(min-width: 1024px) 216px, 168px"
            class="h-12 w-auto sm:h-14"
            loading="eager"
          />
        )
      }
    </a>

    <nav
      class:list={['hidden items-center md:flex', floating ? 'ml-auto gap-1' : 'gap-8']}
      aria-label="Primary"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              floating
                ? [
                    'rounded-full px-4 py-2 font-serif text-sm font-medium transition-colors',
                    isActive(item.href)
                      ? 'bg-white/10 text-ek-lime-bright group-data-[scrolled]:bg-ek-mist group-data-[scrolled]:text-ek-700'
                      : 'text-white/85 hover:bg-white/10 hover:text-white group-data-[scrolled]:text-ek-ink group-data-[scrolled]:hover:bg-ek-900 group-data-[scrolled]:hover:text-white',
                  ]
                : [
                    'relative font-serif text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-lime-400 after:transition-transform after:duration-300 hover:after:scale-x-100',
                    isActive(item.href)
                      ? 'text-slate-900 after:scale-x-100'
                      : 'text-slate-700 hover:text-slate-900',
                  ],
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class:list={['flex items-center', floating ? 'ml-auto gap-1 pl-2 md:ml-0' : 'gap-3']}>
      <button
        type="button"
        data-search-open
        class:list={[
          'inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors',
          floating
            ? 'text-white/85 hover:bg-white/10 hover:text-white group-data-[scrolled]:text-ek-ink group-data-[scrolled]:hover:bg-ek-900 group-data-[scrolled]:hover:text-white'
            : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
        ]}
        aria-label="Search the site"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" />
        </svg>
      </button>

      <a
        href="/contact"
        class:list={[
          'hidden rounded-full text-sm font-semibold text-ek-900 shadow-sm transition-all duration-200 hover:-translate-y-0.5 sm:inline-flex',
          floating
            ? 'bg-ek-lime px-4 py-2 font-condensed text-[0.85rem] font-semibold uppercase tracking-[0.06em] hover:bg-ek-lime-bright'
            : 'bg-lime-300 px-5 py-2.5 text-slate-900 hover:bg-lime-400',
        ]}
      >
        Contact
      </a>

      <button
        type="button"
        class:list={[
          'inline-flex items-center justify-center p-2 md:hidden',
          floating
            ? 'rounded-full text-white/85 hover:bg-white/10 hover:text-white group-data-[scrolled]:text-ek-ink group-data-[scrolled]:hover:bg-ek-900 group-data-[scrolled]:hover:text-white'
            : 'rounded-md text-slate-700 hover:bg-slate-100',
        ]}
        aria-controls="empower-mobile-nav"
        aria-expanded="false"
        data-mobile-toggle
      >
        <span class="sr-only">Open menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="empower-mobile-nav"
    class:list={[
      'hidden md:hidden',
      floating
        ? 'mx-auto mt-2 w-full max-w-sm rounded-2xl bg-ek-900/90 ring-1 ring-white/15 backdrop-blur-md'
        : 'border-t border-slate-200 bg-white',
    ]}
  >
    <nav class="flex flex-col gap-1 px-6 py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-2 font-serif text-base font-medium',
              floating
                ? 'text-white/90 hover:bg-white/10 hover:text-white'
                : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class:list={[
          'mt-2 inline-flex w-full items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold sm:hidden',
          floating
            ? 'bg-ek-lime text-ek-900 hover:bg-ek-lime-bright'
            : 'bg-lime-300 text-slate-900 hover:bg-lime-400',
        ]}
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  // re-bind on every ClientRouter swap — the header DOM is replaced on each
  // navigation, so a once-only listener goes dead after the first page change
  let onScroll: (() => void) | undefined;

  const init = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const panel = document.getElementById('empower-mobile-nav');
    btn?.addEventListener('click', () => {
      const open = panel?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });

    // the floating bar turns white once the hero scrolls away; swap the old
    // handler out so listeners don't stack across ClientRouter navigations
    if (onScroll) window.removeEventListener('scroll', onScroll);
    const header = document.querySelector<HTMLElement>('header[data-floating]');
    if (!header) return;
    onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  };
  document.addEventListener('astro:page-load', init);
</script>
