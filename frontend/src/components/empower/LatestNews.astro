---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogs'))
  .sort((a, b) => {
    const aDate = a.data.publish_date?.valueOf() ?? a.data.publishedAt?.valueOf() ?? 0;
    const bDate = b.data.publish_date?.valueOf() ?? b.data.publishedAt?.valueOf() ?? 0;
    return bDate - aDate;
  })
  .slice(0, 3);

const formatDate = (d?: Date | null) =>
  d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const excerpt = (text?: string | null) => {
  if (!text) return '';
  const stripped = text.replace(/[#*_>`-]+/g, ' ').replace(/\s+/g, ' ').trim();
  return stripped.length > 140 ? `${stripped.slice(0, 140)}…` : stripped;
};
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-500">Latest</p>
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Stories &amp; <span class="text-teal-700">News</span>
        </h2>
      </div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm font-bold uppercase tracking-wider text-slate-900 hover:underline"
      >
        All posts
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="py-12 text-center text-slate-500">No posts yet.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-teal-500"
            >
              <time class="text-xs font-bold uppercase tracking-wider text-teal-700">
                {formatDate(post.data.publish_date ?? post.data.publishedAt)}
              </time>
              <h3 class="text-xl font-bold leading-snug text-slate-900 group-hover:text-teal-700">
                {post.data.title}
              </h3>
              {post.data.content && (
                <p class="text-sm text-slate-600">{excerpt(post.data.content)}</p>
              )}
              <span class="mt-auto inline-flex items-center gap-1 pt-2 text-xs font-bold uppercase tracking-wider text-slate-900">
                Read more
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
