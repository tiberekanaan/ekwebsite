---
import { Image } from 'astro:assets';
import logoWhite from '@/assets/branding/empower-logo-white.webp';

interface NavItem {
  label: string;
  href: string;
}

const workNav: NavItem[] = [
  { label: 'Programmes', href: '/our-programs' },
  { label: 'Partners', href: '/our-partners' },
];

const learnNav: NavItem[] = [
  { label: 'Resources', href: '/resources' },
  { label: 'Blog', href: '/blog' },
  { label: 'Events', href: '/events' },
];

const socials = [
  {
    label: 'Facebook',
    href: 'https://facebook.com/empowerkiribati',
    icon: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/empowerkiribati',
    icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.9-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9.5Z',
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-200">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.3fr] lg:items-start">
      <div class="max-w-sm">
        <a
          href="/"
          class="inline-flex items-center transition-transform duration-300 hover:scale-[1.03]"
          aria-label="Empower Kiribati home"
        >
          <Image
            src={logoWhite}
            alt="Empower Kiribati"
            height={56}
            widths={[140, 200, 260]}
            sizes="(min-width: 1024px) 200px, 160px"
            class="h-12 w-auto sm:h-14"
            loading="lazy"
          />
        </a>
        <p class="mt-4 text-sm text-slate-400">
          A Kiribati NGO based in Bikenibeu, South Tarawa. We work on leadership, digital skills and
          financial confidence in the communities we come from.
        </p>

        <ul class="mt-6 flex items-center gap-3" aria-label="Social media">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-800 text-slate-200 transition-all duration-300 hover:-translate-y-0.5 hover:scale-110 hover:bg-lime-300 hover:text-slate-900"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.icon} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Our work">
        <h2 class="text-sm font-bold uppercase tracking-widest text-lime-300">Our work</h2>
        <ul class="mt-4 space-y-3">
          {
            workNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-slate-300 transition-colors hover:text-lime-300"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Learn">
        <h2 class="text-sm font-bold uppercase tracking-widest text-lime-300">Learn</h2>
        <ul class="mt-4 space-y-3">
          {
            learnNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-slate-300 transition-colors hover:text-lime-300"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-widest text-lime-300">Get in touch</h2>
        <address class="mt-4 space-y-3 text-sm not-italic text-slate-400">
          <p>
            <a href="mailto:externalaffairs@empower.org.ki" class="transition-colors hover:text-lime-300">
              externalaffairs@empower.org.ki
            </a>
          </p>
          <p>
            <a href="tel:+68673005227" class="transition-colors hover:text-lime-300">+686 7300 5227</a>
          </p>
          <p>Te Kimatore CS Compound<br />Bikenibeu, South Tarawa</p>
        </address>
      </div>
    </div>

    <p class="mt-10 max-w-4xl text-xs leading-relaxed text-slate-500">
      Empower Kiribati is the operating name of Digital Kiribati Inc, incorporated under the
      Republic of Kiribati Incorporated Societies Act 2002 on 6 May 2024 (Reg. No 21/24) and
      registered as a National NGO with the Ministry for Women, Youth, Sports and Social Affairs.
    </p>

    <div
      class="mt-6 flex flex-col gap-3 border-t border-slate-700 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Empower Kiribati. All rights reserved.</p>
      <p class="font-medium uppercase tracking-widest text-teal-300">Mauri from Kiribati</p>
    </div>
  </div>
</footer>
