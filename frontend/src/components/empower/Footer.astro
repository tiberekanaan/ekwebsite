---
import { Image } from 'astro:assets';
import logoWhite from '@/assets/branding/empower-logo-white.webp';

interface NavItem {
  label: string;
  href: string;
}

const workNav: NavItem[] = [
  { label: 'Programmes', href: '/our-programs' },
  { label: 'Partners', href: '/our-partners' },
];

const learnNav: NavItem[] = [
  { label: 'Resources', href: '/resources' },
  { label: 'Blog', href: '/blog' },
  { label: 'Events', href: '/events' },
];

const socials = [
  {
    label: 'Facebook',
    href: 'https://facebook.com/empowerkiribati',
    icon: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/empowerkiribati',
    icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.9-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9.5Z',
  },
];

const year = new Date().getFullYear();
---

<footer
  class="relative overflow-hidden bg-ek-900 bg-[linear-gradient(180deg,var(--color-ek-900),#04181b)] text-[#cfe0db]"
>
  <!--
    The seam: a faint lime hairline the bwabwai roots grow down from, so the
    dark CTA above settles into the footer instead of butting against it.
    Roots motif from the landing reference (empower-landing-v3.html).
  -->
  <span
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-ek-lime/25 to-transparent"
    aria-hidden="true"></span>
  <svg
    class="pointer-events-none absolute inset-x-0 top-0 h-[110px] w-full opacity-[0.11]"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g stroke="#aecb3a" stroke-width="2" fill="none">
      <path
        d="M720 0v50M720 50c-60 0-120 20-180 60M720 50c60 0 120 20 180 60M720 50c-20 0-40 30-40 70M720 50c20 0 40 30 40 70M520 30v40M920 30v40M360 60c-40 0-80 20-110 50M1080 60c40 0 80 20 110 50"
      ></path>
    </g>
    <g fill="#aecb3a">
      <circle cx="540" cy="110" r="4"></circle>
      <circle cx="900" cy="110" r="4"></circle>
      <circle cx="680" cy="120" r="4"></circle>
      <circle cx="760" cy="120" r="4"></circle>
      <circle cx="250" cy="110" r="3"></circle>
      <circle cx="1190" cy="110" r="3"></circle>
    </g>
  </svg>
  <div class="relative mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.3fr] lg:items-start">
      <div class="max-w-sm">
        <a
          href="/"
          class="inline-flex items-center transition-transform duration-300 hover:scale-[1.03]"
          aria-label="Empower Kiribati home"
        >
          <Image
            src={logoWhite}
            alt="Empower Kiribati"
            height={56}
            widths={[140, 200, 260]}
            sizes="(min-width: 1024px) 200px, 160px"
            class="h-12 w-auto sm:h-14"
            loading="lazy"
          />
        </a>
        <p class="mt-4 text-sm text-[#9fb9b4]">
          A Kiribati NGO based in Bikenibeu, South Tarawa. We work on leadership, digital skills and
          financial confidence in the communities we come from.
        </p>

        <ul class="mt-6 flex items-center gap-3" aria-label="Social media">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:-translate-y-0.5 hover:scale-110 hover:bg-ek-lime hover:text-ek-900"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.icon} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Our work">
        <h2 class="font-condensed text-sm font-bold uppercase tracking-widest text-ek-lime-bright">Our work</h2>
        <ul class="mt-4 space-y-3">
          {
            workNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-[#cfe0db] transition-colors hover:text-ek-lime-bright"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Learn">
        <h2 class="font-condensed text-sm font-bold uppercase tracking-widest text-ek-lime-bright">Learn</h2>
        <ul class="mt-4 space-y-3">
          {
            learnNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-[#cfe0db] transition-colors hover:text-ek-lime-bright"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-condensed text-sm font-bold uppercase tracking-widest text-ek-lime-bright">Get in touch</h2>
        <address class="mt-4 space-y-3 text-sm not-italic text-[#9fb9b4]">
          <p>
            <a
              href="mailto:externalaffairs@empower.org.ki"
              class="transition-colors hover:text-ek-lime-bright"
            >
              externalaffairs@empower.org.ki
            </a>
          </p>
          <p>
            <a href="tel:+68673005227" class="transition-colors hover:text-ek-lime-bright">
              +686 7300 5227
            </a>
          </p>
          <p>Te Kimatore CS Compound<br />Bikenibeu, South Tarawa</p>
        </address>
      </div>
    </div>

    <p class="mt-10 max-w-4xl text-xs leading-relaxed text-[#9fb9b4]/70">
      Empower Kiribati is the operating name of Digital Kiribati Inc, incorporated under the
      Republic of Kiribati Incorporated Societies Act 2002 on 6 May 2024 (Reg. No 21/24) and
      registered as a National NGO with the Ministry for Women, Youth, Sports and Social Affairs.
    </p>

    <div
      class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-[#9fb9b4] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Empower Kiribati. All rights reserved.</p>
      <p class="font-condensed font-medium uppercase tracking-widest text-[#7fc8d2]">
        Mauri from Kiribati
      </p>
    </div>
  </div>
</footer>
