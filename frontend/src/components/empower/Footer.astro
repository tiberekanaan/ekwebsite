---
import { Image } from 'astro:assets';
import logoWhite from '@/assets/branding/empower-logo-white.webp';
import { telHref, type GlobalSettings } from '@/types/global';

interface Props {
  /** Global settings from Strapi; every field falls back to the defaults below. */
  global?: GlobalSettings | null;
  /** White CMS logo (absolute URL); falls back to the bundled asset. */
  logoWhite?: { url: string; alternativeText?: string | null };
}

const { global, logoWhite: cmsLogoWhite } = Astro.props;

interface NavItem {
  label: string;
  href: string;
}

interface NavColumn {
  heading: string;
  items: NavItem[];
}

const defaultColumns: NavColumn[] = [
  {
    heading: 'Our work',
    items: [
      { label: 'Programmes', href: '/our-programs' },
      { label: 'Partners', href: '/our-partners' },
    ],
  },
  {
    heading: 'Learn',
    items: [
      { label: 'Resources', href: '/resources' },
      { label: 'Blog', href: '/blog' },
      { label: 'Events', href: '/events' },
    ],
  },
];

const columns: NavColumn[] =
  global?.footerColumns && global.footerColumns.length > 0
    ? global.footerColumns.map((col) => ({
        heading: col.heading,
        items: (col.links ?? []).map((l) => ({ label: l.label, href: l.url })),
      }))
    : defaultColumns;

// Icon matched from the link's URL/label; unknown networks get the globe.
const SOCIAL_ICONS: Array<{ match: RegExp; path: string }> = [
  {
    match: /facebook/i,
    path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z',
  },
  {
    match: /linkedin/i,
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.9-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V9.5Z',
  },
  {
    match: /youtube|youtu\.be/i,
    path: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z',
  },
  {
    match: /instagram/i,
    path: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2 0 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.9-.4 2.3a3.9 3.9 0 0 1-.9 1.4c-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.9-.2-2.3-.4a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.2-.4-.4-1.1-.4-2.3-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c0-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.3-.1 1.7-.1 4.9-.1Zm0 4.9a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 1.8a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4Zm5.2-2.9a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z',
  },
];

const GLOBE_ICON =
  'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3.4a15.7 15.7 0 0 0-1.2-5.7A8 8 0 0 1 19.9 11ZM12 4c.9 1.2 2 3.5 2.4 7H9.6C10 7.5 11.1 5.2 12 4ZM4.1 13h3.4c.2 2.2.6 4.1 1.2 5.7A8 8 0 0 1 4.1 13Zm3.4-2H4.1a8 8 0 0 1 4.6-5.7A15.7 15.7 0 0 0 7.5 11Zm4.5 9c-.9-1.2-2-3.5-2.4-7h4.8c-.4 3.5-1.5 5.8-2.4 7Zm3.3-1.3c.6-1.6 1-3.5 1.2-5.7h3.4a8 8 0 0 1-4.6 5.7Z';

const defaultSocials: NavItem[] = [
  { label: 'Facebook', href: 'https://facebook.com/empowerkiribati' },
  { label: 'LinkedIn', href: 'https://linkedin.com/company/empowerkiribati' },
];

const socials = (
  global?.socialLinks && global.socialLinks.length > 0
    ? global.socialLinks.map((l) => ({ label: l.label, href: l.url }))
    : defaultSocials
).map((s) => ({
  ...s,
  icon: SOCIAL_ICONS.find((i) => i.match.test(s.href) || i.match.test(s.label))?.path ?? GLOBE_ICON,
}));

const blurb =
  global?.footerBlurb ??
  'A Kiribati NGO based in Bikenibeu, South Tarawa. We work on leadership, digital skills and financial confidence in the communities we come from.';
const contactHeading = global?.footerContactHeading ?? 'Get in touch';
const email = global?.generalEmail ?? 'externalaffairs@empower.org.ki';
const phone = global?.phone ?? '+686 7300 5227';
const addressLines = (global?.footerAddress ?? 'Te Kimatore CS Compound\nBikenibeu, South Tarawa')
  .split(/\r?\n/)
  .filter(Boolean);
const legalLine =
  global?.legalLine ??
  'Empower Kiribati is the operating name of Digital Kiribati Inc, incorporated under the Republic of Kiribati Incorporated Societies Act 2002 on 6 May 2024 (Reg. No 21/24) and registered as a National NGO with the Ministry for Women, Youth, Sports and Social Affairs.';
const tagline = global?.footerTagline ?? 'Mauri from Kiribati';
const siteName = global?.siteName ?? 'Empower Kiribati';

const year = new Date().getFullYear();
---

<footer
  class="relative overflow-hidden bg-ek-900 bg-[linear-gradient(180deg,var(--color-ek-900),#04181b)] text-[#cfe0db]"
>
  <!--
    The seam: a faint lime hairline the bwabwai roots grow down from, so the
    dark CTA above settles into the footer instead of butting against it.
    Roots motif from the landing reference (empower-landing-v3.html).
  -->
  <span
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-ek-lime/25 to-transparent"
    aria-hidden="true"></span>
  <svg
    class="pointer-events-none absolute inset-x-0 top-0 h-[110px] w-full opacity-[0.11]"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g stroke="#aecb3a" stroke-width="2" fill="none">
      <path
        d="M720 0v50M720 50c-60 0-120 20-180 60M720 50c60 0 120 20 180 60M720 50c-20 0-40 30-40 70M720 50c20 0 40 30 40 70M520 30v40M920 30v40M360 60c-40 0-80 20-110 50M1080 60c40 0 80 20 110 50"
      ></path>
    </g>
    <g fill="#aecb3a">
      <circle cx="540" cy="110" r="4"></circle>
      <circle cx="900" cy="110" r="4"></circle>
      <circle cx="680" cy="120" r="4"></circle>
      <circle cx="760" cy="120" r="4"></circle>
      <circle cx="250" cy="110" r="3"></circle>
      <circle cx="1190" cy="110" r="3"></circle>
    </g>
  </svg>
  <div class="relative mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.3fr] lg:items-start">
      <div class="max-w-sm">
        <a
          href="/"
          class="inline-flex items-center transition-transform duration-300 hover:scale-[1.03]"
          aria-label={`${siteName} home`}
        >
          {
            cmsLogoWhite ? (
              <img
                src={cmsLogoWhite.url}
                alt={cmsLogoWhite.alternativeText || siteName}
                class="h-12 w-auto sm:h-14"
                loading="lazy"
              />
            ) : (
              <Image
                src={logoWhite}
                alt={siteName}
                height={56}
                widths={[140, 200, 260]}
                sizes="(min-width: 1024px) 200px, 160px"
                class="h-12 w-auto sm:h-14"
                loading="lazy"
              />
            )
          }
        </a>
        <p class="mt-4 text-sm text-[#9fb9b4]">{blurb}</p>

        <ul class="mt-6 flex items-center gap-3" aria-label="Social media">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:-translate-y-0.5 hover:scale-110 hover:bg-ek-lime hover:text-ek-900"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.icon} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-widest text-ek-lime-bright">
              {column.heading}
            </h2>
            <ul class="mt-4 space-y-3">
              {column.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm font-medium text-[#cfe0db] transition-colors hover:text-ek-lime-bright"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="font-condensed text-sm font-bold uppercase tracking-widest text-ek-lime-bright">
          {contactHeading}
        </h2>
        <address class="mt-4 space-y-3 text-sm not-italic text-[#9fb9b4]">
          <p>
            <a href={`mailto:${email}`} class="transition-colors hover:text-ek-lime-bright">
              {email}
            </a>
          </p>
          <p>
            <a href={telHref(phone)} class="transition-colors hover:text-ek-lime-bright">
              {phone}
            </a>
          </p>
          <p>
            {addressLines.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))}
          </p>
        </address>
      </div>
    </div>

    <p class="mt-10 max-w-4xl text-xs leading-relaxed text-[#9fb9b4]/70">{legalLine}</p>

    <div
      class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-[#9fb9b4] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {siteName}. All rights reserved.</p>
      <p class="font-condensed font-medium uppercase tracking-widest text-[#7fc8d2]">
        {tagline}
      </p>
    </div>
  </div>
</footer>
