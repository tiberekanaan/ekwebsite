---
interface Challenge {
  title: string;
  caption: string;
  stat: string;
  statLabel: string;
  accent: string;
  iconPath: string;
}

const challenges: Challenge[] = [
  {
    title: 'Climate Change',
    caption:
      'Rising seas, salt intrusion, and intensifying storms put coastal villages and food systems under constant pressure.',
    stat: '1.6m',
    statLabel: 'Average atoll elevation',
    accent: 'from-sky-500/15 to-sky-500/5 text-sky-700',
    iconPath:
      'M3 16c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M3 12c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M3 8c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2',
  },
  {
    title: 'Unemployment',
    caption:
      'Few formal jobs reach the outer islands, leaving young people without pathways into stable, dignified work.',
    stat: '30%+',
    statLabel: 'Youth out of work or school',
    accent: 'from-amber-500/15 to-amber-500/5 text-amber-700',
    iconPath:
      'M3 7h18M3 7v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
  },
  {
    title: 'Low Skills',
    caption:
      'Limited digital, financial, and trade skills make it harder for I-Kiribati to access modern opportunities.',
    stat: '< 40%',
    statLabel: 'Adults with digital fluency',
    accent: 'from-violet-500/15 to-violet-500/5 text-violet-700',
    iconPath:
      'M12 2 2 7l10 5 10-5-10-5Zm-7 9v5l7 3 7-3v-5',
  },
  {
    title: 'Family Struggles',
    caption:
      'Households juggle remoteness, rising costs, and limited services — leaving little room for long-term planning.',
    stat: '6.1',
    statLabel: 'Avg. people per household',
    accent: 'from-rose-500/15 to-rose-500/5 text-rose-700',
    iconPath:
      'M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-5.13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm6 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
];
---

<section id="challenges" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div data-reveal>
        <p class="mb-3 font-accent text-3xl leading-none text-slate-700">
          Major Challenges
        </p>
        <h2
          class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl"
        >
          THE PRESSURES<br />OUR <span class="text-teal-700">ISLANDS</span><br />ARE FACING.
        </h2>
      </div>
      <p class="max-w-lg text-base text-slate-600 lg:pb-2">
        Empower Kiribati exists because the headwinds are real. These four challenges shape every
        programme, partnership, and policy conversation we step into.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        challenges.map((c) => (
          <article
            data-reveal
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-teal-900/5"
          >
            <div
              class:list={[
                'relative flex aspect-[5/3] w-full items-center justify-center overflow-hidden bg-gradient-to-br',
                c.accent,
              ]}
              aria-hidden="true"
            >
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.55),transparent_65%)] transition-transform duration-500 group-hover:scale-110" />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="relative h-10 w-10 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={c.iconPath} />
              </svg>

              <div class="absolute right-3 top-3 rounded-full bg-white/70 px-2 py-1 text-[10px] font-semibold uppercase tracking-widest text-slate-600 backdrop-blur-sm">
                Data soon
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-5">
              <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900">{c.title}</h3>
              <p class="text-sm leading-relaxed text-slate-600">{c.caption}</p>

              <div class="mt-auto rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4">
                <div class="font-display text-3xl font-extrabold text-slate-900">{c.stat}</div>
                <div class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                  {c.statLabel}
                </div>
                <div class="mt-3 h-12 rounded bg-[repeating-linear-gradient(135deg,#e2e8f0_0_8px,transparent_8px_16px)]" />
                <p class="mt-2 text-[10px] uppercase tracking-widest text-slate-400">
                  Visual placeholder
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
