---
// Site search modal powered by Pagefind (@pagefind/default-ui).
// Mounted once globally via Layout.astro; any [data-search-open] button opens
// it, as do ⌘K / Ctrl+K and `/`. The index is built by
// scripts/build-search-index.mjs after `astro build` and served in dev by the
// pagefind-dev integration (from the last build), so search works everywhere.
// The Pagefind UI stylesheet is imported here (not in the <script>) so it ends
// up in the page CSS bundle — JS-injected styles get dropped on ClientRouter
// swaps, leaving the search input unstyled after a navigation.
import '@pagefind/default-ui/css/ui.css';
---

<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden items-start justify-center bg-ek-900/70 px-3 pt-16 backdrop-blur-sm sm:px-4 sm:pt-28"
  role="dialog"
  aria-modal="true"
  aria-label="Site search"
>
  <div
    class="flex w-full max-w-2xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-ek-700/10"
    data-search-panel
  >
    <div class="flex items-center justify-between gap-3 border-b border-ek-700/10 px-5 py-3">
      <span class="font-condensed text-xs font-semibold tracking-[0.2em] text-ek-olive uppercase">
        Search Empower Kiribati
      </span>
      <button
        type="button"
        data-search-close
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ek-muted transition-colors hover:bg-ek-mist hover:text-ek-ink"
        aria-label="Close search"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="max-h-[65vh] min-h-0 flex-1 overflow-y-auto overscroll-contain p-4 sm:max-h-[60vh] sm:p-5">
      <div id="pagefind-search"></div>
    </div>

    <div
      class="hidden items-center gap-4 border-t border-ek-700/10 bg-ek-mist/40 px-5 py-2.5 text-xs text-ek-muted sm:flex"
    >
      <span><kbd class="search-kbd">↵</kbd> open result</span>
      <span><kbd class="search-kbd">Esc</kbd> close</span>
      <span class="ml-auto"><kbd class="search-kbd">⌘</kbd><kbd class="search-kbd">K</kbd> anywhere</span>
    </div>
  </div>
</div>

<script>
  import { PagefindUI } from '@pagefind/default-ui';

  // Cached across ClientRouter navigations — the /pagefind HEAD probe only
  // needs to run once per full page load.
  let indexAvailable: boolean | null = null;
  let lastTrigger: HTMLElement | null = null;

  const getModal = () => document.getElementById('search-modal');
  const isOpen = () => !getModal()?.classList.contains('hidden');

  const ensureUI = async () => {
    const modal = getModal();
    if (!modal || modal.dataset.ready) return;
    modal.dataset.ready = 'true';

    if (indexAvailable === null) {
      indexAvailable = await fetch('/pagefind/pagefind-entry.json', { method: 'HEAD' })
        .then((res) => res.ok)
        .catch(() => false);
    }

    const mount = document.getElementById('pagefind-search');
    if (!indexAvailable) {
      if (mount) {
        mount.innerHTML =
          '<p class="search-fallback">The search index hasn’t been built yet. Run <code>npm run build</code> once — the dev server picks it up automatically on restart.</p>';
      }
      return;
    }

    new PagefindUI({
      element: '#pagefind-search',
      showSubResults: true,
      showImages: false,
    });
  };

  const focusInput = (attempt = 0) => {
    const input = getModal()?.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
    if (input) input.focus();
    else if (attempt < 10) requestAnimationFrame(() => focusInput(attempt + 1));
  };

  const open = async (trigger?: HTMLElement) => {
    const modal = getModal();
    if (!modal) return;
    lastTrigger = trigger ?? (document.activeElement as HTMLElement | null);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    await ensureUI();
    focusInput();
  };

  const close = () => {
    const modal = getModal();
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    lastTrigger?.focus();
    lastTrigger = null;
  };

  const isTyping = (target: EventTarget | null) => {
    const el = target as HTMLElement | null;
    return (
      !!el &&
      (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)
    );
  };

  // Document-level shortcuts are bound once per full page load (module scope),
  // never per navigation — rebinding on astro:page-load would stack handlers.
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
    } else if (e.key === '/' && !isOpen() && !isTyping(e.target)) {
      e.preventDefault();
      open();
    } else if (e.key === 'Escape' && isOpen()) {
      close();
    }
  });

  // Per-page bindings — the modal and triggers are replaced on every
  // ClientRouter swap, so these re-attach to the fresh elements.
  const init = () => {
    document.body.style.overflow = '';

    const modal = getModal();
    if (!modal) return;

    const panel = modal.querySelector<HTMLElement>('[data-search-panel]');

    document
      .querySelectorAll<HTMLElement>('[data-search-open]')
      .forEach((btn) => btn.addEventListener('click', () => open(btn)));
    modal
      .querySelectorAll<HTMLElement>('[data-search-close]')
      .forEach((btn) => btn.addEventListener('click', close));

    // Backdrop click (outside the panel) closes.
    modal.addEventListener('click', (e) => {
      if (panel && !panel.contains(e.target as Node)) close();
    });
  };

  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  /* Match the Pagefind default UI to the ek design tokens. */
  #pagefind-search {
    --pagefind-ui-primary: var(--color-ek-600);
    --pagefind-ui-text: var(--color-ek-ink);
    --pagefind-ui-background: var(--color-white);
    --pagefind-ui-border: color-mix(in oklab, var(--color-ek-700) 12%, transparent);
    --pagefind-ui-tag: var(--color-ek-mist);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: inherit;
  }

  #pagefind-search .pagefind-ui__search-input:focus {
    outline: 2px solid var(--color-ek-500);
    outline-offset: -1px;
  }

  #pagefind-search .pagefind-ui__result-link {
    color: var(--color-ek-700);
  }

  #pagefind-search .pagefind-ui__result-link:hover {
    color: var(--color-ek-500);
  }

  #pagefind-search mark {
    background: var(--color-ek-lime-bright);
    color: var(--color-ek-ink);
    border-radius: 0.2rem;
    padding: 0 0.15rem;
  }

  .search-kbd {
    display: inline-flex;
    min-width: 1.4rem;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--color-ek-700) 18%, transparent);
    border-radius: 0.375rem;
    background: var(--color-white);
    padding: 0.1rem 0.3rem;
    font-family: inherit;
    font-size: 0.6875rem;
    color: var(--color-ek-muted);
  }

  .search-fallback {
    margin: 0;
    border: 1px dashed color-mix(in oklab, var(--color-ek-700) 25%, transparent);
    border-radius: 0.75rem;
    background: var(--color-ek-mist);
    padding: 1rem 1.25rem;
    color: var(--color-ek-ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .search-fallback code {
    border-radius: 0.25rem;
    background: var(--color-white);
    padding: 0.05rem 0.35rem;
    font-size: 0.8125rem;
  }
</style>
