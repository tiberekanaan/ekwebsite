---
import { getCollection } from 'astro:content';
import { STRAPI_URL } from 'astro:env/server';

const highlights = [
  { value: '32', label: 'Atolls reached' },
  { value: '47+', label: 'Programmes' },
  { value: '11.4K', label: 'Lives touched' },
];

const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const absoluteUrl = (url: string) => (url.startsWith('http') ? url : `${STRAPI_URL}${url}`);
---

<section class="relative overflow-hidden bg-slate-900 text-white">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(45,212,191,0.25),transparent_55%),radial-gradient(ellipse_at_bottom_right,rgba(190,242,100,0.18),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(180deg,transparent,rgba(15,23,42,0.85))]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-10 px-6 py-12 lg:grid-cols-2 lg:items-center lg:gap-12 lg:py-16">
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-lime-300/30 bg-lime-300/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-lime-200"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-lime-300" aria-hidden="true"></span>
        Empower Kiribati
      </p>

      <h1
        class="mt-5 font-display text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-[2.75rem] xl:text-5xl 2xl:text-6xl"
      >
        We foster initiatives<br />
        that create <span class="text-lime-300">thriving</span><br />
        and <span class="text-teal-300">resilient</span> futures.
      </h1>

      <p class="mt-5 max-w-xl text-base text-slate-300 sm:text-lg">
        Kiribati-led and community-driven — working alongside communities to strengthen
        resilience, digital trust, and livelihoods across every atoll.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/support-us"
          class="group inline-flex items-center gap-2 rounded-full bg-lime-300 px-6 py-3 text-sm font-semibold text-slate-900 shadow-lg shadow-lime-300/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-lime-400 hover:shadow-xl hover:shadow-lime-300/30"
        >
          Support Us
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/strategy-2026-2030"
          class="inline-flex items-center gap-2 rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
        >
          Strategy 2026–2030
        </a>
      </div>

      <dl class="mt-8 grid max-w-md grid-cols-3 gap-6">
        {
          highlights.map((h) => (
            <div data-reveal>
              <dt
                class="font-display text-3xl font-extrabold text-white"
                data-countup
                data-target={h.value}
              >
                {h.value}
              </dt>
              <dd class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-slate-400">
                {h.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative">
      <div
        class="group relative aspect-[4/5] w-full overflow-hidden rounded-3xl bg-gradient-to-br from-teal-700 via-teal-600 to-emerald-700 shadow-2xl shadow-teal-900/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-teal-900/60 sm:aspect-[5/4] lg:aspect-[5/6] xl:aspect-[4/5]"
        role="img"
        aria-label="Community gathering on a Kiribati atoll"
      >
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.25),transparent_60%)] transition-transform duration-700 group-hover:scale-110"></div>

        <div class="absolute inset-x-5 bottom-5 rounded-2xl bg-slate-900/70 p-5 backdrop-blur transition-all duration-500 group-hover:bg-slate-900/80 group-hover:translate-y-[-2px]">
          <p class="font-accent text-2xl leading-none text-lime-300">Latest News</p>

          {
            latestNews.length === 0 ? (
              <p class="mt-3 text-xs text-slate-300">Latest news coming soon.</p>
            ) : (
              <ul class="mt-4 divide-y divide-white/10">
                {latestNews.map((item) => (
                  <li>
                    <a
                      href={`/news/${item.id}`}
                      class="group/item -mx-2 flex items-center gap-3 rounded-lg px-2 py-2.5 transition-colors hover:bg-white/10"
                    >
                      {item.data.photo ? (
                        <img
                          src={absoluteUrl(item.data.photo.url)}
                          alt={item.data.photo.alternativeText ?? item.data.title}
                          class="h-12 w-12 flex-none rounded-md object-cover ring-1 ring-white/10 transition-transform duration-300 group-hover/item:scale-[1.04]"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          aria-hidden="true"
                          class="h-12 w-12 flex-none rounded-md bg-gradient-to-br from-teal-600 to-emerald-700 ring-1 ring-white/10"
                        />
                      )}
                      <div class="min-w-0 flex-1">
                        <p class="line-clamp-2 text-sm font-bold leading-snug text-white transition-colors group-hover/item:text-lime-200">
                          {item.data.title}
                        </p>
                        <time class="mt-1 block text-[11px] font-semibold uppercase tracking-widest text-slate-400">
                          {formatDate(item.data.date)}
                        </time>
                      </div>
                      <span
                        aria-hidden="true"
                        class="text-slate-500 transition-all duration-300 group-hover/item:translate-x-1 group-hover/item:text-lime-300"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
