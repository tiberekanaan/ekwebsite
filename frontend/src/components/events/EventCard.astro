---
import { STRAPI_URL } from 'astro:env/server';

interface Props {
  id: string;
  date: Date;
  location: string;
  image?: { url?: string | null; alternativeText?: string | null } | null;
}

const { id, date, location, image } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const absoluteImageUrl = (url?: string | null) => {
  if (!url) return null;
  return url.startsWith('http') ? url : `${STRAPI_URL}${url}`;
};

const img = absoluteImageUrl(image?.url);
const alt = image?.alternativeText ?? '';
---

<a
  href={`/events/${id}`}
  class="border-border bg-surface-secondary hover:border-brand-500 group flex flex-col overflow-hidden rounded-xl border transition-colors"
>
  {img && <img src={img} alt={alt} class="aspect-video w-full object-cover" loading="lazy" />}
  <div class="flex flex-col gap-2 p-6">
    <time class="text-brand-500 text-sm font-medium">{formatDate(date)}</time>
    <h2 class="text-foreground text-xl font-semibold">{location}</h2>
  </div>
</a>
